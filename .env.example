# VATTAMS ACADEMIA — environment variables
# Copy to .env.local for local dev. Never commit the real .env file.

# Supabase (public — safe for frontend; RLS enforces access control)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (UPI collect flow — manual UTR verification, no gateway secrets needed
# on the frontend; the payee identity is admin-configured, never hardcoded in UI)
VITE_UPI_PAYEE_NAME="VATTAMS ACADEMIA"
# Set the real collect VPA only in your deployment environment, not in source control.
VITE_UPI_VPA=

# --- Server-side only (Supabase Edge Function secrets, NOT prefixed with VITE_) ---
# SUPABASE_SERVICE_ROLE_KEY=          # edge functions only — never in frontend bundle
# EMAIL_PROVIDER_API_KEY=             # for notification architecture, when configured
# WHATSAPP_PROVIDER_API_KEY=          # for notification architecture, when configured
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
