<?xml version="1.0" encoding="UTF-8"?>
<!--
  VATTAMS ACADEMIA — sitemap.xml

  Static public routes only — /courses/:slug URLs are data-driven
  (Firestore `courses` collection) and can't be listed by this static
  file. Run `node scripts/generate-sitemap.mjs` (needs
  GOOGLE_APPLICATION_CREDENTIALS, see that script's header) to
  regenerate this file with published course URLs included.

  /verify and /competitive-exams are intentionally excluded — they are
  duplicate routes for /verify-certificate and /competitions (same
  component mounted at two paths) and set a canonical link back to the
  canonical path instead of being separately indexed.
-->
