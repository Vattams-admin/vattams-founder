		# VATTAMS ACADEMIA — environment variables
# Copy to .env.local for local dev. Never commit the real .env file.

# Supabase (public — safe for frontend; RLS enforces access control)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (UPI collect flow — manual UTR verification, no gateway secrets needed
# on the frontend; the payee identity is admin-configured, never hardcoded in UI)
