{
  "name": "vattams-academia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "seed:catalog:dry-run": "node scripts/seed-catalog.mjs --dry-run",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/validate-seo.mjs",
    "thirukkural:validate": "node scripts/validate-thirukkural-production.mjs",
    "thirukkural:package": "node scripts/package-thirukkural-production.mjs",
    "thirukkural:audit": "node scripts/audit-thirukkural-production.mjs",
    "thirukkural:repair-course": "node scripts/repair-thirukkural-course.mjs",
    "thirukkural:build-official": "node scripts/build-thirukkural-official-objective.mjs",
    "thirukkural:production-gate": "npm run thirukkural:build-official && npm run thirukkural:validate && npm run thirukkural:package",
    "competition:package": "node scripts/package-competition-runtime.mjs",
    "seo:validate": "node scripts/validate-seo.mjs",
    "india:validate": "node scripts/validate-india-education-registry.mjs",
    "content:schema:validate": "node scripts/validate-content-package-schema.mjs",
    "content:library:validate": "node scripts/validate-content-library-registry.mjs",
    "content:coverage:validate": "node scripts/validate-production-content-coverage.mjs",
    "content:package:registry:validate": "node scripts/validate-production-package-registry-links.mjs",
    "academia:taxonomy:validate": "node scripts/validate-academia-master-taxonomy.mjs",
    "content:coverage:plan:validate": "node scripts/validate-production-content-coverage-plan.mjs",
    "academia:catalog:validate": "node scripts/validate-complete-platform-catalog.mjs",
    "content:authoring:matrix:validate": "node scripts/validate-atomic-content-authoring-matrix.mjs",
    "content:backlog:validate": "node scripts/validate-production-authoring-backlog.mjs",
    "content:syllabus:evidence:validate": "node scripts/validate-syllabus-evidence-schema.mjs",
    "content:authoring:control:validate": "node scripts/validate-curriculum-authoring-control.mjs",
    "content:syllabus:artifact:validate": "node scripts/validate-syllabus-artifact-registry.mjs",
    "content:syllabus:source-intake:validate": "node scripts/validate-syllabus-source-intake.mjs",
    "content:syllabus:artifact:capture": "node scripts/capture-syllabus-artifact.mjs",
    "content:syllabus:link:validate": "node scripts/validate-evidence-to-curriculum-map-link.mjs",
    "content:curriculum:map:expand:validate": "node scripts/validate-curriculum-map-expansion.mjs",
    "content:curriculum:evidence:validate": "node scripts/validate-evidence-backed-curriculum-map.mjs",
    "content:curriculum:readiness:validate": "node scripts/validate-curriculum-authoring-readiness.mjs",
    "content:authoring:package:validate": "node scripts/validate-content-authoring-package.mjs",
    "content:questions:quality:validate": "node scripts/validate-question-quality-security.mjs",
    "content:assessment:selection:validate": "node scripts/validate-assessment-selection-policy.mjs",
    "content:assessment:blueprint:validate": "node scripts/validate-assessment-blueprint-registry.mjs",
    "content:assessment:coverage:validate": "node scripts/validate-assessment-blueprint-coverage.mjs",
    "content:assessment:coverage:scan": "node scripts/scan-assessment-blueprint-question-banks.mjs",
    "content:assessment:blueprint:authoring:validate": "node scripts/validate-assessment-blueprint-authoring.mjs",
    "content:assessment:blueprint:promote": "node scripts/promote-assessment-blueprint.mjs",
    "content:questions:ingestion:validate": "node scripts/validate-production-question-ingestion.mjs",
    "content:questions:package": "node scripts/package-production-question-bank.mjs",
    "content:assessment:banks:validate": "node scripts/validate-assessment-bank-registration.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@supabase/supabase-js": "^2.112.4",
    "firebase": "^12.18.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "csv-parser": "^3.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "firebase-admin": "^12.7.0",
    "postcss": "^8.4.45",
    "typescript": "^5.5.4",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.3.0",
    "tailwindcss": "^3.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true
  }
}
