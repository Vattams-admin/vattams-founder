    "objectives": [
      "Read a controlled passage with taught gn-words accurately.",
      "Sequence stated events as first, next, and last.",
      "Answer literal questions using passage evidence.",
      "Keep initial g silent while reading connected text."
    ],
    "concepts": [
      "A passage connects related sentences.",
      "Sequence words identify event order.",
      "Initial g is silent in the taught gn-words.",
      "Rereading supports decoding and comprehension."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "passage",
        "definition": "A short connected text made of related sentences."
      },
      {
        "term": "text evidence",
        "definition": "Words in a passage that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “A gnat lands on a leaf. The gnat flies to a net. The gnat rests.” What happens first?",
        "solution": "A gnat lands on a leaf."
      },
      {
        "prompt": "Where does the gnat fly next?",
        "solution": "To a net."
      },
      {
        "prompt": "How do you verify the order?",
        "solution": "Reread the sentences in sequence."
      }
    ],
    "commonMistakes": [
      "Voicing g at the start of gn-words.",
      "Reordering events based on a guess.",
      "Skipping a sentence while retelling.",
      "Answering without evidence."
    ],
    "keyTakeaways": [
      "Read every sentence accurately.",
      "Keep initial g silent.",
      "Retell events in order.",
      "Use the passage to support answers."
    ],
    "revisionPoints": [
