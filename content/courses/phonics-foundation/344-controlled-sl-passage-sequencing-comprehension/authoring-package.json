  "studyMaterial": {
    "objectives": [
      "Read a short controlled passage containing taught sl-words accurately.",
      "Sequence events using the order stated in the passage.",
      "Answer literal questions using passage evidence.",
      "Reread to confirm decoding and event order."
    ],
    "concepts": [
      "A passage connects related sentences.",
      "Sequence follows the stated order of events.",
      "Literal answers must match the text.",
      "Rereading supports accurate decoding and recall."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "passage",
        "definition": "A short connected text made of related sentences."
      },
      {
        "term": "text evidence",
        "definition": "Words in the passage that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “Lee has a sled. Lee slides to a stop. Lee sits.” What happens first?",
        "solution": "Lee has a sled."
      },
      {
        "prompt": "What happens after Lee slides to a stop?",
        "solution": "Lee sits."
      },
      {
        "prompt": "How can the sequence be checked?",
        "solution": "Reread each sentence and follow its stated order."
      }
    ],
    "commonMistakes": [
      "Changing the stated event order.",
      "Skipping a sentence.",
      "Inventing a detail.",
      "Misreading an sl-word."
    ],
    "keyTakeaways": [
      "Read each sentence in order.",
      "Retell the stated events.",
      "Use passage evidence for answers.",
      "Reread to confirm the sequence."
    ],
