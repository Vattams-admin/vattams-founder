    "concepts": [
      "A diagnostic samples several related skills.",
      "All three consonants must be heard and represented.",
      "Fluency includes accuracy and phrasing.",
      "Results guide the next teaching step."
    ],
    "definitions": [
      {
        "term": "diagnostic",
        "definition": "An assessment that identifies strengths and learning needs."
      },
      {
        "term": "fluency",
        "definition": "Accurate reading with appropriate pace and phrasing."
      },
      {
        "term": "remediation",
        "definition": "Targeted practice for a skill that needs support."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Compare scrap and strap.",
        "solution": "Scrap begins scr; strap begins str."
      },
      {
        "prompt": "If a learner writes scrub as sub, what is missing?",
        "solution": "The /k/ and /r/ sounds."
      },
      {
        "prompt": "What follows a diagnostic showing weak blending?",
        "solution": "Targeted practice and fresh reassessment."
      }
    ],
    "commonMistakes": [
      "Confusing scr with str or spr.",
      "Leaving out c/k or r while reading or spelling.",
      "Guessing instead of using sound evidence.",
      "Ignoring a diagnosed weakness."
