  "studyMaterial": {
    "objectives": [
      "Decode controlled /j/ sentences.",
      "Answer literal who, what, and where questions.",
      "Use explicit text evidence.",
      "Reread sentences for accuracy and fluency."
    ],
    "concepts": [
      "Sentence meaning depends on accurate decoding.",
      "Literal questions can be answered directly from the text.",
      "Text evidence supports accurate responses.",
      "Rereading strengthens fluency."
    ],
    "definitions": [
      {
        "term": "literal comprehension",
        "definition": "Understanding information stated directly in a text."
      },
      {
        "term": "text evidence",
        "definition": "Words or details in the text that support an answer."
      }
    ],
    "workedExamples": [
      "“Jim jumps.” → Who? Jim. What does he do? Jumps.",
      "“Jen has a jug.” → Who? Jen. What does she have? A jug."
    ],
    "commonMistakes": [
      "Answering from memory instead of the text.",
      "Skipping a word.",
      "Guessing the action."
    ],
    "keyTakeaways": [
      "Decode every word.",
      "Find the evidence.",
      "Answer exactly.",
      "Reread."
    ],
    "revisionPoints": [
      "sentence decoding",
      "who",
      "what",
      "where",
      "text evidence",
      "fluency"
    ]
  },
  "practice": {
    "basic": [
      "Read controlled sentences."
    ],
    "conceptual": [
      "Match questions to text details."
    ],
    "application": [
      "Answer literal comprehension questions."
    ],
    "higherOrderThinking": [
      "Explain why text evidence makes an answer reliable."
    ],
    "mixedReview": [
      "Combine decoding and comprehension."
    ]
  },
  "revision": {
