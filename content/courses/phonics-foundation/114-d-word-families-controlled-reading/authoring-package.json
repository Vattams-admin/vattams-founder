  "status": "draft",
  "studyMaterial": {
    "objectives": [
      "Recognize taught CVC word families containing /d/.",
      "Read controlled CVC word-family chains accurately.",
      "Compare onset and rime patterns.",
      "Build fluency through repeated controlled reading."
    ],
    "concepts": [
      "Words can share a rime while changing the onset.",
      "Word families support decoding by pattern recognition.",
      "Controlled text limits spelling patterns to taught correspondences.",
      "Repeated accurate reading supports automaticity."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The initial consonant or consonant group before the vowel in a word or syllable."
      },
      {
        "term": "rime",
        "definition": "The vowel and sounds that follow it in a word or syllable."
      },
      {
        "term": "word family",
        "definition": "A group of words sharing the same rime pattern."
      },
      {
        "term": "controlled text",
        "definition": "Text restricted to taught sound-spelling patterns."
      }
    ],
    "workedExamples": [
      "-ad: dad, sad, had.",
      "-ig: dig, pig, big.",
      "-ug: dug, bug, rug."
    ],
    "commonMistakes": [
      "Changing the rime when only the onset changes.",
      "Guessing instead of blending.",
      "Skipping the final consonant.",
      "Reading a familiar word but losing the pattern in a new word."
    ],
    "keyTakeaways": [
      "Spot the rime.",
      "Change only the onset when appropriate.",
      "Blend the whole word.",
      "Reread for fluency."
    ],
    "revisionPoints": [
      "onset",
      "rime",
      "-ad",
      "-ig",
      "-ug",
      "controlled reading"
    ]
  },
  "practice": {
    "basic": [
      "Match /d/ CVC words to their word families."
    ],
    "conceptual": [
      "Identify whether two words share the same rime."
    ],
    "application": [
      "Read and complete controlled word-family chains."
    ],
    "higherOrderThinking": [
      "Explain how changing the onset creates a new word while keeping the rime."
    ],
    "mixedReview": [
      "Read mixed /d/ word families fluently."
    ]
  },
  "revision": {
    "quickRevision": [
      "spot rime → blend onset + rime → read → reread"
    ],
    "flashRecall": [
      "dad",
      "had",
      "sad",
      "dig",
      "big",
      "dug",
      "bug",
      "rug"
    ],
    "formulaOrFactBank": [
      "Word-family reading = stable rime + changing onset."
    ],
    "mistakeBasedRevision": [
      "Return to onset/rime blending when a family word is misread."
    ],
    "weakTopicRevision": [
      "Practise the specific rime family causing errors."
    ]
  },
  "activities": [
    {
      "name": "Word-family sort",
      "steps": [
        "Read each word.",
        "Underline the rime.",
        "Group matching rimes.",
        "Read each group aloud."
      ]
    },
    {
      "name": "Family chain",
      "steps": [
        "Start with one word.",
        "Change only the onset.",
        "Read the new word.",
        "Continue the chain."
      ]
    },
    {
      "name": "Controlled reread",
      "steps": [
        "Read the list slowly.",
        "Blend accurately.",
        "Reread smoothly.",
        "Record the best accurate read."
      ]
    }
  ],
  "outcomes": [
    "Learner identifies taught /d/ word families.",
    "Learner reads controlled CVC word-family lists accurately.",
    "Learner improves fluency through repeated controlled reading."
  ],
