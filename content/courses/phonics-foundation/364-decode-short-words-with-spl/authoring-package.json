    "objectives": [
      "Decode taught spl-words from left to right.",
      "Map s, p, and l to the onset sounds in order.",
      "Distinguish the vowel and ending in splash, splat, and split.",
      "Reread and self-correct when a sound is missed."
    ],
    "concepts": [
      "The onset spl represents three consonant sounds in order.",
      "The vowel and ending must also be decoded.",
      "The ending distinguishes similar spl-words.",
      "Rereading the whole word checks sound mapping."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode s-p-l-a-t.",
        "solution": "Map /s/ /p/ /l/ /æ/ /t/ to read splat."
      },
      {
        "prompt": "Compare splat and split.",
        "solution": "The onset is the same; the vowel and ending differ."
      },
      {
        "prompt": "If split is read as slit, what is missing?",
        "solution": "The /p/ sound after /s/."
      }
    ],
    "commonMistakes": [
      "Skipping p in the onset.",
