  "status": "draft",
  "studyMaterial": {
    "objectives": [
      "Segment h-initial CVC words into phonemes.",
      "Map /h/ to h during spelling.",
      "Spell controlled CVC words from dictation.",
      "Read back and self-correct CVC spellings."
    ],
    "concepts": [
      "CVC words can be segmented into three phonemes.",
      "The initial /h/ maps to the grapheme h in the taught words.",
      "Encoding requires hearing each phoneme in sequence.",
      "Read-back checks whether each written grapheme matches the spoken word."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its individual phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "dictation",
        "definition": "Writing a word after hearing it spoken."
      }
    ],
    "workedExamples": [
      "hat → /h/ /a/ /t/ → h-a-t",
      "hen → /h/ /e/ /n/ → h-e-n",
      "hop → /h/ /o/ /p/ → h-o-p",
      "hug → /h/ /u/ /g/ → h-u-g"
    ],
    "commonMistakes": [
      "Writing c instead of h for the first sound.",
      "Skipping the middle vowel.",
      "Changing the final consonant.",
      "Not reading the completed spelling back."
    ],
    "keyTakeaways": [
      "Say it.",
      "Segment it.",
      "Map each sound.",
      "Read it back."
    ],
    "revisionPoints": [
      "/h/ → h",
      "CVC segmentation",
      "sound-to-letter mapping",
      "dictation",
      "self-correction"
    ]
  },
  "practice": {
    "basic": [
      "Segment and spell controlled h-initial CVC words."
    ],
    "conceptual": [
      "Match each phoneme to its grapheme."
    ],
    "application": [
      "Spell h-initial CVC words from dictation."
    ],
    "higherOrderThinking": [
      "Explain how read-back can reveal a spelling error."
    ],
    "mixedReview": [
      "Alternate segmentation, mapping, and spelling."
    ]
  },
  "revision": {
    "quickRevision": [
      "say → segment → map → write → read back"
    ],
    "flashRecall": [
      "h-a-t",
      "h-e-n",
      "h-i-p",
      "h-o-p",
      "h-u-g"
    ],
    "formulaOrFactBank": [
      "CVC spelling uses one grapheme for each taught phoneme in these words."
    ],
    "mistakeBasedRevision": [
      "Stretch the word and check the first phoneme before writing h."
    ],
    "weakTopicRevision": [
      "Practise h-initial words with one short vowel at a time."
    ]
  },
  "activities": [
    {
