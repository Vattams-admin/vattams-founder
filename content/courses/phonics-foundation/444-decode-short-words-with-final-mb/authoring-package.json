    "objectives": [
      "Decode taught words ending in mb.",
      "Recognise /m/ as the final spoken sound when b is silent.",
      "Distinguish lamb, comb, thumb, and climb using their other sounds.",
      "Reread and self-correct when a sound is added or omitted."
    ],
    "concepts": [
      "In taught final mb words, b is silent.",
      "The spoken ending is /m/.",
      "The spelling retains b.",
      "Other vowel and consonant sounds identify the whole word."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "silent letter",
        "definition": "A written letter that is not pronounced."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode lamb.",
        "solution": "Read /l/ /æ/ /m/; do not pronounce b."
      },
      {
        "prompt": "Compare thumb and thump.",
        "solution": "Thumb ends /m/; thump ends /mp/."
      },
      {
        "prompt": "If comb is read with /b/ at the end, what should be corrected?",
        "solution": "The b is silent."
      }
    ],
    "commonMistakes": [
      "Adding /b/ to the spoken ending.",
      "Removing b from spelling.",
      "Changing the vowel.",
      "Guessing from the final letters only."
    ],
    "keyTakeaways": [
      "Final b is silent in the taught mb words.",
      "Say /m/ at the end.",
      "Keep b in spelling.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "lamb ends with /m/.",
      "b is silent in final mb in the taught set.",
      "Thumb differs from thump.",
      "Reread to confirm the word."
    ]
