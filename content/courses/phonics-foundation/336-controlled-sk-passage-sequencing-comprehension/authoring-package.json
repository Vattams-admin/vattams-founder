  "studyMaterial": {
    "objectives": [
      "Read a short controlled passage with taught sk-words accurately.",
      "Sequence events as first, next, and last based on the passage.",
      "Answer literal questions using evidence from the passage.",
      "Reread when a decoding error affects the meaning."
    ],
    "concepts": [
      "A passage links sentences around related events.",
      "Sequence language marks event order.",
      "Literal answers must be supported by stated text.",
      "Rereading supports both decoding and comprehension."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "passage",
        "definition": "A short connected text made of related sentences."
      },
      {
        "term": "text evidence",
        "definition": "Words in a passage that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “Skye gets a skate. Skye puts on a pad. Skye skates on the path.” What happens first?",
        "solution": "Skye gets a skate."
      },
      {
        "prompt": "What happens after Skye puts on a pad?",
        "solution": "Skye skates on the path."
      },
      {
        "prompt": "How do you verify the sequence?",
        "solution": "Reread each sentence and follow the stated order."
      }
    ],
    "commonMistakes": [
      "Reordering events based on a guess.",
      "Skipping a sentence while retelling.",
      "Misreading skate and changing the event.",
      "Answering without passage evidence."
    ],
    "keyTakeaways": [
      "Read every sentence accurately.",
      "Retell events in order.",
      "Use the passage to support answers.",
      "Reread to repair a mismatch."
    ],
    "revisionPoints": [
