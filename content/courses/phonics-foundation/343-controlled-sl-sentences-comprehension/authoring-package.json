  "studyMaterial": {
    "objectives": [
      "Read controlled sentences containing taught sl-words accurately.",
      "Answer literal questions using information stated in the sentence.",
      "Use sentence meaning to check decoding without inventing details.",
      "Reread to repair a missed sound and confirm comprehension."
    ],
    "concepts": [
      "Sentence reading combines accurate decoding with meaning.",
      "Literal answers come directly from the text.",
      "Text evidence supports a response.",
      "Rereading checks word accuracy and comprehension."
    ],
    "definitions": [
      {
        "term": "literal question",
        "definition": "A question answered directly by information stated in the text."
      },
      {
        "term": "text evidence",
        "definition": "Words in the sentence that support an answer."
      },
      {
        "term": "rereading",
        "definition": "Reading again to check accuracy and meaning."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “The sled is red.” What is red?",
        "solution": "The sled."
      },
      {
        "prompt": "A learner reads slip as sip.",
        "solution": "Check for /l/ in the onset and reread the word."
      },
      {
        "prompt": "What supports a literal answer?",
        "solution": "The words stated in the sentence."
      }
    ],
    "commonMistakes": [
      "Answering from imagination.",
      "Omitting /l/ in an sl-word.",
      "Ignoring sentence punctuation.",
      "Choosing without text evidence."
    ],
    "keyTakeaways": [
      "Decode every word in the sentence.",
      "Answer from stated information.",
      "Reread to check meaning.",
      "Do not invent details."
    ],
    "revisionPoints": [
      "Decode every word in the sentence.",
