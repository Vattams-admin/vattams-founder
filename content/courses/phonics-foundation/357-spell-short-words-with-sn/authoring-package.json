      "Read the written word back to check spelling."
    ],
    "definitions": [
      {
        "term": "phoneme",
        "definition": "A speech sound in a word."
      },
      {
        "term": "grapheme",
        "definition": "A letter or letter group representing a sound."
      },
      {
        "term": "encoding",
        "definition": "Representing spoken sounds with written letters."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell snip.",
        "solution": "Say /s/ /n/ /i/ /p/ and write s-n-i-p."
      },
      {
        "prompt": "Spell snap.",
        "solution": "Segment each sound and write the graphemes in order."
      },
      {
        "prompt": "How can spelling be checked?",
        "solution": "Blend the written word and compare it with the intended word."
      }
    ],
    "commonMistakes": [
      "Omitting n after s.",
      "Changing the vowel.",
      "Leaving out the final consonant.",
      "Not reading the spelling back."
    ],
    "keyTakeaways": [
      "Say the phonemes before writing.",
      "Spell s then n in the onset.",
      "Represent the vowel and ending.",
      "Read the written word back."
    ],
