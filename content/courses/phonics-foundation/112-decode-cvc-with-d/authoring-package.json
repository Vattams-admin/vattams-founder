  "studyMaterial": {
    "objectives": [
      "Map grapheme d to /d/.",
      "Blend /d/ with taught short vowels and final consonants.",
      "Decode CVC words containing initial /d/.",
      "Self-correct initial-consonant and vowel decoding errors."
    ],
    "concepts": [
      "Decoding maps graphemes to phonemes and blends them.",
      "CVC words contain consonant-vowel-consonant structure.",
      "Short vowels change word identity.",
      "Rereading supports accurate decoding."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use known letter-sound correspondences to read a written word."
      },
      {
        "term": "blend",
        "definition": "Combine individual phonemes to pronounce a word."
      },
      {
        "term": "CVC",
        "definition": "A consonant-vowel-consonant word pattern."
      },
      {
        "term": "self-correction",
        "definition": "Notice a decoding error and repair it using sound information."
      }
    ],
    "workedExamples": [
      "d-a-d → /d/ /a/ /d/ → dad.",
      "d-i-d → /d/ /i/ /d/ → did.",
      "d-u-g → /d/ /u/ /g/ → dug."
    ],
    "commonMistakes": [
      "Confusing /d/ and /t/.",
      "Changing the short vowel.",
      "Guessing from one letter.",
      "Skipping the final consonant."
    ],
    "keyTakeaways": [
      "Map d to /d/.",
      "Blend all phonemes.",
      "Attend to the vowel.",
      "Reread and self-correct."
    ],
    "revisionPoints": [
      "d → /d/",
      "CVC blending",
      "short vowels",
      "initial /d/",
      "self-correction"
    ]
  },
  "practice": {
    "basic": [
      "Blend /d/ with taught short vowels and final consonants."
    ],
    "conceptual": [
      "Compare /d/ CVC words that differ by vowel or final consonant."
    ],
    "application": [
      "Diagnose and correct common decoding substitutions."
    ],
    "higherOrderThinking": [
      "Explain why phoneme-by-phoneme blending is more reliable than guessing."
    ],
    "mixedReview": [
      "Decode a mixed set of /d/ CVC words."
    ]
  },
  "revision": {
    "quickRevision": [
      "look → say sounds → blend → word → reread"
    ],
    "flashRecall": [
      "d",
