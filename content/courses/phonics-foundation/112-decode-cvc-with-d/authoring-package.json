      "dad",
      "did",
      "dig",
      "dot",
      "dug"
    ],
    "formulaOrFactBank": [
      "CVC decoding = initial consonant + short vowel + final consonant."
    ],
    "mistakeBasedRevision": [
      "Return to the changed phoneme when a word is decoded incorrectly."
    ],
    "weakTopicRevision": [
      "Practise the specific vowel or consonant contrast causing errors."
    ]
  },
  "activities": [
    {
      "name": "Sound-to-word blending",
