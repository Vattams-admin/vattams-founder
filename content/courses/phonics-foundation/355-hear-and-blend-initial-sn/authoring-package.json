    "objectives": [
      "Hear /s/ followed immediately by /n/ at the beginning of taught words.",
      "Blend /s/ and /n/ without inserting an extra vowel.",
      "Distinguish sn from /s/ alone and other taught blends.",
      "Blend the onset with the rest of each complete word."
    ],
    "definitions": [
      {
        "term": "initial blend",
        "definition": "Two consonant sounds heard together at the start of a word."
      },
      {
        "term": "phoneme",
        "definition": "A speech sound that can distinguish one word from another."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to snap.",
        "solution": "Hear /s/ followed by /n/, then blend the remaining sounds."
      },
      {
        "prompt": "Compare snap and sit.",
        "solution": "Snap begins with sn; sit begins with /s/ alone."
      },
      {
        "prompt": "A learner says sap for snap.",
        "solution": "Check that /n/ is present in the onset."
      }
    ],
    "commonMistakes": [
      "Dropping /n/ in the sn onset.",
      "Reversing the consonants.",
      "Adding a vowel between consonants.",
      "Guessing from the first letter."
    ],
    "keyTakeaways": [
      "sn begins with /s/ followed by /n/.",
      "Keep both consonants in order.",
      "Do not insert an extra vowel.",
      "Blend the onset with the whole word."
