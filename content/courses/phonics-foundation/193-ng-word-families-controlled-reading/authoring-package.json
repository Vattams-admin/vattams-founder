  "studyMaterial": {
    "objectives": [
      "Group taught ng-words by their vowel-plus-ending rime.",
      "Read -ing, -ang, -ong and -ung examples accurately.",
      "Explain why sing and song do not share the same rime.",
      "Decode every word fully even when a familiar family pattern is recognised."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "The final ng grapheme is shared by several word families.",
      "Word families support pattern recognition but do not replace full decoding."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "ring and sing",
        "solution": "Both share -ing."
      },
      {
        "prompt": "bang and rang",
        "solution": "Both share -ang."
      },
      {
        "prompt": "song and long",
        "solution": "Both share -ong."
      }
    ],
    "commonMistakes": [
      "Grouping every ng-word together regardless of the vowel.",
      "Sorting by the final letters only.",
      "Ignoring the vowel when comparing sing and song.",
      "Guessing a new word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "ng appears across several different rime families.",
      "Read each word after sorting.",
      "Use a family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-ing: ring, sing.",
