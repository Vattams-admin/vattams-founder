  "studyMaterial": {
    "objectives": [
      "Hear /s/ at the beginning of familiar spoken words.",
      "Connect /s/ to s/S.",
      "Distinguish the target sound from contrasting sounds."
    ],
    "concepts": [
      "/s/ is a phoneme.",
      "s/S is a common grapheme for /s/."
    ],
    "definitions": [
      {
        "term": "phoneme",
        "definition": "The smallest unit of sound that can change a word's meaning."
      },
      {
        "term": "grapheme",
        "definition": "A written representation of a speech sound."
      }
    ],
    "workedExamples": [
      {
        "word": "sun",
        "letter": "s",
        "example": "sun begins with /s/."
      },
      {
        "word": "sock",
        "letter": "s",
        "example": "sock begins with /s/."
      }
    ],
    "commonMistakes": [
      "Naming the letter instead of producing the sound.",
      "Adding an unnecessary vowel to an isolated consonant."
    ],
    "keyTakeaways": [
      "/s/ is the target initial sound.",
      "Listen first, then connect the sound to s/S."
    ],
    "revisionPoints": [
      "Identify /s/ in spoken words.",
      "Match s/S to /s/."
    ]
  },
  "practice": {
