  "status": "draft",
  "studyMaterial": {
    "objectives": [
      "Segment /r/ CVC words into phonemes.",
      "Map each phoneme to a grapheme during spelling.",
      "Spell new /r/ CVC words from dictation.",
      "Identify and repair short-vowel and final-sound spelling errors."
    ],
    "concepts": [
      "Encoding moves from spoken phonemes to written graphemes.",
      "Regular CVC words require representation of each phoneme.",
      "Short-vowel accuracy is essential for distinguishing CVC spellings."
    ],
    "definitions": [
      {
        "term": "encoding",
        "definition": "Representing spoken language using written symbols."
      },
      {
        "term": "phoneme segmentation",
        "definition": "Breaking a spoken word into its individual speech sounds."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      }
    ],
    "workedExamples": [
      "/r/ /æ/ /t/ → rat",
      "/r/ /ɪ/ /p/ → rip",
      "/r/ /ʌ/ /g/ → rug",
      "/r/ /ɒ/ /b/ → rob",
      "/r/ /ɛ/ /d/ → red"
    ],
    "commonMistakes": [
      "Substituting one short vowel for another.",
      "Omitting the final consonant.",
      "Writing from memory without segmenting.",
      "Confusing a phoneme with a letter name."
    ],
    "keyTakeaways": [
      "Hear the word.",
      "Segment the sounds.",
      "Map each sound.",
      "Reread the spelling."
    ],
    "revisionPoints": [
      "segment",
      "map",
      "write",
      "reread",
      "repair"
    ]
  },
  "practice": {
    "basic": [
      "Dictate regular /r/ CVC words and segment before writing."
    ],
    "conceptual": [
      "Compare spellings that differ in the middle vowel."
    ],
    "application": [
      "Repair misspelled /r/ CVC words by locating the incorrect mapping."
    ],
    "higherOrderThinking": [
      "Explain why segmentation supports accurate spelling."
    ],
    "mixedReview": [
      "Mix /r/ CVC spelling with previously learned consonants."
    ]
  },
  "revision": {
    "quickRevision": [
      "hear → segment → map → write → reread"
    ],
    "flashRecall": [
      "rat",
      "rip",
      "rug",
      "rob",
      "red"
    ],
    "formulaOrFactBank": [
      "CVC spelling = one grapheme mapped for each phoneme in a regular word."
    ],
    "mistakeBasedRevision": [
      "If the vowel is wrong, rehear and isolate the middle phoneme before rewriting."
    ],
    "weakTopicRevision": [
      "Practice the weakest short-vowel family with fresh /r/ dictation."
    ]
  },
  "activities": [
    {
      "name": "Sound boxes",
      "steps": [
        "Say the target word.",
        "Push one counter per phoneme.",
        "Replace counters with graphemes.",
        "Read the completed spelling."
      ]
    },
    {
      "name": "Dictation repair",
      "steps": [
        "Dictate an /r/ CVC word.",
        "Segment and write it.",
        "Locate any incorrect mapping.",
        "Reread and correct."
      ]
    },
    {
      "name": "Vowel contrast writing",
      "steps": [
        "Dictate two /r/ words with different short vowels.",
        "Segment both.",
        "Compare their middle graphemes.",
        "Explain the difference."
      ]
    }
  ],
  "outcomes": [
    "Learner segments /r/ CVC words accurately.",
    "Learner maps phonemes to graphemes in spelling.",
    "Learner repairs common short-vowel and final-sound errors."
  ],
