  "status": "draft",
  "studyMaterial": {
    "objectives": [
      "Blend /r/ with short vowels and final consonants in CVC words.",
      "Decode new /r/ CVC words accurately.",
      "Distinguish short-vowel contrasts in /r/ words.",
      "Repair decoding errors at the phoneme level."
    ],
    "concepts": [
      "Accurate decoding requires each phoneme to be identified and blended.",
      "The middle vowel determines many CVC word contrasts.",
      "Continuous blending supports automatic word recognition."
    ],
    "definitions": [
      {
        "term": "CVC",
        "definition": "A consonant-vowel-consonant word pattern."
      },
      {
        "term": "blending",
        "definition": "Combining individual phonemes to pronounce a word."
      },
      {
        "term": "decoding",
        "definition": "Using grapheme-sound knowledge to read written words."
      }
    ],
    "workedExamples": [
      "r-a-t → rat",
      "r-i-p → rip",
      "r-u-g → rug",
      "r-o-b → rob",
      "r-e-d → red"
    ],
    "commonMistakes": [
      "Confusing short vowels.",
      "Guessing from the first letter.",
      "Dropping the final consonant.",
      "Stopping between sounds rather than blending."
    ],
    "keyTakeaways": [
      "Track every sound.",
      "Check the middle vowel.",
      "Blend smoothly.",
      "Repair errors by phoneme."
    ],
    "revisionPoints": [
      "/r/ CVC",
      "short vowels",
      "continuous blending",
      "decoding repair"
    ]
  },
  "practice": {
    "basic": [
      "Blend /r/ CVC words across all short vowels."
    ],
    "conceptual": [
      "Compare /r/ words that differ by their middle vowel."
    ],
    "application": [
      "Decode unfamiliar /r/ CVC words and repair errors."
    ],
    "higherOrderThinking": [
      "Explain how the middle vowel changes the decoded word."
    ],
    "mixedReview": [
      "Mix /r/ CVC decoding with known consonant patterns."
    ]
  },
  "revision": {
    "quickRevision": [
      "look → sound → blend → check"
    ],
    "flashRecall": [
      "rat",
      "rip",
      "rug",
      "rob",
      "red"
    ],
    "formulaOrFactBank": [
      "CVC = consonant + vowel + consonant."
    ],
    "mistakeBasedRevision": [
      "If rat becomes rit, isolate and rehearse /æ/ versus /ɪ/."
    ],
    "weakTopicRevision": [
      "Practice the weakest short-vowel family with fresh /r/ words."
    ]
  },
  "activities": [
    {
      "name": "Sound-slide decoding",
      "steps": [
        "Point to each grapheme.",
        "Say each phoneme.",
        "Slide through the word.",
        "Blend continuously."
      ]
    },
    {
      "name": "Vowel contrast",
      "steps": [
        "Present two /r/ CVC words.",
        "Identify the middle vowel.",
        "Read both.",
        "Explain the difference."
      ]
    },
    {
      "name": "Decode and repair",
      "steps": [
        "Read the target word.",
        "Identify the incorrect phoneme.",
        "Model the correct sound.",
        "Reread the whole word."
      ]
    }
  ],
  "outcomes": [
    "Learner decodes new /r/ CVC words.",
    "Learner distinguishes short-vowel contrasts.",
    "Learner repairs decoding errors using phoneme-level feedback."
  ],
