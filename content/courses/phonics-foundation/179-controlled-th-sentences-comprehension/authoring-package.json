  "studyMaterial": {
    "objectives": [
      "Read short controlled sentences containing taught unvoiced th-words.",
      "Answer literal questions using details stated in the sentence.",
      "Reread when a decoded word does not fit the meaning.",
      "Identify th-words and use their printed sounds to support accurate reading."
    ],
    "concepts": [
      "A sentence expresses a complete idea.",
      "Accurate decoding supports understanding.",
      "Literal answers should match information directly stated in the text.",
      "Rereading allows readers to check both words and meaning."
    ],
    "definitions": [
      {
        "term": "literal comprehension",
        "definition": "Understanding information directly stated in a text."
      },
      {
        "term": "text evidence",
        "definition": "A word or detail in the text that supports an answer."
      },
      {
        "term": "rereading",
        "definition": "Reading the text again to check accuracy and meaning."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Beth has a bath.",
        "solution": "The sentence tells what Beth has."
      },
      {
        "prompt": "The bath is hot.",
        "solution": "The sentence describes the bath."
      },
      {
        "prompt": "Beth can pat the cat.",
        "solution": "The action word is pat."
      }
    ],
    "commonMistakes": [
      "Answering from memory without rereading.",
      "Confusing bath with bat because the final th was missed.",
      "Skipping small words such as the and a.",
      "Reading accurately but not checking meaning."
    ],
    "keyTakeaways": [
      "Decode every word before answering.",
      "Reread and point to the evidence.",
      "Check the final th grapheme.",
      "Use the sentence, not a guess, to support an answer."
    ],
    "revisionPoints": [
      "Beth has a bath.",
      "The bath is hot.",
      "Beth can pat the cat.",
      "The path is long."
    ]
  },
