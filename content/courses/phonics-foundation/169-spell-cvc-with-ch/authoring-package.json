  "studyMaterial": {
    "objectives": [
      "Segment controlled ch-words into ordered phonemes before spelling.",
      "Use ch together to represent one /ch/ phoneme in taught words.",
      "Spell chip, chat, chop, chin, much and rich accurately.",
      "Read each written word back to check the graphemes and vowel."
    ],
    "concepts": [
      "Encoding moves from spoken sounds to written graphemes.",
      "The /ch/ phoneme is written ch in the taught word set.",
      "A digraph can occupy one sound box because it represents one phoneme.",
      "Read-back helps detect omitted letters and vowel substitutions."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its ordered phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "sound box",
        "definition": "A box used to map one phoneme; a digraph may share one box."
      }
    ],
    "workedExamples": [
      {
        "prompt": "chip",
        "solution": "Map /ch/ | /i/ | /p/; write ch-i-p."
      },
      {
        "prompt": "chat",
        "solution": "Map /ch/ | /a/ | /t/; write ch-a-t."
      },
      {
        "prompt": "much",
        "solution": "Map /m/ | /u/ | /ch/; write m-u-ch."
      }
    ],
    "commonMistakes": [
      "Writing c or h alone for the /ch/ phoneme.",
      "Putting c and h in separate sound boxes when mapping phonemes.",
      "Confusing short i in chip with short o in chop.",
      "Not reading the completed word back."
    ],
    "keyTakeaways": [
      "Say the word, then segment its sounds.",
      "Keep ch together for one /ch/ phoneme in these words.",
      "Choose the correct short vowel.",
      "Read the spelling aloud and compare it with the target."
    ],
    "revisionPoints": [
      "chip = ch + i + p.",
      "chat = ch + a + t.",
      "chop = ch + o + p.",
      "much = m + u + ch."
    ]
  },
