  "status": "draft",
  "studyMaterial": {
    "objectives": [
      "Blend /f/ with short vowels and final consonants in CVC words.",
      "Decode new /f/ CVC words accurately.",
      "Identify and repair vowel and blending errors.",
      "Prepare for /f/ CVC spelling and controlled reading."
    ],
    "concepts": [
      "CVC decoding requires accurate phoneme identification and blending.",
      "The middle vowel changes the word.",
      "Continuous blending supports fluent word recognition."
    ],
    "definitions": [
      {
        "term": "CVC",
        "definition": "A consonant-vowel-consonant word pattern."
      },
      {
        "term": "blending",
        "definition": "Combining individual phonemes to pronounce a word."
      },
      {
        "term": "decoding",
        "definition": "Using sound-symbol knowledge to read an unfamiliar written word."
      }
    ],
    "workedExamples": [
      "f-a-n → fan",
      "f-i-t → fit",
      "f-u-n → fun",
      "f-o-g → fog",
      "f-e-d → fed"
    ],
    "commonMistakes": [
      "Confusing short vowel sounds.",
      "Guessing the word from the first consonant.",
      "Dropping the final consonant.",
      "Stopping between phonemes instead of blending."
    ],
    "keyTakeaways": [
      "Say each sound.",
      "Track the middle vowel.",
      "Blend smoothly.",
      "Check every phoneme."
    ],
    "revisionPoints": [
      "/f/ CVC",
      "short vowels",
      "continuous blending",
      "decoding repair"
    ]
  },
  "practice": {
    "basic": [
      "Blend /f/ CVC words with each short vowel."
    ],
    "conceptual": [
      "Compare how changing the middle vowel changes the word."
    ],
    "application": [
      "Decode unfamiliar /f/ CVC words and repair errors."
    ],
    "higherOrderThinking": [
      "Explain which phoneme caused a decoding error."
    ],
    "mixedReview": [
      "Mix /f/ CVC decoding with known consonant patterns."
    ]
  },
  "revision": {
    "quickRevision": [
      "look → say sounds → blend → check"
    ],
    "flashRecall": [
      "fan",
      "fit",
      "fun",
      "fog",
      "fed"
    ],
    "formulaOrFactBank": [
      "CVC = consonant + vowel + consonant."
    ],
    "mistakeBasedRevision": [
      "If fan is read as fin, isolate and rehearse the short /a/ versus /i/ contrast."
    ],
    "weakTopicRevision": [
      "Repeat the weakest vowel set using fresh /f/ CVC words."
    ]
  },
  "activities": [
    {
      "name": "Sound-slide decoding",
      "steps": [
        "Point to each grapheme.",
        "Say each phoneme.",
        "Slide through the word.",
        "Blend without stopping."
      ]
    },
    {
      "name": "Vowel contrast",
      "steps": [
        "Present two /f/ CVC words.",
        "Identify the middle vowel.",
        "Read both words.",
        "Explain the sound difference."
      ]
    },
    {
      "name": "Decode and repair",
      "steps": [
        "Record the learner's reading.",
        "Identify the incorrect phoneme.",
        "Model the correct blend.",
        "Have the learner reread."
      ]
    }
  ],
  "outcomes": [
    "Learner decodes new /f/ CVC words.",
    "Learner distinguishes short-vowel contrasts in /f/ words.",
    "Learner repairs decoding errors using phoneme-level feedback."
  ],
