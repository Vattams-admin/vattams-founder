  "studyMaterial": {
    "objectives": [
      "Decode taught sk-words by mapping graphemes from left to right.",
      "Blend the sk onset with the vowel and ending.",
      "Distinguish short-vowel words such as skip, skin, and skid.",
      "Reread and self-correct when a sound is missed."
    ],
    "concepts": [
      "The letters s and k represent two consonants in the onset.",
      "The vowel and final consonant must also be decoded.",
      "Short vowels and word endings distinguish similar words.",
      "Reading the whole word back checks sound mapping."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode s-k-i-p.",
        "solution": "Map /s/ /k/ /ɪ/ /p/ to read skip."
      },
      {
        "prompt": "Compare skip and skin.",
        "solution": "Both begin sk and have short i; the final consonant differs."
      },
      {
        "prompt": "If skid is read as sid, what is missing?",
        "solution": "The /k/ sound after /s/."
      }
    ],
    "commonMistakes": [
      "Skipping k in the onset.",
      "Changing the short vowel.",
      "Ignoring the final consonant.",
      "Guessing from the first two letters only."
    ],
    "keyTakeaways": [
      "Map every grapheme from left to right.",
      "Keep /s/ and /k/ in order.",
      "Check the vowel and ending.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "Map s-k-i-p to read skip.",
      "sk contains /s/ followed by /k/.",
      "The vowel and ending matter.",
      "Reread to confirm the complete word."
    ]
  },
