  "studyMaterial": {
    "objectives": [
      "Decode taught cr-words by mapping graphemes from left to right.",
      "Blend the cr onset with the vowel and ending to read a complete word.",
      "Distinguish short-vowel words such as crab, crib, and crop.",
      "Reread and self-correct when a consonant or vowel is missed."
    ],
    "concepts": [
      "The letters c and r represent two consonants in the initial cr blend.",
      "The vowel and ending must also be decoded.",
      "Short vowels differ and must be heard precisely.",
      "Reading the whole word back checks the mapping."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode c-r-a-b.",
        "solution": "Map /k/ /r/ /æ/ /b/ and blend: crab."
      },
      {
        "prompt": "Decode c-r-i-b.",
        "solution": "Map /k/ /r/ /ɪ/ /b/ and blend: crib."
      },
      {
        "prompt": "Compare crab and crop.",
        "solution": "Both begin cr; crab has short /a/ and crop has short /o/."
      }
    ],
    "commonMistakes": [
      "Reading only cr and guessing the rest.",
      "Confusing short /i/ in crib with short /a/ in crab.",
      "Dropping the final consonant.",
      "Omitting /r/ from the initial blend."
    ],
    "keyTakeaways": [
      "Map every sound from left to right.",
      "Keep both consonants in cr.",
      "Listen carefully to the vowel.",
      "Read the complete word again."
    ],
    "revisionPoints": [
      "crab maps to cr-a-b.",
      "crib maps to cr-i-b.",
      "crop maps to cr-o-p.",
      "Read the full word to check each sound."
    ]
  },
