  "studyMaterial": {
    "objectives": [
      "Blend initial /z/, a short vowel, and a final consonant to read taught CVC words.",
      "Decode zip, zap, zig, zag, zit, and zen from graphemes rather than pictures.",
      "Track all three phonemes from left to right.",
      "Distinguish short /a/, /e/, and /i/ while preserving the final consonant."
    ],
    "concepts": [
      "CVC decoding requires attention to the initial consonant, medial vowel, and final consonant.",
      "The grapheme z represents initial /z/ in this set.",
      "The medial vowel differentiates words such as zap, zip, and zen.",
      "The final consonant completes the word and must be checked."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine speech sounds in order to read a word."
      },
      {
        "term": "CVC word",
        "definition": "A consonant-vowel-consonant word pattern."
      },
      {
        "term": "medial vowel",
        "definition": "The vowel sound in the middle of a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Blend z-i-p.",
        "solution": "Say /z/ /i/ /p/, then blend to zip."
      },
      {
        "prompt": "Compare zap and zip.",
        "solution": "The initial /z/ and final /p/ remain; the vowel changes from /a/ to /i/."
      },
      {
        "prompt": "Decode zen.",
        "solution": "Say /z/ /e/ /n/ in order and blend the word zen."
      }
    ],
    "commonMistakes": [
      "Guessing from a picture instead of blending.",
      "Confusing short /a/, /e/, and /i/.",
      "Ignoring the final consonant.",
      "Adding an extra vowel after /z/."
    ],
    "keyTakeaways": [
      "Point to each grapheme from left to right.",
      "Keep the medial vowel clear.",
      "Check the final sound before saying the whole word.",
      "Reread the blended word to verify it matches the spelling."
    ],
    "revisionPoints": [
      "z-a-p → zap.",
      "z-i-p → zip.",
      "z-i-g → zig.",
      "z-a-g → zag.",
      "z-i-t → zit.",
      "z-e-n → zen."
    ]
  },
