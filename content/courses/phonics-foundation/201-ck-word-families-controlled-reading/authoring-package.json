  "studyMaterial": {
    "objectives": [
      "Group taught ck-words by their vowel-plus-ending rime.",
      "Read -ack, -ick, -ock, -uck and -eck examples accurately.",
      "Explain why back and sick do not share the same rime.",
      "Decode every word fully even when a familiar family pattern is recognised."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "Words can share final ck but belong to different rime families.",
      "Word families support pattern recognition but do not replace full decoding."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "back and pack",
        "solution": "Both share -ack."
      },
      {
        "prompt": "sick and pick",
        "solution": "Both share -ick."
      },
      {
        "prompt": "rock and sock",
        "solution": "Both share -ock."
      }
    ],
    "commonMistakes": [
      "Grouping every ck-word together regardless of the rime.",
      "Sorting by the final letters only.",
      "Ignoring the vowel when comparing back and sick.",
      "Guessing a new word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "Final ck appears across several different rime families.",
      "Read each word after sorting.",
      "Use a family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-ack: back, pack.",
      "-ick: sick, pick.",
      "-ock: rock, sock.",
      "-uck: duck, luck.",
      "-eck: neck, deck."
    ]
