  "studyMaterial": {
    "objectives": [
      "Segment short sh-words into phonemes before spelling.",
      "Use sh together to represent one /sh/ sound.",
      "Spell taught words such as ship, shop, shut, fish, dish and wish.",
      "Read each written word back to check the spelling."
    ],
    "concepts": [
      "Encoding moves from spoken sounds to written graphemes.",
      "The /sh/ phoneme is written with the two letters sh in taught words.",
      "Sound boxes can represent phonemes, so sh may occupy one sound box.",
      "Read-back helps detect omitted letters and vowel substitutions."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its ordered phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "sound box",
        "definition": "A box used to map one phoneme; a digraph may share one box."
      }
    ],
    "workedExamples": [
      {
        "prompt": "ship",
        "solution": "Map /sh/ | /i/ | /p/; write sh-i-p."
      },
      {
        "prompt": "fish",
        "solution": "Map /f/ | /i/ | /sh/; write f-i-sh."
      },
      {
        "prompt": "shop",
        "solution": "Map /sh/ | /o/ | /p/; write sh-o-p."
      }
    ],
    "commonMistakes": [
      "Writing only s for the /sh/ phoneme.",
      "Putting s and h in separate sound boxes when mapping phonemes.",
      "Confusing short i in fish with short a in cash.",
      "Not reading the completed word back."
    ],
    "keyTakeaways": [
      "Say the word slowly, then segment its sounds.",
      "Keep sh together for one /sh/ phoneme.",
      "Choose the correct short vowel.",
      "Read the spelling aloud and compare it with the target word."
    ],
    "revisionPoints": [
      "ship = sh + i + p.",
      "shop = sh + o + p.",
      "fish = f + i + sh.",
      "cash = c + a + sh."
    ]
  },
