  "studyMaterial": {
    "objectives": [
      "Decode controlled short words ending in tch.",
      "Read tch as one final /ch/ phoneme in taught words.",
      "Blend catch, match, fetch, pitch, ditch and patch accurately.",
      "Check the short vowel and final grapheme when self-correcting."
    ],
    "concepts": [
      "In taught words, tch represents one final /ch/ phoneme.",
      "The tch spelling commonly follows a short vowel at the end of a one-syllable word.",
      "The letters t, c and h are not spoken as separate sounds in catch.",
      "Accurate decoding uses every grapheme and checks the vowel."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine phonemes in order to read a word."
      },
      {
        "term": "grapheme mapping",
        "definition": "Matching written letters or letter groups to sounds."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and fixing it using the printed word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "c-a-tch",
        "solution": "/k/ /a/ /ch/ blends to catch."
      },
      {
        "prompt": "f-e-tch",
        "solution": "/f/ /e/ /ch/ blends to fetch."
      },
      {
        "prompt": "p-i-tch",
        "solution": "/p/ /i/ /ch/ blends to pitch."
      }
    ],
    "commonMistakes": [
      "Splitting tch into /t/ and /ch/ or three letter sounds.",
      "Changing the short vowel during blending.",
      "Reading catch as cash by overlooking the ending.",
      "Guessing from the first letter and skipping the final grapheme."
    ],
    "keyTakeaways": [
      "Keep tch together as one grapheme in taught words.",
      "Blend each phoneme from left to right.",
      "Check the short vowel and ending.",
      "Reread the whole word after blending."
    ],
    "revisionPoints": [
      "catch = c + a + tch.",
      "fetch = f + e + tch.",
      "pitch = p + i + tch.",
      "match = m + a + tch."
    ]
  },
