  "studyMaterial": {
    "objectives": [
      "Decode taught silent-t words accurately.",
      "Recognise that t is not pronounced in listen, castle, whistle, and fasten in the taught set.",
      "Distinguish silent-t words from words where t is pronounced.",
      "Reread and self-correct when an extra sound is added."
    ],
    "concepts": [
      "In the taught words, t is silent.",
      "The spelling retains t.",
      "The spoken sounds must match the word, not each letter individually.",
      "Context can help confirm the decoded word."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "silent letter",
        "definition": "A written letter that is not pronounced."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode listen.",
        "solution": "Read /lɪsən/ without inserting /t/."
      },
      {
        "prompt": "Compare castle and cattle.",
        "solution": "Castle has silent t; cattle pronounces t."
      },
      {
        "prompt": "If whistle is read with /t/, what should be corrected?",
        "solution": "Do not pronounce the silent t."
      }
    ],
    "commonMistakes": [
      "Adding /t/ to the spoken word.",
      "Removing t from spelling.",
      "Confusing words with different pronunciations.",
      "Guessing from the written letters only."
    ],
    "keyTakeaways": [
      "t is silent in the taught words.",
      "Keep t in spelling.",
      "Do not insert an extra sound.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "listen, castle, whistle, and fasten have silent t in the taught set.",
      "Keep t in spelling.",
      "Read the word naturally.",
      "Reread to confirm the word."
    ]
