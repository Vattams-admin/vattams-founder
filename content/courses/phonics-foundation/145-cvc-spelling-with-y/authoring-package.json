  "studyMaterial": {
    "objectives": [
      "Segment taught y-initial CVC words into three phonemes.",
      "Map each heard phoneme to its grapheme in left-to-right order.",
      "Spell yak, yam, yap, yes, yet, and yen from dictation.",
      "Check the medial vowel and final consonant before confirming a spelling."
    ],
    "concepts": [
      "Encoding begins by hearing and segmenting the word.",
      "A three-sound CVC word needs an initial consonant, a vowel, and a final consonant.",
      "The vowel /a/ and /e/ must not be confused.",
      "Rereading the spelling supports self-correction."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "To separate a spoken word into its individual sounds."
      },
      {
        "term": "encode",
        "definition": "To represent spoken sounds with written graphemes."
      },
      {
        "term": "dictation",
        "definition": "Writing a word or sentence that is spoken aloud."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell yam.",
        "solution": "Hear /y/ /a/ /m/; write y-a-m; reread yam."
      },
      {
        "prompt": "Spell yet.",
        "solution": "Hear /y/ /e/ /t/; select e for the short vowel and t for the final sound."
      },
      {
        "prompt": "Contrast yak and yap.",
        "solution": "Keep y and a; change only the final grapheme k or p."
      }
    ],
    "commonMistakes": [
      "Writing the letter name instead of the sound sequence.",
      "Using a for the short /e/ vowel in yet.",
      "Leaving out the final consonant.",
      "Writing a second consonant because the word sounds unfamiliar."
    ],
    "keyTakeaways": [
      "Say the word, then segment it.",
      "Map one sound at a time.",
      "Check the vowel and final consonant.",
      "Reread the written word and blend it."
    ],
    "revisionPoints": [
      "/y/ /a/ /k/ → yak.",
      "/y/ /a/ /m/ → yam.",
      "/y/ /a/ /p/ → yap.",
      "/y/ /e/ /s/ → yes.",
      "/y/ /e/ /t/ → yet.",
      "/y/ /e/ /n/ → yen."
    ]
  },
