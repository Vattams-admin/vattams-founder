  "studyMaterial": {
    "objectives": [
      "Group z-initial CVC words by shared vowel-plus-ending rimes.",
      "Read zip/sip, zap/map, zig/big, zag/bag, and zen/pen contrasts accurately.",
      "Explain how an onset can change while the rime stays the same.",
      "Decode each word rather than guessing from its family."
    ],
    "concepts": [
      "The onset is the consonant sound before the vowel.",
      "The rime includes the vowel and the sounds after it.",
      "Words can share a rime without sharing the same initial sound.",
      "A family pattern supports decoding but does not replace checking every grapheme."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The consonant sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "A group of words sharing a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "zip and sip",
        "solution": "Both share -ip; the onset changes from /z/ to /s/."
      },
      {
        "prompt": "zap and map",
        "solution": "Both share -ap; only the onset changes."
      },
      {
        "prompt": "zig and big",
        "solution": "Both share -ig; the first consonant distinguishes the words."
      }
    ],
    "commonMistakes": [
      "Grouping every z-word together even when the rime differs.",
      "Ignoring the vowel and sorting by final consonant only.",
      "Assuming similar spelling means identical onset sounds.",
      "Guessing a word from the family without blending it."
    ],
    "keyTakeaways": [
      "Listen for the vowel and ending together.",
      "Name the onset separately from the rime.",
      "Read each word after sorting.",
      "Check all graphemes before confirming the word."
    ],
    "revisionPoints": [
      "-ip: zip, sip.",
      "-ap: zap, map, cap.",
      "-ig: zig, big, dig.",
      "-ag: zag, bag, tag.",
      "-en: zen, pen, ten."
    ]
  },
