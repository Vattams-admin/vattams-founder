  "studyMaterial": {
    "objectives": [
      "Segment controlled th-words into ordered phonemes before spelling.",
      "Use th together to represent one unvoiced /th/ phoneme in taught words.",
      "Spell thin, thick, bath, path, moth and math accurately.",
      "Read each written word back to check the graphemes and vowel."
    ],
    "concepts": [
      "Encoding moves from spoken sounds to written graphemes.",
      "The unvoiced /th/ phoneme is written th in the taught word set.",
      "A digraph can occupy one sound box because it represents one phoneme.",
      "Read-back helps detect omitted letters and vowel substitutions."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its ordered phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "sound box",
        "definition": "A box used to map one phoneme; a digraph may share one box."
      }
    ],
    "workedExamples": [
      {
        "prompt": "thin",
        "solution": "Map /th/ | /i/ | /n/; write th-i-n."
      },
      {
        "prompt": "bath",
        "solution": "Map /b/ | /a/ | /th/; write b-a-th."
      },
      {
        "prompt": "moth",
        "solution": "Map /m/ | /o/ | /th/; write m-o-th."
      }
    ],
    "commonMistakes": [
      "Writing t or f alone for the /th/ phoneme.",
      "Putting t and h in separate sound boxes when mapping phonemes.",
      "Confusing short i in thin with short a in bath.",
      "Not reading the completed word back."
    ],
    "keyTakeaways": [
      "Say the word, then segment its sounds.",
      "Keep th together for one phoneme.",
      "Choose the correct short vowel.",
      "Read the spelling aloud and compare it with the target."
    ],
    "revisionPoints": [
      "thin = th + i + n.",
      "thick = th + i + ck.",
      "bath = b + a + th.",
      "moth = m + o + th."
    ]
  },
