  "studyMaterial": {
    "objectives": [
      "Segment taught sl-words into ordered phonemes.",
      "Map /s/ and /l/ to the correct onset letters.",
      "Spell taught short-vowel sl-words without omitting a sound.",
      "Read the written word back to check spelling."
    ],
    "concepts": [
      "Encoding maps spoken phonemes to graphemes.",
      "The sl onset is /s/ followed by /l/.",
      "The vowel and ending must also be represented.",
      "Reading the spelling back checks sound-letter mapping."
    ],
    "definitions": [
      {
        "term": "phoneme",
        "definition": "A speech sound in a word."
      },
      {
        "term": "grapheme",
        "definition": "A letter or letter group representing a sound."
      },
      {
        "term": "encoding",
        "definition": "Representing spoken sounds with written letters."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell slip.",
        "solution": "Say /s/ /l/ /i/ /p/ and write s-l-i-p."
      },
      {
        "prompt": "Spell slam.",
        "solution": "Segment /s/ /l/ /a/ /m/ and write each grapheme."
      },
      {
        "prompt": "How can spelling be checked?",
        "solution": "Blend the written word and compare it with the intended word."
      }
    ],
    "commonMistakes": [
      "Omitting l after s.",
      "Changing the vowel.",
      "Leaving out the final consonant.",
      "Not reading the spelling back."
    ],
    "keyTakeaways": [
      "Say the phonemes before writing.",
      "Spell s then l in the onset.",
      "Represent the vowel and ending.",
      "Read the written word back."
    ],
    "revisionPoints": [
      "Say the phonemes before writing.",
