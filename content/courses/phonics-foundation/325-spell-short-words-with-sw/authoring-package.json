  "studyMaterial": {
    "objectives": [
      "Segment taught sw-words into ordered phonemes before writing.",
      "Represent s and w in the initial onset in the correct order.",
      "Spell taught sw-words and read them back to check each grapheme.",
      "Repair omissions using sound-by-sound mapping."
    ],
    "concepts": [
      "Encoding maps spoken phonemes to written graphemes.",
      "The sw onset requires s then w.",
      "Read-back checks whether spelling matches the spoken word.",
      "An omitted consonant changes the word."
    ],
    "definitions": [
      {
        "term": "encode",
        "definition": "Write a word using sound-to-letter knowledge."
      },
      {
        "term": "segment",
        "definition": "Separate a spoken word into ordered sounds."
      },
      {
        "term": "read-back",
        "definition": "Read a written response to check it against the intended word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell swim.",
        "solution": "Segment /s/ /w/ /i/ /m/, write s-w-i-m, then read it back."
      },
      {
        "prompt": "A learner writes san for swan. What is missing?",
        "solution": "The w after s."
      },
      {
        "prompt": "How can a learner check swing?",
        "solution": "Say each sound in order, write the graphemes, and read swing back."
      }
    ],
    "commonMistakes": [
      "Omitting w after s.",
      "Reversing the onset letters.",
      "Leaving out the final consonant.",
      "Not reading the written word back."
    ],
    "keyTakeaways": [
      "Hear all phonemes before writing.",
      "Write s then w at the start.",
      "Check the whole word.",
      "Repair the exact missing grapheme."
    ],
    "revisionPoints": [
      "Segment first, then write.",
      "Keep s and w in order.",
      "Spell swim, swan, swing, swish.",
      "Read the written word back."
    ]
  },
