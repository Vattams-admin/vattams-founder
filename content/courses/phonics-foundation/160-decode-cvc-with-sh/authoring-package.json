  "studyMaterial": {
    "objectives": [
      "Decode short words containing initial or final sh by mapping graphemes to phonemes.",
      "Blend /sh/ with the remaining sounds without splitting the digraph.",
      "Read ship, shop, shut, shed, fish, dish, wish and cash accurately.",
      "Self-correct by checking each sound and the vowel."
    ],
    "concepts": [
      "The two letters sh are read as one sound before blending.",
      "Initial-sh words can follow sh + vowel + consonant, as in ship.",
      "Final-sh words can end in a digraph, as in fish.",
      "Accurate decoding uses all graphemes in order, not just the first sound."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine phonemes in order to read a word."
      },
      {
        "term": "grapheme mapping",
        "definition": "Matching each written letter or letter group to its sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and fixing it using the printed word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "sh-i-p",
        "solution": "/sh/ /i/ /p/ blends to ship."
      },
      {
        "prompt": "f-i-sh",
        "solution": "/f/ /i/ /sh/ blends to fish."
      },
      {
        "prompt": "sh-u-t",
        "solution": "/sh/ /u/ /t/ blends to shut."
      }
    ],
    "commonMistakes": [
      "Splitting sh into two sounds.",
      "Reading ship as sip by overlooking h in the digraph.",
      "Changing the short vowel while blending.",
      "Guessing from the first letter and skipping the ending."
    ],
    "keyTakeaways": [
      "Treat sh as one grapheme during blending.",
      "Track left to right through the whole word.",
      "Check the short vowel and final consonant.",
      "Reread the word naturally after blending."
    ],
    "revisionPoints": [
      "sh-i-p → ship.",
      "sh-o-p → shop.",
      "f-i-sh → fish.",
      "d-i-sh → dish."
    ]
  },
