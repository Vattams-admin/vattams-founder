    "objectives": [
      "Read controlled sentences with taught spr-words accurately.",
      "Decode all three onset consonants in spr-words.",
      "Answer literal questions using sentence evidence.",
      "Reread to repair errors and confirm meaning."
    ],
    "concepts": [
      "A sentence expresses a complete thought.",
      "The spr onset contains /s/, /p/, and /r/ in order.",
      "Literal answers are stated directly in the sentence.",
      "Rereading checks decoding and meaning."
    ],
    "definitions": [
      {
        "term": "sentence",
        "definition": "A group of words that expresses a complete thought."
      },
      {
        "term": "literal comprehension",
        "definition": "Understanding information stated directly in a text."
      },
      {
        "term": "text evidence",
        "definition": "Words that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “The sprout is green.” What is green?",
        "solution": "The sprout."
      },
      {
        "prompt": "Read: “A spring is in the box.” What is in the box?",
        "solution": "A spring."
      },
      {
        "prompt": "How can you check an answer?",
        "solution": "Point to the words that state it."
      }
    ],
    "commonMistakes": [
      "Skipping p or r in the spr onset.",
      "Answering from prior knowledge instead of the sentence.",
      "Changing a word by guessing.",
      "Ignoring details in the sentence."
    ],
    "keyTakeaways": [
      "Decode all three onset consonants.",
      "Read the whole sentence.",
      "Answer what the sentence states.",
      "Reread and point to evidence."
    ],
    "revisionPoints": [
