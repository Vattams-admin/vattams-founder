  "studyMaterial": {
    "objectives": [
      "Segment taught shr-words into ordered phonemes.",
      "Spell shrub, shred, and shrimp accurately.",
      "Represent /ʃ/ with sh and keep r in the onset.",
      "Reread the written word and repair mismatched sounds."
    ],
    "concepts": [
      "Spelling maps phonemes to graphemes in order.",
      "The sh digraph represents /ʃ/.",
      "The following r represents /r/.",
      "Rereading checks sound-to-letter correspondence."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a word into its individual speech sounds."
      },
      {
        "term": "digraph",
        "definition": "Two letters that represent one sound."
      },
      {
        "term": "encoding",
        "definition": "Using sounds and spelling knowledge to write a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Segment shrub before writing.",
        "solution": "Map /ʃ/ to sh, then /r/, the vowel, and the ending."
      },
      {
        "prompt": "Compare shred and shed.",
        "solution": "Shred includes /r/ after /ʃ/; shed does not."
      },
      {
        "prompt": "A learner writes shimp for shrimp. What is missing?",
        "solution": "The r representing /r/."
      }
    ],
    "commonMistakes": [
      "Writing only sh and omitting r.",
      "Treating sh as two phonemes.",
      "Changing the vowel.",
      "Omitting the final consonant."
    ],
    "keyTakeaways": [
      "Use sh for /ʃ/.",
      "Write r after sh.",
      "Check the vowel and ending.",
      "Reread the whole word after spelling."
    ],
    "revisionPoints": [
      "sh represents /ʃ/.",
      "shr begins /ʃ/ followed by /r/.",
      "Vowels and endings distinguish shr-words.",
      "Reread to check every sound."
    ]
  },
