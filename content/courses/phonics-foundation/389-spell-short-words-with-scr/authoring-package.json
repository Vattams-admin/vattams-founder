    "concepts": [
      "Spelling maps phonemes to graphemes in order.",
      "The scr onset has three consonant sounds.",
      "Vowel patterns and endings distinguish similar words.",
      "Rereading checks sound-to-letter correspondence."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a word into its individual speech sounds."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "encoding",
        "definition": "Using sounds and spelling knowledge to write a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Segment scrap before writing.",
        "solution": "Say /s/ /k/ /r/ and map the vowel and ending."
      },
      {
        "prompt": "Compare scrap and scrub.",
        "solution": "Both begin scr but the vowel and ending differ."
      },
      {
        "prompt": "A learner writes strap for scrap. What should they check?",
        "solution": "The second onset consonant: c for /k/, not t."
      }
    ],
    "commonMistakes": [
      "Leaving out c in the scr onset.",
