    "objectives": [
      "Segment taught str-words into ordered phonemes.",
      "Spell string, strap, and street accurately.",
      "Keep /s/, /t/, and /r/ in the correct order.",
      "Reread the written word and repair mismatched sounds."
    ],
    "concepts": [
      "Spelling maps phonemes to graphemes in order.",
      "The str onset has three consonants.",
      "Vowel patterns and endings distinguish similar words.",
      "Rereading checks sound-to-letter correspondence."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a word into its individual speech sounds."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "encoding",
        "definition": "Using sounds and spelling knowledge to write a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Segment strap before writing.",
        "solution": "Say /s/ /t/ /r/ and map the vowel and ending."
      },
      {
        "prompt": "Compare strap and street.",
        "solution": "Both begin str but have different vowel patterns and endings."
      },
      {
        "prompt": "A learner writes spring for string. What should they check?",
        "solution": "The second onset consonant: t, not p."
      }
    ],
    "commonMistakes": [
      "Leaving out t or r in the onset.",
      "Writing onset consonants in the wrong order.",
      "Changing the vowel pattern.",
      "Omitting the ending."
    ],
    "keyTakeaways": [
      "Say every sound in order.",
      "Write all three onset consonants.",
      "Check the vowel and ending.",
      "Reread the whole word after spelling."
    ],
