  "studyMaterial": {
    "objectives": [
      "Segment z-initial CVC words into three phonemes before writing.",
      "Map /z/ and short vowels /a/, /e/, and /i/ to the correct graphemes.",
      "Spell zip, zap, zig, zag, zit, and zen from dictation.",
      "Reread written words and correct medial-vowel or final-consonant errors."
    ],
    "concepts": [
      "Encoding starts with hearing and segmenting the word.",
      "Each of the three phonemes needs a grapheme in a CVC spelling.",
      "The medial vowel must match the spoken word.",
      "Rereading links the written graphemes back to the sounds."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its individual sounds."
      },
      {
        "term": "encode",
        "definition": "Represent speech sounds with written graphemes."
      },
      {
        "term": "dictation",
        "definition": "Writing a word that is spoken aloud."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell zip.",
        "solution": "Hear /z/ /i/ /p/; write z-i-p; reread zip."
      },
      {
        "prompt": "Spell zap.",
        "solution": "Hear /z/ /a/ /p/; select a for the medial vowel."
      },
      {
        "prompt": "Contrast zig and zip.",
        "solution": "Keep z and i; change the final grapheme from g to p."
      }
    ],
    "commonMistakes": [
      "Using the right initial letter but the wrong vowel.",
      "Leaving out the final consonant.",
      "Confusing g and p at the end.",
      "Writing the letter name instead of the phoneme."
    ],
    "keyTakeaways": [
      "Say the word naturally, then segment it.",
      "Write one grapheme for each phoneme.",
      "Check the vowel and final consonant.",
      "Reread and blend the spelling to self-correct."
    ],
    "revisionPoints": [
      "/z/ /i/ /p/ → zip.",
      "/z/ /a/ /p/ → zap.",
      "/z/ /i/ /g/ → zig.",
      "/z/ /a/ /g/ → zag.",
      "/z/ /i/ /t/ → zit.",
      "/z/ /e/ /n/ → zen."
    ]
  },
