  "studyMaterial": {
    "objectives": [
      "Measure /w/ sound recognition, decoding, encoding, comprehension and fluency.",
      "Identify component-level strengths and weaknesses.",
      "Use an 80% mastery threshold for advancement.",
      "Route below-mastery skills to targeted remediation."
    ],
    "concepts": [
      "A consolidation diagnostic samples the full taught /w/ cycle.",
      "Accuracy across components gives a more useful mastery picture than one score.",
      "Component-level results guide targeted reteaching.",
      "Fluency depends on accurate decoding plus connected-text rereading."
    ],
    "definitions": [
      {
        "term": "diagnostic",
        "definition": "An assessment used to identify what a learner has mastered and what needs further teaching."
      },
      {
        "term": "mastery threshold",
        "definition": "The minimum performance level used to determine whether a learner is ready to advance."
      },
      {
        "term": "remediation",
        "definition": "Targeted teaching and practice for a skill that is not yet secure."
      }
    ],
    "workedExamples": [
      "A learner scoring 4/5 in decoding has met the 80% component threshold.",
      "A learner missing two encoding items should receive targeted encoding practice before reassessment.",
      "A learner with accurate decoding but weak comprehension should be routed to sentence/passage comprehension practice."
    ],
    "commonMistakes": [
      "Treating one error as failure of the entire cycle.",
      "Advancing without checking weak components.",
      "Using the same item repeatedly as remediation.",
      "Ignoring fluency after accurate word reading."
    ],
    "keyTakeaways": [
      "Check each skill.",
      "Use 80% as the mastery target.",
      "Route weak components.",
      "Reassess with fresh items."
    ],
    "revisionPoints": [
      "/w/ recognition",
      "CVC decoding",
      "CVC encoding",
      "word families",
      "comprehension",
      "fluency"
    ]
  },
  "practice": {
    "basic": [
      "Identify /w/ and decode taught w-CVC words."
    ],
    "conceptual": [
      "Connect errors to the underlying phonics component."
    ],
    "application": [
      "Use diagnostic results to select a remediation route."
    ],
    "higherOrderThinking": [
      "Explain why component-level diagnosis is better than relying only on a total score."
    ],
    "mixedReview": [
      "Integrate sound, decoding, encoding, comprehension and fluency checks."
    ]
  },
  "revision": {
    "quickRevision": [
      "assess → score → identify weak component → remediate → reassess"
    ],
    "flashRecall": [
      "recognition",
      "decoding",
      "encoding",
      "comprehension",
      "fluency"
    ],
    "formulaOrFactBank": [
      "mastery target = 80% or higher"
    ],
    "mistakeBasedRevision": [
      "Map each missed item to its skill before choosing remediation."
    ],
    "weakTopicRevision": [
      "Practise only the weak component, then complete fresh reassessment."
    ]
  },
  "activities": [
    {
      "name": "Skill routing",
      "steps": [
        "Complete the diagnostic.",
        "Group errors by component.",
        "Select targeted practice.",
        "Record the remediation need."
      ]
    },
    {
      "name": "Fluency check",
      "steps": [
        "Read words accurately.",
        "Read connected text.",
        "Reread smoothly.",
        "Record accuracy and fluency observations."
      ]
    }
  ],
  "outcomes": [
    "Learner demonstrates progress across the taught /w/ skill cycle.",
    "System identifies weak components from diagnostic responses.",
    "Learner advances when the 80% mastery target is met or receives targeted remediation."
  ],
