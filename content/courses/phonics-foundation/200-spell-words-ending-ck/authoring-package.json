  "studyMaterial": {
    "objectives": [
      "Segment taught ck-words into ordered phonemes before spelling.",
      "Use ck together to represent one final /k/ phoneme in taught words.",
      "Spell duck, neck, sick, rock, luck and back accurately.",
      "Read each written word back to check the vowel and ending."
    ],
    "concepts": [
      "Encoding moves from spoken sounds to written graphemes.",
      "The final /k/ phoneme is written ck in the taught word set.",
      "A digraph may occupy one sound box because it represents one phoneme.",
      "Read-back helps detect omitted letters and vowel substitutions."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its ordered phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "sound box",
        "definition": "A box used to map one phoneme; a digraph may share one box."
      }
    ],
    "workedExamples": [
      {
        "prompt": "duck",
        "solution": "Map /d/ | /u/ | /k/; write d-u-ck."
      },
      {
        "prompt": "neck",
        "solution": "Map /n/ | /e/ | /k/; write n-e-ck."
      },
      {
        "prompt": "rock",
        "solution": "Map /r/ | /o/ | /k/; write r-o-ck."
      }
    ],
    "commonMistakes": [
      "Writing only c or k when the taught pattern uses ck.",
      "Putting c and k in separate sound boxes when mapping phonemes.",
      "Confusing short u in duck with short o in dock.",
      "Not reading the completed word back."
    ],
    "keyTakeaways": [
      "Say the word, then segment its sounds.",
      "Keep ck together for one final /k/ phoneme.",
      "Choose the correct short vowel.",
      "Read the spelling aloud and compare it with the target."
    ],
    "revisionPoints": [
      "duck = d + u + ck.",
      "neck = n + e + ck.",
      "back = b + a + ck.",
      "rock = r + o + ck."
    ]
  },
