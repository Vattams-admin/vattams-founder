  "studyMaterial": {
    "objectives": [
      "Decode taught scr-words from left to right.",
      "Map s, c, and r to the onset sounds in order in taught examples.",
      "Distinguish the vowel and ending in scrap, scrub, and screen.",
      "Reread and self-correct when a sound is missed."
    ],
    "concepts": [
      "The onset scr represents /s/, /k/, and /r/ in these taught words.",
      "The vowel and ending must also be decoded.",
      "The ending distinguishes similar scr-words.",
      "Rereading the whole word checks sound mapping."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode s-c-r-a-p.",
        "solution": "Map the onset /s/ /k/ /r/, then blend the rest to read scrap."
      },
      {
        "prompt": "Compare scrap and scrub.",
        "solution": "Both begin scr but have different vowel sounds and endings."
      },
      {
        "prompt": "If scrub is read as sub, what is missing?",
        "solution": "The /k/ and /r/ sounds."
      }
    ],
    "commonMistakes": [
      "Skipping c/k or r in the onset.",
      "Changing the vowel.",
      "Ignoring the final consonant.",
      "Guessing from the first letters only."
    ],
    "keyTakeaways": [
      "Map all three onset consonants.",
      "Check the vowel carefully.",
      "Read the ending sound.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "scrap begins with /s/ /k/ /r/.",
      "scr contains three consonants.",
      "Vowel patterns and endings matter.",
      "Reread to confirm the word."
