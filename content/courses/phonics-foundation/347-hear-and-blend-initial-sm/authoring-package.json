    "objectives": [
      "Hear /s/ followed immediately by /m/ at the beginning of taught words.",
      "Blend /s/ and /m/ without inserting an extra vowel.",
      "Distinguish sm from /s/ alone and other taught blends.",
      "Blend the onset with the rest of each complete word."
    ],
    "concepts": [
      "Initial sm contains /s/ followed by /m/.",
      "Both consonants remain in order.",
      "No extra vowel belongs between the consonants.",
      "Whole-word listening confirms the onset."
    ],
    "definitions": [
      {
        "term": "initial blend",
        "definition": "Two consonant sounds heard together at the start of a word."
      },
      {
        "term": "phoneme",
        "definition": "A speech sound that can distinguish one word from another."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to smell.",
        "solution": "Hear /s/ followed by /m/, then blend the remaining sounds."
      },
      {
        "prompt": "Compare smell and sit.",
        "solution": "Smell begins with sm; sit begins with /s/ alone."
      },
      {
        "prompt": "A learner says sell for smell.",
        "solution": "Check that /m/ is present in the onset."
      }
    ],
    "commonMistakes": [
      "Dropping /m/ in the sm onset.",
      "Reversing the consonants.",
