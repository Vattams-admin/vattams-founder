  "studyMaterial": {
    "objectives": [
      "Group ch-words by their vowel-plus-ending rime rather than by ch alone.",
      "Read -ip, -op, -at, -in, -uch and -ich examples accurately.",
      "Explain why chip and chop do not share the same rime.",
      "Decode every word fully even when a familiar family pattern is recognised."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "Words can share an onset but belong to different rime families.",
      "Word families support pattern recognition but do not replace full decoding."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "chip and dip",
        "solution": "Both share -ip; their onsets differ."
      },
      {
        "prompt": "chop and hop",
        "solution": "Both share -op."
      },
      {
        "prompt": "much and such",
        "solution": "Both share -uch."
      }
    ],
    "commonMistakes": [
      "Grouping every ch-word together regardless of the rime.",
      "Sorting by the first two letters only.",
      "Ignoring the vowel when comparing chip and chop.",
      "Guessing a new word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "The ch onset does not make every word rhyme.",
      "Read each word after sorting.",
      "Use a family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-ip: chip, dip.",
      "-op: chop, hop.",
      "-at: chat, cat.",
      "-in: chin, pin.",
      "-uch: much, such."
    ]
  },
