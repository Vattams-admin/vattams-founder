  "studyMaterial": {
    "objectives": [
      "Connect grapheme b to /b/.",
      "Decode taught CVC words containing b.",
      "Blend /b/ with short vowels and taught final consonants.",
      "Self-correct initial and medial vowel decoding errors."
    ],
    "concepts": [
      "The grapheme b represents /b/.",
      "CVC decoding follows the grapheme sequence from left to right.",
      "Blending joins phonemes into a whole word.",
      "Accurate decoding depends on attending to the vowel and final consonant."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or letter group representing a speech sound."
      },
      {
        "term": "blend",
        "definition": "Combine individual phonemes smoothly to pronounce a whole word."
      },
      {
        "term": "decode",
        "definition": "Use grapheme-sound knowledge to read a printed word."
      }
    ],
    "workedExamples": [
      "b-a-t → /b/ /æ/ /t/ → bat.",
      "b-e-d → /b/ /ɛ/ /d/ → bed.",
      "b-u-g → /b/ /ʌ/ /g/ → bug."
    ],
    "commonMistakes": [
      "Replacing /b/ with /d/ or /p/.",
      "Confusing short vowels.",
      "Skipping the final consonant.",
      "Using letter names instead of phonemes."
    ],
    "keyTakeaways": [
      "Map b to /b/.",
      "Decode left to right.",
      "Blend all three sounds.",
      "Check and reread."
    ],
    "revisionPoints": [
      "b = /b/",
      "CVC mapping",
      "short vowels",
      "initial/final b",
      "self-correction"
    ]
  },
  "practice": {
    "basic": [
      "Decode taught b CVC words aloud."
    ],
    "conceptual": [
      "Map each grapheme in a b CVC word to its phoneme."
    ],
    "application": [
      "Repair /b/ or vowel decoding errors."
    ],
    "higherOrderThinking": [
      "Compare CVC words that differ by one phoneme."
    ],
    "mixedReview": [
      "Mix b CVC decoding with previously taught consonants."
    ]
  },
  "revision": {
    "quickRevision": [
      "look → sound → blend → check"
    ],
    "flashRecall": [
      "bat",
      "bed",
      "big",
      "bug",
      "bin"
    ],
    "formulaOrFactBank": [
      "CVC decoding = grapheme sounds in order + blend."
    ],
    "mistakeBasedRevision": [
      "If the word is wrong, isolate each sound and rebuild the blend."
    ],
    "weakTopicRevision": [
      "Practise fresh b CVC words with the weakest short-vowel pattern."
    ]
  },
  "activities": [
    {
      "name": "Sound-to-word mapping",
      "steps": [
        "Show a b CVC word.",
        "Point to each grapheme.",
        "Say each phoneme.",
        "Blend the whole word."
      ]
    },
    {
      "name": "Vowel check",
      "steps": [
        "Decode a b CVC word.",
        "Identify its middle vowel.",
        "Say the vowel sound.",
        "Reread the word."
      ]
    },
    {
      "name": "Contrast decode",
      "steps": [
        "Read two similar CVC words.",
        "Identify the changed sound.",
        "Blend each word.",
        "Explain the difference."
      ]
    }
  ],
  "outcomes": [
