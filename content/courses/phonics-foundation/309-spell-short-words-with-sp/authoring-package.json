  "studyMaterial": {
    "objectives": [
      "Segment taught sp-words into ordered phonemes before writing.",
      "Represent s and p in the initial onset in the correct order.",
      "Spell taught sp-words and read them back to check each grapheme.",
      "Repair omissions using sound-by-sound mapping."
    ],
    "concepts": [
      "Encoding maps spoken phonemes to written graphemes.",
      "The sp onset requires s then p.",
      "Read-back checks whether spelling matches the spoken word.",
      "An omitted consonant changes the word."
    ],
    "definitions": [
      {
        "term": "encode",
        "definition": "Write a word using sound-to-letter knowledge."
      },
      {
        "term": "segment",
        "definition": "Separate a spoken word into ordered sounds."
      },
      {
        "term": "read-back",
        "definition": "Read a written response to check it against the intended word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell spin.",
        "solution": "Segment /s/ /p/ /i/ /n/, write s-p-i-n, then read it back."
      },
      {
        "prompt": "A learner writes sot for spot. What is missing?",
        "solution": "The p after s."
      },
      {
        "prompt": "How can a learner check spill?",
        "solution": "Say each sound in order, write the graphemes, and read spill back."
      }
    ],
    "commonMistakes": [
      "Omitting p after s.",
      "Reversing the onset letters.",
      "Leaving out the final consonant.",
      "Not reading the written word back."
    ],
    "keyTakeaways": [
      "Hear all phonemes before writing.",
      "Write s then p at the start.",
      "Check the whole word.",
      "Repair the exact missing grapheme."
    ],
    "revisionPoints": [
      "Segment first, then write.",
      "Keep s and p in order.",
      "Spell spin, spot, spill, spell.",
      "Read the written word back."
    ]
  },
