  "studyMaterial": {
    "objectives": [
      "Hear and identify /d/ in spoken words.",
      "Distinguish /d/ from /t/ and other consonants.",
      "Identify /d/ at initial, medial, and final positions.",
      "Prepare the learner to connect the sound to grapheme d."
    ],
    "concepts": [
      "/d/ is a consonant phoneme produced with vocal-fold vibration.",
      "The grapheme d represents /d/ in the taught words.",
      "Phoneme position can be initial, medial, or final.",
      "Sound discrimination supports decoding and spelling."
    ],
    "definitions": [
      {
        "term": "phoneme",
        "definition": "The smallest sound unit that can distinguish words."
      },
      {
        "term": "grapheme",
        "definition": "A letter or letter group used to represent a sound."
      },
      {
        "term": "initial position",
        "definition": "The beginning sound position in a word."
      },
      {
        "term": "final position",
        "definition": "The ending sound position in a word."
      }
    ],
    "workedExamples": [
      "Hear “dog” and identify initial /d/.",
      "Hear “bad” and identify final /d/.",
      "Compare /d/ and /t/ in contrasting words.",
      "Sort words by whether /d/ is initial, medial, or final."
    ],
    "commonMistakes": [
      "Confusing /d/ with /t/.",
      "Recognising /d/ initially but missing final /d/.",
      "Using a picture cue instead of listening.",
      "Ignoring word position."
    ],
    "keyTakeaways": [
      "Listen for /d/.",
      "Check word position.",
      "Contrast /d/ with /t/.",
      "Connect sound to d."
    ],
    "revisionPoints": [
