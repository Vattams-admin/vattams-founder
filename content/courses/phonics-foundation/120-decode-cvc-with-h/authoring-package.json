  "studyMaterial": {
    "objectives": [
      "Blend /h/ with short vowels and known consonants.",
      "Decode controlled CVC words containing initial h.",
      "Distinguish /h/ from contrasting initial consonants.",
      "Use left-to-right blending and rereading for accuracy."
    ],
    "concepts": [
      "CVC words contain consonant-vowel-consonant patterns.",
      "The initial h represents /h/ in the taught words.",
      "Blending combines phonemes into a spoken word.",
      "Rereading supports accurate, fluent decoding."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine individual phonemes smoothly to say a word."
      },
      {
        "term": "CVC",
        "definition": "A consonant-vowel-consonant word pattern."
      }
    ],
    "workedExamples": [
      "h-a-t → hat",
      "h-e-n → hen",
      "h-i-p → hip",
      "h-o-p → hop",
      "h-u-g → hug"
    ],
    "commonMistakes": [
      "Replacing /h/ with another consonant.",
      "Guessing from the first letter without blending.",
      "Skipping the middle vowel.",
      "Saying separated sounds without completing the blend."
    ],
    "keyTakeaways": [
      "Start with /h/.",
      "Blend left to right.",
      "Listen for the short vowel.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "/h/",
      "CVC",
      "left-to-right blending",
      "short vowels",
      "rereading"
    ]
  },
