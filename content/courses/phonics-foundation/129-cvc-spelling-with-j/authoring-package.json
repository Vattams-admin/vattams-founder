      "Map /j/ to j during spelling.",
      "Spell controlled CVC words from dictation.",
      "Use read-back to self-correct."
    ],
    "concepts": [
      "CVC words contain three phonemes in these controlled examples.",
      "Initial /j/ maps to grapheme j.",
      "Encoding requires hearing phonemes in order.",
      "Read-back checks sound-letter correspondence."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a word into its individual phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "dictation",
        "definition": "Writing a word after hearing it spoken."
      }
    ],
    "workedExamples": [
      "jam → /j/ /a/ /m/ → j-a-m",
      "jet → /j/ /e/ /t/ → j-e-t",
      "job → /j/ /o/ /b/ → j-o-b"
    ],
    "commonMistakes": [
      "Writing d instead of j.",
      "Skipping the vowel.",
      "Changing the final consonant.",
      "Not reading the spelling back."
    ],
    "keyTakeaways": [
      "Say it.",
      "Segment it.",
      "Map each sound.",
      "Read it back."
    ],
