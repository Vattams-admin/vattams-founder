  "studyMaterial": {
    "objectives": [
      "Group th-words by their vowel-plus-ending rime rather than by th alone.",
      "Read -in, -ick, -ath and -oth examples accurately.",
      "Explain why thin and thick do not share the same rime.",
      "Decode every word fully even when a familiar family pattern is recognised."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "Words can share th but belong to different rime families.",
      "Word families support pattern recognition but do not replace full decoding."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "thin and fin",
        "solution": "Both share -in; their onsets differ."
      },
      {
        "prompt": "thick and sick",
        "solution": "Both share -ick."
      },
      {
        "prompt": "bath and path",
        "solution": "Both share -ath."
      }
    ],
    "commonMistakes": [
      "Grouping every th-word together regardless of the rime.",
      "Sorting by the first two letters only.",
      "Ignoring the vowel when comparing thin and thick.",
      "Guessing a new word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "The th onset does not make every word rhyme.",
      "Read each word after sorting.",
      "Use a family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-in: thin, fin.",
      "-ick: thick, sick.",
      "-ath: bath, path.",
      "-oth: moth, cloth."
    ]
