  "studyMaterial": {
    "objectives": [
      "Read controlled sentences containing taught st-words accurately.",
      "Answer literal questions using explicit sentence evidence.",
      "Use meaning to check decoding without inventing details.",
      "Reread to repair a missed sound and confirm comprehension."
    ],
    "concepts": [
      "Sentence reading combines accurate decoding with meaning.",
      "Literal answers are stated directly in the sentence.",
      "Text evidence supports an answer.",
      "Rereading checks both the st blend and sentence meaning."
    ],
    "definitions": [
      {
        "term": "literal question",
        "definition": "A question answered directly by information stated in the text."
      },
      {
        "term": "text evidence",
        "definition": "Words in a sentence that support an answer."
      },
      {
        "term": "rereading",
        "definition": "Reading again to check accuracy and meaning."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “The step is wet.” What is wet?",
        "solution": "The step."
      },
      {
        "prompt": "Read: “Stan can stop.” What can Stan do?",
        "solution": "Stop."
      },
      {
        "prompt": "Read: “The stem is bent.” What is bent?",
        "solution": "The stem."
      }
    ],
    "commonMistakes": [
      "Answering from imagination instead of the sentence.",
      "Skipping t in an st-word.",
      "Confusing who and what questions.",
      "Reading quickly without checking meaning."
    ],
    "keyTakeaways": [
      "Decode each st-word accurately.",
      "Use the sentence to answer literal questions.",
      "Point to the phrase that supports the answer.",
      "Reread when word or meaning does not match."
    ],
    "revisionPoints": [
      "The step is wet.",
      "Stan can stop.",
      "The stem is bent.",
      "Use sentence evidence and reread to check."
    ]
  },
