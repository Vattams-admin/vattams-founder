  "studyMaterial": {
    "objectives": [
      "Read a short controlled passage containing taught ng-words.",
      "Sequence details in the order stated by the text.",
      "Answer literal questions using evidence from the passage.",
      "Reread and self-correct a word that changes meaning."
    ],
    "concepts": [
      "A passage connects sentences around a simple idea.",
      "Sequencing uses details to identify what happens first, next and last.",
      "Text evidence supports literal answers.",
      "Accurate decoding of ng-words supports comprehension."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "Place events or details in the order they appear in a text."
      },
      {
        "term": "passage",
        "definition": "A connected group of sentences about a topic or event."
      },
      {
        "term": "text evidence",
        "definition": "A word or detail in the text that supports an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "We can sing a song. The song is long.",
        "solution": "The passage introduces singing, then describes the song."
      },
      {
        "prompt": "We can bang a drum.",
        "solution": "This is another action later in the passage."
      },
      {
        "prompt": "Reread a sentence",
        "solution": "Use printed words to verify sequence and answers."
      }
    ],
    "commonMistakes": [
      "Putting details in an order not stated by the text.",
      "Answering from memory without checking the passage.",
      "Confusing final /ŋ/ with /n/.",
      "Skipping small words that change sentence meaning."
    ],
    "keyTakeaways": [
      "Read the whole passage before sequencing.",
      "Use first, next and last to explain the order.",
      "Point to text evidence for each answer.",
      "Decode ng-words fully and reread when meaning is unclear."
    ],
    "revisionPoints": [
      "We can sing a song.",
      "The song is long.",
      "We can bang a drum.",
      "We can sing again."
    ]
  },
