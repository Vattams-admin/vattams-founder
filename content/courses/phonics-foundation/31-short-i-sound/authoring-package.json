  "studyMaterial": {
    "objectives": [
      "Hear and identify short /i/ in CVC words.",
      "Distinguish short /i/ from short /a/.",
      "Connect short /i/ to i."
    ],
    "concepts": [
      "Short /i/ is a vowel sound in the middle of many CVC words.",
      "Vowel discrimination supports reliable decoding and spelling.",
      "Minimal contrasts such as sit/sat and pin/pan establish the new vowel."
    ],
    "definitions": [
      {
        "term": "short /i/",
        "definition": "The short vowel sound represented by i in words such as sit and pin."
      },
      {
        "term": "middle sound",
        "definition": "The vowel phoneme between the first and final consonants of a CVC word."
      }
    ],
    "workedExamples": [
      "sit → /s/ /i/ /t/.",
      "pin → /p/ /i/ /n/.",
      "sit versus sat → compare /i/ and /a/."
    ],
    "commonMistakes": [
      "Confusing /i/ with /a/.",
      "Ignoring the middle sound.",
      "Naming the letter without saying its sound."
    ],
    "keyTakeaways": [
      "Listen to the middle sound.",
      "Short /i/ maps to i.",
      "Compare /i/ with /a/."
    ],
    "revisionPoints": [
      "Hear middle sound → identify /i/ → connect to i."
    ]
  },
  "practice": {
