        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode s-t-r-a-p.",
        "solution": "Map /s/ /t/ /r/ /æ/ /p/ to read strap."
      },
      {
        "prompt": "Compare strap and string.",
        "solution": "Both begin str but have different vowel patterns and endings."
      },
      {
        "prompt": "If street is read as seet, what is missing?",
        "solution": "The /t/ and /r/ sounds."
      }
    ],
    "commonMistakes": [
