    "workedExamples": [
      {
        "prompt": "Compare splat and slat.",
        "solution": "Splat includes /p/ in the onset; slat does not."
      },
      {
        "prompt": "If a learner writes split as slit, what is missing?",
        "solution": "The /p/ sound and letter."
      },
      {
        "prompt": "What follows a diagnostic showing weak blending?",
        "solution": "Targeted practice and fresh reassessment."
      }
    ],
    "commonMistakes": [
