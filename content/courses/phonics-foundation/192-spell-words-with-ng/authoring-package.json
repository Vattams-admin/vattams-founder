  "studyMaterial": {
    "objectives": [
      "Segment taught ng-words into ordered phonemes before spelling.",
      "Use ng together to represent one /ŋ/ phoneme in taught words.",
      "Spell ring, sing, song, long, bang and hung accurately.",
      "Read each written word back to check the vowel and ending."
    ],
    "concepts": [
      "Encoding moves from spoken sounds to written graphemes.",
      "The /ŋ/ phoneme is written ng in the taught word set.",
      "A digraph may occupy one sound box because it represents one phoneme.",
      "Read-back helps detect omitted letters and vowel substitutions."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its ordered phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "sound box",
        "definition": "A box used to map one phoneme; a digraph may share one box."
      }
    ],
    "workedExamples": [
      {
        "prompt": "ring",
        "solution": "Map /r/ | /i/ | /ŋ/; write r-i-ng."
      },
      {
        "prompt": "song",
        "solution": "Map /s/ | /o/ | /ŋ/; write s-o-ng."
      },
      {
        "prompt": "bang",
        "solution": "Map /b/ | /a/ | /ŋ/; write b-a-ng."
      }
    ],
    "commonMistakes": [
      "Writing only n for the final /ŋ/ phoneme.",
      "Putting n and g in separate sound boxes when mapping phonemes.",
      "Confusing short i in sing with short o in song.",
      "Not reading the completed word back."
    ],
    "keyTakeaways": [
      "Say the word, then segment its sounds.",
      "Keep ng together for one /ŋ/ phoneme.",
      "Choose the correct short vowel.",
      "Read the spelling aloud and compare it with the target."
    ],
    "revisionPoints": [
      "ring = r + i + ng.",
      "sing = s + i + ng.",
      "song = s + o + ng.",
      "bang = b + a + ng."
    ]
  },
