  "studyMaterial": {
    "objectives": [
      "Recognize j-initial CVC words in controlled word families.",
      "Identify onset and rime.",
      "Read controlled word-family chains.",
      "Build accuracy through rereading."
    ],
    "concepts": [
      "Onset is the initial sound or consonant.",
      "Rime is the vowel and following sound pattern.",
      "Word families share a common rime.",
      "Repeated accurate reading supports fluency."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The initial consonant sound in a syllable."
      },
      {
        "term": "rime",
        "definition": "The vowel and sounds that follow the onset."
      },
      {
        "term": "word family",
        "definition": "Words sharing a common rime pattern."
      }
    ],
    "workedExamples": [
      "jam → j + -am",
      "jet → j + -et",
      "jig → j + -ig",
      "job → j + -ob",
      "jug → j + -ug"
    ],
    "commonMistakes": [
      "Confusing onset and rime.",
      "Changing the shared rime.",
      "Guessing instead of decoding.",
      "Rereading too quickly to notice errors."
    ],
    "keyTakeaways": [
      "Find the onset.",
      "Find the rime.",
      "Read the family.",
      "Reread accurately."
    ],
    "revisionPoints": [
      "onset",
      "rime",
      "word family",
      "controlled reading",
      "fluency"
    ]
  },
  "practice": {
