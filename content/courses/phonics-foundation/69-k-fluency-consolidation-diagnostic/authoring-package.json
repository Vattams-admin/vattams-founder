  "studyMaterial": {
    "objectives": [
      "Check /k/ sound recognition.",
      "Check /k/ CVC decoding and encoding.",
      "Check controlled-text comprehension.",
      "Check connected reading fluency.",
      "Route learners to targeted remediation using component evidence."
    ],
    "concepts": [
      "Diagnostics separate related skills so support can be precise.",
      "Accurate word reading and fluent connected reading are different measures.",
      "Comprehension depends on accurate decoding plus meaning-making."
    ],
    "definitions": [
      {
        "term": "diagnostic",
        "definition": "An assessment used to identify strengths, needs, and the next instructional step."
      },
      {
        "term": "fluency",
        "definition": "Accurate, appropriately paced, connected reading with meaning."
      },
      {
        "term": "component score",
        "definition": "A score representing performance in one specific skill area."
      }
    ],
    "workedExamples": [
      "Weak sound recognition → review /k/ discrimination.",
      "Weak decoding → practice /k/ CVC blending.",
      "Weak encoding → practice sound-to-letter mapping.",
      "Weak comprehension → reread controlled sentences and locate evidence.",
      "Weak fluency → repeated controlled rereading."
    ],
    "commonMistakes": [
      "Treating every error as a decoding problem.",
      "Guessing words from context.",
      "Confusing correct word reading with fluent reading.",
      "Choosing remediation without checking the component score."
    ],
    "keyTakeaways": [
      "Measure each component.",
      "Match remediation to evidence.",
      "Use accurate decoding before fluency practice.",
      "Reassess after targeted support."
    ],
    "revisionPoints": [
      "sound recognition",
      "decoding",
      "encoding",
      "comprehension",
      "fluency"
    ]
  },
  "practice": {
