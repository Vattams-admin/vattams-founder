  "studyMaterial": {
    "objectives": [
      "Decode taught dr-words by mapping graphemes from left to right.",
      "Blend the dr onset with the vowel and ending to read a complete word.",
      "Distinguish short-vowel words such as drag, drip, and drop.",
      "Reread and self-correct when a consonant or vowel is missed."
    ],
    "concepts": [
      "The letters d and r represent two consonants in the initial dr blend.",
      "The vowel and ending must also be decoded.",
      "Short vowels differ and must be heard precisely.",
      "Reading the whole word back checks the sound mapping."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode d-r-u-m.",
        "solution": "Map /d/ /r/ /ʌ/ /m/ and blend: drum."
      },
      {
        "prompt": "Decode d-r-o-p.",
        "solution": "Map /d/ /r/ /ɒ/ /p/ and blend: drop."
      },
      {
        "prompt": "Compare drag and drip.",
        "solution": "Both begin dr, but drag has short /a/ and drip has short /i/."
      }
    ],
    "commonMistakes": [
      "Reading only dr and guessing the rest.",
      "Confusing short /i/ in drip with short /o/ in drop.",
      "Dropping the final consonant.",
      "Omitting /r/ from the initial blend."
    ],
    "keyTakeaways": [
      "Map every sound from left to right.",
      "Keep both consonants in dr.",
      "Listen carefully to the vowel.",
      "Read the complete word again."
    ],
    "revisionPoints": [
      "drum maps to dr-u-m.",
      "drop maps to dr-o-p.",
      "drip maps to dr-i-p.",
      "Read the full word to check each sound."
    ]
  },
