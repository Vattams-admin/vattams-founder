  "studyMaterial": {
    "objectives": [
      "Read a short controlled passage containing taught sm-words accurately.",
      "Sequence events using the order stated in the passage.",
      "Answer literal questions using passage evidence.",
      "Reread to confirm decoding and event order."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "passage",
        "definition": "A short connected text made of related sentences."
      },
      {
        "term": "text evidence",
        "definition": "Words in the passage that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “Sam has a small bag. Sam smells mint. Sam shuts the bag.” What happens first?",
        "solution": "Sam has a small bag."
      },
      {
        "prompt": "What happens after Sam smells mint?",
        "solution": "Sam shuts the bag."
      },
      {
        "prompt": "How can the sequence be checked?",
        "solution": "Reread each sentence and follow its stated order."
      }
    ],
    "commonMistakes": [
      "Changing the stated event order.",
      "Skipping a sentence.",
      "Inventing a detail.",
      "Misreading an sm-word."
    ],
    "keyTakeaways": [
      "Read each sentence in order.",
      "Retell the stated events.",
      "Use passage evidence for answers.",
      "Reread to confirm the sequence."
    ],
    "revisionPoints": [
      "Read each sentence in order.",
