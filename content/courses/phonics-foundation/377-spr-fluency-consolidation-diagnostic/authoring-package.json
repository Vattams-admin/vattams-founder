    "workedExamples": [
      {
        "prompt": "Compare spring and string.",
        "solution": "Spring begins spr; string begins str."
      },
      {
        "prompt": "If a learner writes spray as say, what is missing?",
        "solution": "The /p/ and /r/ sounds."
      },
      {
        "prompt": "What follows a diagnostic showing weak blending?",
        "solution": "Targeted practice and fresh reassessment."
      }
    ],
