      {
        "term": "diagnostic",
        "definition": "An assessment that identifies strengths and learning needs."
      },
      {
        "term": "fluency",
        "definition": "Accurate reading with appropriate pace and phrasing."
      },
      {
        "term": "remediation",
        "definition": "Targeted practice for a skill that needs support."
      }
