  "studyMaterial": {
    "objectives": [
      "Group sh-words by their vowel-plus-ending rime rather than by sh alone.",
      "Read -ip, -op, -ut, -ell, -ish and -ash examples accurately.",
      "Explain why ship and shop do not share the same rime.",
      "Decode each word fully even when a familiar family pattern is recognised."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "Words can share sh but belong to different rime families.",
      "Word families support pattern recognition but do not replace full decoding."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "ship and dip",
        "solution": "Both share -ip; their onsets differ."
      },
      {
        "prompt": "shop and mop",
        "solution": "Both share -op."
      },
      {
        "prompt": "fish and dish",
        "solution": "Both share -ish."
      }
    ],
    "commonMistakes": [
      "Grouping every sh-word together regardless of the rime.",
      "Sorting by the first two letters only.",
      "Ignoring the vowel when comparing ship and shop.",
      "Guessing a new word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "sh may be an onset or part of the ending.",
      "Read each word after sorting.",
      "Use the family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-ip: ship, dip.",
      "-op: shop, hop.",
      "-ut: shut, cut.",
      "-ish: fish, dish, wish.",
      "-ash: cash, mash."
    ]
