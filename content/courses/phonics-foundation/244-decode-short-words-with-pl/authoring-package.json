  "studyMaterial": {
    "objectives": [
      "Decode taught pl-words by mapping each grapheme in order.",
      "Blend /p/ and /l/ smoothly before the vowel and ending.",
      "Distinguish plan, plug, plum, plot and plop by their rimes.",
      "Self-correct when a consonant or vowel is omitted."
    ],
    "concepts": [
      "The pl onset contains two phonemes, /p/ and /l/.",
      "The vowel and ending distinguish words that share an onset.",
      "Rimes support comparison but do not replace full decoding.",
      "Self-correction returns attention to the written graphemes."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use grapheme-to-phoneme knowledge to read a word."
      },
      {
        "term": "rime",
        "definition": "The vowel and following sounds in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Notice a mismatch and reread the word accurately."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode plan.",
        "solution": "Map p-l-a-n and blend /p/ /l/ /a/ /n/: plan."
      },
      {
        "prompt": "Decode plug.",
        "solution": "Map p-l-u-g and blend: plug."
      },
      {
        "prompt": "Compare plot and plop.",
        "solution": "Both begin pl and have short /o/, but plot ends /t/ and plop ends /p/."
      }
    ],
    "commonMistakes": [
      "Skipping /l/ and reading plug as pug.",
      "Guessing from pl without reading the rime.",
      "Confusing short /a/, /u/ and /o/.",
      "Adding a vowel between /p/ and /l/."
    ],
    "keyTakeaways": [
      "Read pl as /p/ followed by /l/.",
      "Decode the vowel and final sound to identify the word.",
      "Plan, plug, plum, plot and plop have different rimes.",
      "Reread the whole word to check every grapheme."
    ],
    "revisionPoints": [
      "plan has -an.",
      "plug has -ug.",
      "plum has -um.",
      "plot has -ot; plop has -op."
    ]
  },
