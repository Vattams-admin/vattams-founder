  "studyMaterial": {
    "objectives": [
      "Decode controlled words containing unvoiced th at the beginning or end.",
      "Map th as one phoneme while blending left to right.",
      "Read thin, thick, bath, path, moth and math accurately.",
      "Self-correct by checking the vowel and final grapheme."
    ],
    "concepts": [
      "The digraph th is read as one phoneme in the taught words.",
      "Initial th can combine with a short vowel and final consonant, as in thin.",
      "Final th can complete a short word, as in bath.",
      "Accurate decoding uses every grapheme and checks the vowel."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine phonemes in order to read a word."
      },
      {
        "term": "grapheme mapping",
        "definition": "Matching written letters or letter groups to sounds."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and fixing it using the printed word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "th-i-n",
        "solution": "/th/ /i/ /n/ blends to thin."
      },
      {
        "prompt": "b-a-th",
        "solution": "/b/ /a/ /th/ blends to bath."
      },
      {
        "prompt": "m-o-th",
        "solution": "/m/ /o/ /th/ blends to moth."
      }
    ],
    "commonMistakes": [
      "Splitting th into two phonemes.",
      "Reading thin as fin by overlooking the digraph.",
      "Changing the short vowel during blending.",
      "Guessing from the first letters and skipping the ending."
    ],
    "keyTakeaways": [
      "Keep th together as one grapheme in taught words.",
      "Blend each phoneme from left to right.",
      "Check the short vowel and ending.",
      "Reread the whole word after blending."
    ],
    "revisionPoints": [
      "th-i-n → thin.",
      "th-i-ck → thick.",
      "b-a-th → bath.",
      "p-a-th → path."
    ]
  },
