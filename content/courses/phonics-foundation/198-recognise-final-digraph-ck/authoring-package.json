  "studyMaterial": {
    "objectives": [
      "Recognise ck at the end of taught short words such as duck, neck, sick and rock.",
      "Understand that ck represents one final /k/ phoneme in the taught examples.",
      "Notice the short vowel before final ck in these one-syllable words.",
      "Distinguish the two-letter spelling from two separate spoken sounds."
    ],
    "concepts": [
      "A digraph uses two letters to represent one phoneme.",
      "In taught words, final ck represents /k/ after a short vowel.",
      "The letters c and k are not spoken as separate sounds in duck.",
      "Spelling patterns have exceptions and should be learned from controlled examples."
    ],
    "definitions": [
      {
        "term": "digraph",
        "definition": "Two letters working together to represent one phoneme."
      },
      {
        "term": "phoneme",
        "definition": "The smallest sound unit that can distinguish words."
      },
      {
        "term": "short vowel",
        "definition": "A vowel sound as heard in words such as duck, neck and sick."
      }
    ],
    "workedExamples": [
      {
        "prompt": "duck",
        "solution": "The final /k/ sound is written ck."
      },
      {
        "prompt": "neck",
        "solution": "The final ck represents one /k/ phoneme after short e."
      },
      {
        "prompt": "sick",
        "solution": "The final ck represents one /k/ phoneme after short i."
      }
    ],
    "commonMistakes": [
      "Saying separate /c/ and /k/ sounds at the end.",
      "Writing only c or k when the taught pattern uses ck.",
      "Changing the short vowel when reading the word.",
      "Assuming every English word ending in /k/ must use ck."
    ],
    "keyTakeaways": [
      "In taught words, ck represents one final /k/ phoneme.",
      "Notice the short vowel before ck.",
      "Read the whole word from left to right.",
      "Learn exceptions and other /k/ spellings separately."
    ],
    "revisionPoints": [
      "duck: short u + ck.",
      "neck: short e + ck.",
      "sick: short i + ck.",
      "rock: short o + ck."
    ]
  },
