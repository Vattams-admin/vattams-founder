    "objectives": [
      "Segment taught squ-words into ordered phonemes.",
      "Spell squid, squat, and squish accurately.",
      "Remember q is followed by u in the taught squ spelling.",
      "Reread the written word and repair mismatched sounds."
    ],
    "concepts": [
      "Spelling maps phonemes to graphemes in order.",
      "In the taught set, squ represents /s/ plus /kw/.",
      "The q is followed by u in the spelling.",
      "The vowel and ending distinguish similar words."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a word into its individual speech sounds."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "encoding",
        "definition": "Using sounds and spelling knowledge to write a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Segment squid before writing.",
        "solution": "Hear /s/ plus /kw/, then map the vowel and ending."
      },
      {
        "prompt": "Compare squid and squat.",
        "solution": "Both begin squ but have different vowels and endings."
      },
      {
        "prompt": "Why check the written word again?",
        "solution": "To ensure every sound has been represented."
      }
    ],
    "commonMistakes": [
      "Leaving out u after q.",
      "Omitting the /kw/ sequence.",
      "Changing the vowel.",
      "Omitting the final consonant or digraph."
    ],
    "keyTakeaways": [
      "Use squ for the taught /s/ plus /kw/ sequence.",
      "Keep q followed by u.",
      "Check the vowel and ending.",
      "Reread the whole word after spelling."
    ],
    "revisionPoints": [
      "squ begins squid, squat, and squish.",
