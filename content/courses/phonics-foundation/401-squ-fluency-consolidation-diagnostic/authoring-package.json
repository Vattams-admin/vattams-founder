    "workedExamples": [
      {
        "prompt": "Compare squid and skid.",
        "solution": "Squid begins with squ; skid begins with sk."
      },
      {
        "prompt": "A learner reads squid as sid. What is missing?",
        "solution": "The /k/ and /w/ sounds."
      },
      {
        "prompt": "What follows a diagnostic showing weak blending?",
        "solution": "Targeted practice and fresh reassessment."
      }
    ],
