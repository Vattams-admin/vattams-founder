  "studyMaterial": {
    "objectives": [
      "Decode taught fr-words by mapping graphemes from left to right.",
      "Blend the fr onset with the vowel and ending to read a complete word.",
      "Distinguish short-vowel words such as frog, fret, and frill.",
      "Reread and self-correct when a consonant or vowel is missed."
    ],
    "concepts": [
      "The letters f and r represent two consonants in the initial fr blend.",
      "The vowel and ending must also be decoded.",
      "Short vowels differ and must be heard precisely.",
      "Reading the whole word back checks the sound mapping."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode f-r-o-g.",
        "solution": "Map /f/ /r/ /ɒ/ /g/ and blend: frog."
      },
      {
        "prompt": "Decode f-r-e-t.",
        "solution": "Map /f/ /r/ /ɛ/ /t/ and blend: fret."
      },
      {
        "prompt": "Compare fret and frill.",
        "solution": "Both begin fr, but fret has short /e/ and frill has short /i/."
      }
    ],
    "commonMistakes": [
      "Reading only fr and guessing the rest.",
      "Confusing short /e/ in fret with short /i/ in frill.",
      "Dropping the final consonant.",
      "Omitting /r/ from the initial blend."
    ],
    "keyTakeaways": [
      "Map every sound from left to right.",
      "Keep both consonants in fr.",
      "Listen carefully to the vowel.",
      "Read the complete word again."
    ],
    "revisionPoints": [
      "frog maps to fr-o-g.",
      "fret maps to fr-e-t.",
      "frill maps to fr-i-ll.",
      "Read the full word to check each sound."
    ]
  },
