  "studyMaterial": {
    "objectives": [
      "Decode controlled short words ending in ck.",
      "Read ck as one final /k/ phoneme in taught words.",
      "Blend duck, neck, sick, rock, luck and back accurately.",
      "Check the short vowel and final grapheme when self-correcting."
    ],
    "concepts": [
      "In taught words, ck represents one final /k/ phoneme.",
      "The ck spelling commonly follows a short vowel at the end of a one-syllable word.",
      "The letters c and k are not spoken as separate sounds in duck.",
      "Accurate decoding uses every grapheme and checks the vowel."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine phonemes in order to read a word."
      },
      {
        "term": "grapheme mapping",
        "definition": "Matching written letters or letter groups to sounds."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and fixing it using the printed word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "d-u-ck",
        "solution": "/d/ /u/ /k/ blends to duck; ck represents one final phoneme."
      },
      {
        "prompt": "n-e-ck",
        "solution": "/n/ /e/ /k/ blends to neck."
      },
      {
        "prompt": "s-i-ck",
        "solution": "/s/ /i/ /k/ blends to sick."
      }
    ],
    "commonMistakes": [
      "Splitting ck into /c/ and /k/.",
      "Changing the short vowel during blending.",
      "Reading duck as dug by overlooking the ending.",
      "Guessing from the first letter and skipping the final grapheme."
    ],
    "keyTakeaways": [
      "Keep ck together as one grapheme in taught words.",
      "Blend each phoneme from left to right.",
      "Check the short vowel and ending.",
      "Reread the whole word after blending."
    ],
    "revisionPoints": [
      "duck = d + u + ck.",
      "neck = n + e + ck.",
      "sick = s + i + ck.",
      "rock = r + o + ck."
    ]
  },
