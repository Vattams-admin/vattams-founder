  "studyMaterial": {
    "objectives": [
      "Decode taught fl-words by mapping each grapheme in order.",
      "Blend /f/ and /l/ smoothly before the vowel and ending.",
      "Distinguish flap, flip, flop, flag and flat by their rimes.",
      "Self-correct when a consonant or vowel is omitted."
    ],
    "concepts": [
      "The fl onset contains two phonemes, /f/ and /l/.",
      "The vowel and ending distinguish words that share an onset.",
      "Rimes support comparison but do not replace full decoding.",
      "Self-correction returns attention to the written graphemes."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use grapheme-to-phoneme knowledge to read a word."
      },
      {
        "term": "rime",
        "definition": "The vowel and following sounds in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Notice a mismatch and reread the word accurately."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode flap.",
        "solution": "Map f-l-a-p and blend /f/ /l/ /a/ /p/: flap."
      },
      {
        "prompt": "Decode flip.",
        "solution": "Map f-l-i-p and blend: flip."
      },
      {
        "prompt": "Compare flag and flat.",
        "solution": "Both begin fl, but flag ends with /g/ and flat ends with /t/."
      }
    ],
    "commonMistakes": [
      "Skipping /l/ and reading flip as fip.",
      "Guessing from fl without reading the rime.",
      "Confusing short /a/, /i/ and /o/.",
      "Adding a vowel between /f/ and /l/."
    ],
    "keyTakeaways": [
      "Read fl as /f/ followed by /l/.",
      "Decode the vowel and final sound to identify the word.",
      "Flap, flip, flop, flag and flat have different rimes.",
      "Reread the whole word to check every grapheme."
    ],
    "revisionPoints": [
      "flap has -ap.",
      "flip has -ip.",
      "flop has -op.",
      "flag has -ag; flat has -at."
    ]
  },
