  "studyMaterial": {
    "objectives": [
      "Segment taught st-words into ordered phonemes before writing.",
      "Represent s and t in the initial onset in the correct order.",
      "Spell taught st-words and read them back to check each grapheme.",
      "Repair omissions using sound-by-sound mapping."
    ],
    "concepts": [
      "Encoding maps spoken phonemes to written graphemes.",
      "The st onset requires s then t.",
      "Read-back checks whether spelling matches the spoken word.",
      "An omitted consonant changes the word."
    ],
    "definitions": [
      {
        "term": "encode",
        "definition": "Write a word using sound-to-letter knowledge."
      },
      {
        "term": "segment",
        "definition": "Separate a spoken word into ordered sounds."
      },
      {
        "term": "read-back",
        "definition": "Read a written response to check it against the intended word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell stop.",
        "solution": "Segment /s/ /t/ /o/ /p/, write s-t-o-p, then read it back."
      },
      {
        "prompt": "A learner writes sop for stop. What is missing?",
        "solution": "The t after s."
      },
      {
        "prompt": "How can a learner check stem?",
        "solution": "Say each sound in order, write the graphemes, and read stem back."
      }
    ],
    "commonMistakes": [
      "Omitting t after s.",
      "Reversing the onset letters.",
      "Leaving out the final consonant.",
      "Not reading the written word back."
    ],
    "keyTakeaways": [
      "Hear all phonemes before writing.",
      "Write s then t at the start.",
      "Check the whole word.",
      "Repair the exact missing grapheme."
    ],
    "revisionPoints": [
      "Segment first, then write.",
      "Keep s and t in order.",
      "Spell stop, step, stem, stand.",
      "Read the written word back."
    ]
  },
