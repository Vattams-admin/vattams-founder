    "objectives": [
      "Decode taught thr-words from left to right.",
      "Map th to /θ/ and r to /r/.",
      "Distinguish thr-words from words beginning with tr.",
      "Reread and self-correct when a sound is missed."
    ],
    "concepts": [
      "The th digraph represents /θ/ in these taught words.",
      "The onset combines /θ/ followed by /r/.",
      "The vowel and ending complete the word.",
      "Rereading the whole word checks sound mapping."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "digraph",
        "definition": "Two letters representing one speech sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode th-r-ee.",
        "solution": "Map /θ/ /r/ /iː/ to read three."
      },
      {
        "prompt": "Compare throw and tree.",
        "solution": "Throw begins thr; tree begins tr."
      },
      {
        "prompt": "If thrift is read as rift, what is missing?",
        "solution": "The initial /θ/ sound represented by th."
      }
    ],
    "commonMistakes": [
      "Reading th as /t/.",
      "Skipping r.",
      "Confusing thr and tr.",
      "Guessing from the first letters only."
    ],
    "keyTakeaways": [
      "Map th to /θ/.",
      "Keep /r/ after /θ/.",
      "Check the vowel and ending.",
      "Reread the complete word."
    ],
    "revisionPoints": [
