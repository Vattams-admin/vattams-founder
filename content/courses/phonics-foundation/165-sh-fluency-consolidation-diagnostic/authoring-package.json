  "studyMaterial": {
    "objectives": [
      "Demonstrate sh recognition, decoding, spelling, word-family knowledge and comprehension.",
      "Complete a balanced 15-item diagnostic with fresh examples.",
      "Identify the weakest component from response evidence.",
      "Apply the 80% mastery route consistently."
    ],
    "concepts": [
      "A diagnostic samples multiple taught skills.",
      "A score alone is less useful than the pattern of correct and incorrect responses.",
      "Fresh items help reveal transfer rather than memorisation.",
      "Below-threshold results should route to targeted practice, not broad reteaching."
    ],
    "definitions": [
      {
        "term": "diagnostic",
        "definition": "An assessment used to identify strengths and learning needs."
      },
      {
        "term": "mastery threshold",
        "definition": "The minimum score required to advance."
      },
      {
        "term": "transfer",
        "definition": "Applying a learned skill to a new example."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Recognise sh in fish",
        "solution": "Identify the final /sh/ sound."
      },
      {
        "prompt": "Decode shop",
        "solution": "Map sh as one phoneme, then blend /o/ and /p/."
      },
      {
        "prompt": "Spell dish",
        "solution": "Segment /d/ /i/ /sh/ and map each phoneme."
      }
    ],
    "commonMistakes": [
      "Treating a single error as proof of a global reading difficulty.",
      "Advancing below the agreed mastery threshold.",
      "Repeating only memorised examples instead of checking transfer.",
      "Rewarding speed over accuracy and comprehension."
    ],
    "keyTakeaways": [
      "Sample sound recognition, decoding, encoding, word families, comprehension and fluency.",
      "Use the 80% threshold.",
      "Route a weak component to targeted remediation.",
      "Use fresh items during reassessment."
    ],
    "revisionPoints": [
      "sh is two letters representing one phoneme.",
      "Blend and segment all sounds in order.",
      "Sort by rime, not only by sh.",
      "Reread controlled text for meaning."
    ]
  },
