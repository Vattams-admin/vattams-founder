  "studyMaterial": {
    "objectives": [
      "Read a short controlled passage containing taught sw-words accurately.",
      "Sequence stated events using first, next, and last.",
      "Answer literal questions by locating evidence in the passage.",
      "Reread to repair a missed sound while preserving meaning."
    ],
    "concepts": [
      "A passage connects related sentences.",
      "Sequence words describe event order.",
      "Literal answers must match stated text.",
      "Rereading checks decoding and meaning."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "passage",
        "definition": "A short connected text made of related sentences."
      },
      {
        "term": "text evidence",
        "definition": "Words in the passage that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “Sam can swim. Sam swims to the raft. Sam stops and rests.” What happens first?",
        "solution": "Sam can swim."
      },
      {
        "prompt": "What happens after Sam swims to the raft?",
        "solution": "Sam stops and rests."
      },
      {
        "prompt": "How can you verify the order?",
        "solution": "Reread the sentences and identify each stated event."
      }
    ],
    "commonMistakes": [
      "Putting events in an order not stated.",
      "Skipping a sentence while retelling.",
      "Guessing instead of locating evidence.",
      "Misreading the sw onset and changing a word."
    ],
    "keyTakeaways": [
      "Read every sentence accurately.",
      "Retell events in the stated order.",
      "Use a sentence to support each answer.",
      "Reread when decoding or meaning breaks down."
    ],
    "revisionPoints": [
      "Sam can swim.",
      "Sam swims to the raft.",
      "Sam stops and rests.",
      "Use stated evidence to sequence events."
    ]
