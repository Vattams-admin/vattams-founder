  "studyMaterial": {
    "objectives": [
      "Decode taught gl-words by mapping each grapheme in order.",
      "Blend /g/ and /l/ smoothly before the vowel and ending.",
      "Distinguish glad, glob, glum and glass by their rimes.",
      "Self-correct when a consonant or vowel is omitted."
    ],
    "concepts": [
      "The gl onset contains two phonemes, /g/ and /l/.",
      "The vowel and ending distinguish words that share an onset.",
      "Rimes support comparison but do not replace full decoding.",
      "Self-correction returns attention to the written graphemes."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use grapheme-to-phoneme knowledge to read a word."
      },
      {
        "term": "rime",
        "definition": "The vowel and following sounds in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Notice a mismatch and reread the word accurately."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode glad.",
        "solution": "Map g-l-a-d and blend /g/ /l/ /a/ /d/: glad."
      },
      {
        "prompt": "Decode glob.",
        "solution": "Map g-l-o-b and blend: glob."
      },
      {
        "prompt": "Compare glob and glum.",
        "solution": "Both begin gl, but glob has short /o/ and glum has short /u/."
      }
    ],
    "commonMistakes": [
      "Skipping /l/ and reading glob as gob.",
      "Guessing from gl without reading the rime.",
      "Confusing short /a/, /o/ and /u/.",
      "Adding a vowel between /g/ and /l/."
    ],
    "keyTakeaways": [
      "Read gl as /g/ followed by /l/.",
      "Decode the vowel and final sound to identify the word.",
      "Glad, glob, glum and glass have different rimes.",
      "Reread the whole word to check every grapheme."
    ],
    "revisionPoints": [
      "glad has -ad.",
      "glob has -ob.",
      "glum has -um.",
      "glass has -ass."
    ]
  },
