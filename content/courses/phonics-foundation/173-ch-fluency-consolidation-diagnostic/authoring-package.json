    "workedExamples": [
      {
        "prompt": "Recognise ch in chip",
        "solution": "Identify the initial /ch/ sound."
      },
      {
        "prompt": "Decode much",
        "solution": "Map /m/ /u/ /ch/ and blend."
      },
      {
        "prompt": "Spell chat",
        "solution": "Segment /ch/ /a/ /t/ and map the sounds."
      }
    ],
    "commonMistakes": [
      "Treating one error as a global reading problem.",
      "Advancing below the defined mastery threshold.",
      "Repeating memorised examples rather than testing transfer.",
      "Rewarding speed over accuracy and comprehension."
