  "studyMaterial": {
    "objectives": [
      "Sort taught wh-words by their rime rather than by wh alone.",
      "Identify -en, -ip, -iz and -am rimes in controlled examples.",
      "Compare wh-words with familiar words that share the same rime.",
      "Decode each word fully after sorting."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "Words with different onsets can share a rime.",
      "Word-family patterns support decoding but do not replace checking every grapheme."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "when and then",
        "solution": "Both share -en."
      },
      {
        "prompt": "whip and ship",
        "solution": "Both share -ip."
      },
      {
        "prompt": "wham and ham",
        "solution": "Both share -am."
      }
    ],
    "commonMistakes": [
      "Grouping all wh-words together even when their rimes differ.",
      "Sorting only by the initial letters.",
      "Ignoring the vowel and final sounds.",
      "Guessing a word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "The wh onset does not make every word rhyme.",
      "Read each word after sorting.",
      "Use the family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-en: when, then.",
