    ],
    "concepts": [
      "Words can share an onset and differ in the rime.",
      "The vowel and final consonant distinguish words.",
      "Word-family patterns guide attention but do not justify guessing.",
      "Every grapheme should be checked."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The consonant sound or sounds before a word's vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and sounds that follow it in a syllable."
      },
      {
        "term": "word family",
        "definition": "Words that share a sound or spelling pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Compare slip and slim.",
        "solution": "Both begin with sl; p and m make different endings."
      },
      {
        "prompt": "Decode sled.",
        "solution": "Map s-l-e-d and blend the complete word."
      },
      {
        "prompt": "A guess does not fit the print.",
        "solution": "Decode every grapheme from left to right."
      }
    ],
    "commonMistakes": [
