    "objectives": [
      "Identify the taught squ onset in familiar words.",
      "Compare vowels and endings in squid, squat, and squash.",
      "Decode complete words rather than guessing from the onset.",
      "Explain how sound evidence distinguishes the words."
    ],
    "concepts": [
      "In taught words, squ commonly represents /s/ /k/ /w/.",
      "The rime includes the vowel and sounds that follow.",
      "Words can share an onset but have different rimes.",
      "Whole-word decoding checks onset, vowel, and ending."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and any sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words grouped by a shared rime or spelling pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Compare squid and squat.",
        "solution": "Both begin squ, but their vowels differ."
      },
      {
        "prompt": "What is the onset in squash?",
        "solution": "squ, taught here as /s/ /k/ /w/."
      },
      {
        "prompt": "Why read the whole word?",
        "solution": "The onset alone does not identify the vowel or ending."
      }
    ],
    "commonMistakes": [
      "Assuming every squ-word rhymes.",
      "Ignoring the vowel or ending.",
      "Confusing squ with sk or sw.",
      "Guessing from the first letters only."
    ],
    "keyTakeaways": [
      "Identify the taught squ onset.",
      "Compare vowel and ending to find the rime.",
      "Read every grapheme in order.",
      "Check the complete word."
    ],
    "revisionPoints": [
      "Taught squ-words begin with /s/ /k/ /w/.",
