  "studyMaterial": {
    "objectives": [
      "Segment taught tch-words into ordered phonemes before spelling.",
      "Use tch together to represent one final /ch/ phoneme in taught words.",
      "Spell catch, match, fetch, pitch, ditch and patch accurately.",
      "Read each written word back to check the vowel and ending."
    ],
    "concepts": [
      "Encoding moves from spoken sounds to written graphemes.",
      "The final /ch/ phoneme is written tch in the taught word set.",
      "A trigraph may occupy one sound box because it represents one phoneme.",
      "Read-back helps detect omitted letters and vowel substitutions."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a spoken word into its ordered phonemes."
      },
      {
        "term": "encode",
        "definition": "Represent spoken phonemes with written graphemes."
      },
      {
        "term": "sound box",
        "definition": "A box used to map one phoneme; a trigraph may share one box."
      }
    ],
    "workedExamples": [
      {
        "prompt": "catch",
        "solution": "Map /k/ | /a/ | /ch/; write c-a-tch."
      },
      {
        "prompt": "fetch",
        "solution": "Map /f/ | /e/ | /ch/; write f-e-tch."
      },
      {
        "prompt": "pitch",
        "solution": "Map /p/ | /i/ | /ch/; write p-i-tch."
      }
    ],
    "commonMistakes": [
      "Writing only ch when the taught word uses tch.",
      "Putting t, c and h in separate sound boxes when mapping phonemes.",
      "Confusing short a in catch with short i in pitch.",
      "Not reading the completed word back."
    ],
    "keyTakeaways": [
      "Say the word, then segment its sounds.",
      "Keep tch together for one final /ch/ phoneme.",
      "Choose the correct short vowel.",
      "Read the spelling aloud and compare it with the target."
    ],
    "revisionPoints": [
      "catch = c + a + tch.",
      "match = m + a + tch.",
      "fetch = f + e + tch.",
      "pitch = p + i + tch."
    ]
  },
