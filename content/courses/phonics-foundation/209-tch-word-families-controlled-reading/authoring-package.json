  "studyMaterial": {
    "objectives": [
      "Group taught tch-words by their vowel-plus-ending rime.",
      "Read -atch and -itch examples accurately.",
      "Explain why catch and pitch do not share the same rime.",
      "Decode every word fully even when a familiar family pattern is recognised."
    ],
    "concepts": [
      "The onset is the sound or sounds before the vowel.",
      "The rime includes the vowel and any following sounds.",
      "Words can share final tch but belong to different rime families.",
      "Word families support pattern recognition but do not replace full decoding."
    ],
    "definitions": [
      {
        "term": "onset",
        "definition": "The sound or sounds before the vowel."
      },
      {
        "term": "rime",
        "definition": "The vowel and the sounds that follow it."
      },
      {
        "term": "word family",
        "definition": "Words that share a rime pattern."
      }
    ],
    "workedExamples": [
      {
        "prompt": "catch and match",
        "solution": "Both share -atch."
      },
      {
        "prompt": "patch and catch",
        "solution": "Both share -atch."
      },
      {
        "prompt": "pitch and ditch",
        "solution": "Both share -itch."
      }
    ],
    "commonMistakes": [
      "Grouping every tch-word together regardless of the rime.",
      "Sorting by the final letters only.",
      "Ignoring the vowel when comparing catch and pitch.",
      "Guessing a new word from a familiar family without decoding it."
    ],
    "keyTakeaways": [
      "Compare the vowel and ending to identify a rime.",
      "Final tch appears across different rime families.",
      "Read each word after sorting.",
      "Use a family as a clue, then check every grapheme."
    ],
    "revisionPoints": [
      "-atch: catch, match, patch.",
      "-itch: pitch, ditch, stitch.",
      "Catch and pitch have different rimes.",
      "Decode each word fully."
    ]
  },
