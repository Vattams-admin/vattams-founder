  "studyMaterial": {
    "objectives": [
      "Decode controlled words ending in ng by mapping ng as one phoneme.",
      "Blend the initial sounds and vowel with final /ŋ/.",
      "Read ring, sing, song, long, bang, rang, hung and sung accurately.",
      "Self-correct by checking the vowel and final grapheme."
    ],
    "concepts": [
      "The digraph ng is read as one /ŋ/ phoneme in the taught words.",
      "The vowel changes the word family: -ing, -ang, -ong and -ung.",
      "Accurate decoding uses all graphemes in order.",
      "The learner should not pronounce an extra /g/ after ng in the taught words."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine phonemes in order to read a word."
      },
      {
        "term": "grapheme mapping",
        "definition": "Matching written letters or letter groups to sounds."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and fixing it using the printed word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "r-i-ng",
        "solution": "/r/ /i/ /ŋ/ blends to ring."
      },
      {
        "prompt": "s-o-ng",
        "solution": "/s/ /o/ /ŋ/ blends to song."
      },
      {
        "prompt": "b-a-ng",
        "solution": "/b/ /a/ /ŋ/ blends to bang."
      }
    ],
    "commonMistakes": [
      "Splitting ng into /n/ plus /g/.",
      "Changing the short vowel while blending.",
      "Reading sing as sin by missing the final digraph.",
      "Guessing from the first letter and skipping the ending."
    ],
    "keyTakeaways": [
      "Keep ng together as one grapheme in taught words.",
      "Blend from left to right.",
      "Check the short vowel and ending.",
      "Reread the complete word naturally."
    ],
    "revisionPoints": [
      "r-i-ng → ring.",
      "s-i-ng → sing.",
      "s-o-ng → song.",
      "h-u-ng → hung."
    ]
  },
