    "objectives": [
      "Segment taught thr-words into ordered phonemes.",
      "Spell three, throw, and thrift accurately.",
      "Represent /θ/ with th and preserve the following r.",
      "Reread the written word and repair mismatched sounds."
    ],
    "concepts": [
      "Spelling maps phonemes to graphemes in order.",
      "The th digraph represents /θ/ in these words.",
      "The onset continues with r.",
      "Rereading checks sound-to-letter correspondence."
    ],
    "definitions": [
      {
        "term": "segment",
        "definition": "Separate a word into its individual speech sounds."
      },
      {
        "term": "digraph",
        "definition": "Two letters representing one speech sound."
      },
      {
        "term": "encoding",
        "definition": "Using sounds and spelling knowledge to write a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Segment three before writing.",
        "solution": "/θ/ /r/ /iː/; write t-h-r-e-e."
      },
      {
        "prompt": "Compare three and tree.",
        "solution": "Three begins with th; tree begins with t."
      },
      {
        "prompt": "A learner writes tree for three. What needs checking?",
        "solution": "The initial /θ/ sound represented by th."
      }
    ],
    "commonMistakes": [
      "Writing t instead of th.",
      "Leaving out r.",
      "Changing the vowel pattern.",
      "Omitting the final sound."
    ],
    "keyTakeaways": [
      "Represent /θ/ with th.",
      "Write r after the digraph.",
      "Check the vowel and ending.",
      "Reread the whole word after spelling."
    ],
    "revisionPoints": [
