  "studyMaterial": {
    "objectives": [
      "Read a short controlled passage containing taught sm-words accurately.",
      "Sequence stated events as first, next, and last.",
      "Answer literal questions using passage evidence.",
      "Reread to repair a missed sound and retain the passage meaning."
    ],
    "concepts": [
      "A passage links sentences around one event.",
      "Sequence words show the order of stated events.",
      "Text evidence supports literal answers.",
      "Rereading checks decoding and comprehension."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "passage",
        "definition": "A short connected text made of related sentences."
      },
      {
        "term": "text evidence",
        "definition": "Words in the passage that support an answer."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Read: “Sam has a smock. Sam puts it on. Sam smiles.” What happens first?",
        "solution": "Sam has a smock."
      },
      {
        "prompt": "What happens after Sam puts on the smock?",
        "solution": "Sam smiles."
      },
      {
        "prompt": "How do you check the order?",
        "solution": "Reread each sentence and point to the stated event."
      }
    ],
    "commonMistakes": [
      "Putting events in an order not stated.",
      "Skipping m in smock or smile.",
      "Guessing instead of using the passage.",
      "Skipping a sentence when retelling."
    ],
    "keyTakeaways": [
      "Read every sentence accurately.",
      "Use first, next, and last to retell.",
      "Point to a sentence that supports each answer.",
      "Reread when meaning does not match."
    ],
    "revisionPoints": [
      "Sam has a smock.",
      "Sam puts it on.",
      "Sam smiles.",
      "Sequence events using stated text evidence."
    ]
  },
