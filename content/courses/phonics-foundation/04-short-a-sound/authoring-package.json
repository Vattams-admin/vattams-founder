  "studyMaterial": {
    "objectives": [
      "Hear and identify short /a/.",
      "Identify /a/ as the middle sound in familiar CVC words.",
      "Prepare for oral blending."
    ],
    "concepts": [
      "Short /a/ is a vowel phoneme.",
      "In simple CVC words /a/ can occur between two consonants."
    ],
    "definitions": [
      {
        "term": "short a",
        "definition": "The vowel sound /a/ heard in words such as mat, sat and map."
      }
    ],
    "workedExamples": [
      "/m/ /a/ /t/ → mat",
      "/s/ /a/ /t/ → sat",
      "/m/ /a/ /p/ → map"
    ],
    "commonMistakes": [
      "Saying the letter name instead of the sound.",
      "Ignoring the middle vowel.",
      "Confusing /a/ with another vowel."
    ],
    "keyTakeaways": [
      "Short /a/ is a sound, not the letter name.",
      "Listen for the middle sound."
    ],
    "revisionPoints": [
      "Hear /a/.",
      "Find /a/ in CVC words.",
      "Compare the sound with known consonants."
    ]
  },
  "practice": {
    "basic": [
      "Repeat /a/.",
      "Identify /a/ in a word."
    ],
    "conceptual": [
      "Distinguish the sound from the letter name.",
      "Identify the middle vowel."
    ],
    "application": [
      "Sort words containing short /a/.",
      "Identify /a/ in segmented CVC words."
    ],
    "higherOrderThinking": [
      "Explain why mat and sat share a middle sound.",
      "Correct a learner who replaces /a/ with another vowel."
    ],
    "mixedReview": [
      "Mix sound, position and CVC-word checks."
    ]
  },
  "revision": {
    "quickRevision": [
      "Hear /a/.",
      "Find /a/ in the middle of CVC words."
    ],
    "flashRecall": [
      "mat → /a/",
      "sat → /a/",
      "map → /a/"
    ],
    "formulaOrFactBank": [
      "CVC = consonant + short /a/ + consonant"
    ],
    "mistakeBasedRevision": [
      "If the learner says the letter name, model /a/ and repeat it in a word."
    ],
    "weakTopicRevision": [
      "Practise 10 short-a listening items until 8 are correct."
    ]
