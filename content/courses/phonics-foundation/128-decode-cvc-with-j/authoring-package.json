  "studyMaterial": {
    "objectives": [
      "Blend /j/ with short vowels and known consonants.",
      "Decode controlled j-initial CVC words.",
      "Use left-to-right blending.",
      "Self-correct decoding errors through rereading."
    ],
    "concepts": [
      "CVC words contain consonant-vowel-consonant patterns.",
      "Initial j represents /j/ in the taught words.",
      "Blending combines phonemes into a spoken word.",
      "Rereading confirms accurate decoding."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine individual phonemes smoothly to say a word."
      },
      {
        "term": "CVC",
        "definition": "A consonant-vowel-consonant word pattern."
      }
    ],
    "workedExamples": [
      "j-a-m → jam",
      "j-e-t → jet",
      "j-i-g → jig",
      "j-o-b → job",
      "j-u-g → jug"
    ],
    "commonMistakes": [
      "Replacing /j/ with another consonant.",
      "Skipping the middle vowel.",
      "Guessing the word.",
      "Failing to reread."
    ],
    "keyTakeaways": [
      "Start with /j/.",
      "Blend left to right.",
      "Listen for the short vowel.",
      "Reread smoothly."
    ],
