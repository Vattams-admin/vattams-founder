      "Events have an order in a passage.",
      "Sequencing supports comprehension and retelling.",
      "Controlled text reinforces phonics while reading for meaning."
    ],
    "definitions": [
      {
        "term": "sequence",
        "definition": "The order in which events happen."
      },
      {
        "term": "retell",
        "definition": "Tell the important events again in order."
      },
      {
        "term": "text evidence",
        "definition": "Details from the text that support an answer."
      }
    ],
    "workedExamples": [
      "First identify the opening event, then the middle event, then the ending event.",
      "Reread a difficult sentence before deciding its place in the sequence."
    ],
