  "studyMaterial": {
    "objectives": [
      "Hear /t/ at the beginning of familiar spoken words.",
      "Connect /t/ to t/T.",
      "Distinguish the target sound from contrasting sounds."
    ],
    "concepts": [
      "/t/ is a phoneme.",
      "t/T is a common grapheme for /t/."
    ],
    "definitions": [
      {
        "term": "phoneme",
        "definition": "The smallest unit of sound that can change a word's meaning."
      },
      {
        "term": "grapheme",
        "definition": "A written representation of a speech sound."
      }
    ],
    "workedExamples": [
      {
        "word": "top",
        "letter": "t",
        "example": "top begins with /t/."
      },
      {
        "word": "ten",
        "letter": "t",
        "example": "ten begins with /t/."
      }
    ],
    "commonMistakes": [
      "Naming the letter instead of producing the sound.",
      "Adding an unnecessary vowel to an isolated consonant."
    ],
    "keyTakeaways": [
      "/t/ is the target initial sound.",
      "Listen first, then connect the sound to t/T."
    ],
    "revisionPoints": [
      "Identify /t/ in spoken words.",
      "Match t/T to /t/."
    ]
  },
  "practice": {
