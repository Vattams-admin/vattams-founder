    "objectives": [
      "Hear /s/ followed immediately by /l/ at the beginning of taught words.",
      "Blend /s/ and /l/ without inserting an extra vowel.",
      "Distinguish sl from /s/ alone and other taught blends.",
      "Blend the onset with the rest of each complete word."
    ],
    "concepts": [
      "Initial sl contains /s/ followed by /l/.",
      "Both consonants remain in order.",
      "No extra vowel belongs between the consonants.",
      "Whole-word listening confirms the onset."
    ],
    "definitions": [
      {
        "term": "initial blend",
        "definition": "Two consonant sounds heard together at the start of a word."
      },
      {
        "term": "phoneme",
        "definition": "A speech sound that can distinguish one word from another."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to slip.",
        "solution": "Hear /s/ followed by /l/, then blend the remaining sounds."
      },
      {
        "prompt": "Compare slip and sit.",
        "solution": "Slip begins with sl; sit begins with /s/ alone."
      },
      {
        "prompt": "A learner says sip for slip.",
        "solution": "Check that /l/ is present in the onset."
      }
    ],
    "commonMistakes": [
      "Dropping /l/ in the sl onset.",
      "Reversing the consonants.",
      "Adding a vowel between consonants.",
      "Guessing from the first letter."
    ],
    "keyTakeaways": [
