  "studyMaterial": {
    "objectives": [
      "Reteach weak /g/ components identified by diagnostic evidence.",
      "Reassess /g/ recognition, decoding, encoding, comprehension, and fluency with fresh items.",
      "Route the learner to advancement or another targeted reteach cycle."
    ],
    "concepts": [
      "Remediation targets demonstrated weaknesses.",
      "Fresh items provide new evidence of learning.",
      "Mastery requires the threshold and adequate critical components.",
      "Comprehension and fluency remain part of phonics consolidation."
    ],
    "definitions": [
      {
        "term": "targeted remediation",
        "definition": "Focused instruction for a specific skill component identified as weak."
      },
      {
        "term": "reassessment",
        "definition": "Fresh measurement after remediation used to determine mastery."
      },
      {
        "term": "fresh item",
        "definition": "A new item testing the same skill without repeating a prior assessment item."
      }
    ],
    "workedExamples": [
      "If /g/ versus /k/ is weak, practise listening and identifying the contrast.",
      "If a short vowel is weak, segment and spell CVC words with that vowel.",
      "If comprehension is weak, reread controlled text and answer from evidence.",
      "If fluency is weak, reread accurately with phrasing and meaning."
    ],
    "commonMistakes": [
      "Repeating the same diagnostic items.",
      "Practising a strong component instead of the weak one.",
      "Advancing because of speed despite errors.",
      "Ignoring comprehension while checking decoding."
    ],
    "keyTakeaways": [
      "Target the weak component.",
      "Use fresh evidence.",
      "Accuracy and meaning matter.",
      "Advance only after mastery."
    ],
    "revisionPoints": [
      "/g/ recognition",
      "CVC decoding",
      "CVC encoding",
      "comprehension",
      "fluency",
      "80%"
    ]
  },
  "practice": {
