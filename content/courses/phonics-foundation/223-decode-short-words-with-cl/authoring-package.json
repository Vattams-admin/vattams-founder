  "studyMaterial": {
    "objectives": [
      "Decode taught cl-words by mapping each grapheme in order.",
      "Blend /k/ and /l/ smoothly before the vowel and ending.",
      "Distinguish clap, clip, clog, clam, club and cluck by their vowel and rime.",
      "Self-correct when a consonant or vowel is omitted."
    ],
    "concepts": [
      "The cl onset contains two phonemes, /k/ and /l/.",
      "The vowel and ending distinguish words that share an onset.",
      "A rime can support comparison but does not replace full decoding.",
      "Self-correction returns attention to the written graphemes."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use grapheme-to-phoneme knowledge to read a word."
      },
      {
        "term": "rime",
        "definition": "The vowel and following sounds in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Notice a mismatch and reread the word accurately."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode clap.",
        "solution": "Map c-l-a-p and blend /k/ /l/ /a/ /p/: clap."
      },
      {
        "prompt": "Decode clip.",
        "solution": "Map c-l-i-p and blend: clip."
      },
      {
        "prompt": "Compare clog and club.",
        "solution": "Both begin cl, but clog has short /o/ and club has short /u/."
      }
    ],
    "commonMistakes": [
      "Skipping /l/ and reading clip as kip.",
      "Guessing from cl without reading the rime.",
      "Confusing short /i/, /o/ and /u/.",
      "Adding a vowel between /k/ and /l/."
    ],
    "keyTakeaways": [
      "Read cl as /k/ followed by /l/.",
      "Decode the vowel and final sound to identify the word.",
      "clap, clip, clog, clam and club have different rimes.",
      "Reread the whole word to check every grapheme."
    ],
    "revisionPoints": [
      "clap has -ap.",
      "clip has -ip.",
      "clog has -og.",
      "clam has -am; club has -ub."
    ]
  },
