  "studyMaterial": {
    "objectives": [
      "Target the weakest short-/u/ component identified by Lesson 61.",
      "Repair sound, decoding, encoding, comprehension, or fluency errors.",
      "Use fresh items to reassess transfer.",
      "Apply an explicit advance/reteach decision."
    ],
    "concepts": [
      "Remediation should match the diagnosed error.",
      "Fresh items provide a stronger transfer check.",
      "Instructional decisions should use evidence."
    ],
    "definitions": [
      {
        "term": "targeted remediation",
        "definition": "Practice focused on a diagnosed skill gap."
      },
      {
        "term": "fresh-item reassessment",
        "definition": "A follow-up check using new items measuring the same skill."
      },
      {
        "term": "mastery target",
        "definition": "The minimum performance level required to advance."
      }
    ],
    "workedExamples": [
      "Weak sound recognition → rehearse short-/u/ identification.",
      "Weak decoding → blend short-/u/ CVC words.",
      "Weak comprehension → reread controlled text and locate evidence.",
      "Weak fluency → repeated accurate rereading."
    ],
    "commonMistakes": [
      "Using the same support for every error.",
      "Treating memorized answers as transfer.",
      "Advancing despite persistent errors.",
      "Repeating support without checking results."
    ],
    "keyTakeaways": [
      "Match support to the error.",
      "Use fresh items.",
      "Check the target.",
      "Advance or reteach from evidence."
    ],
    "revisionPoints": [
      "diagnose",
      "target",
      "practice",
      "reassess",
      "decide"
    ]
  },
  "practice": {
    "basic": [
      "Review short-/u/ sounds and CVC words."
    ],
    "conceptual": [
      "Match errors to the appropriate support."
    ],
    "application": [
      "Apply decoding, encoding, comprehension, and fluency repair."
    ],
    "higherOrderThinking": [
      "Explain why fresh items improve the transfer check."
    ],
    "mixedReview": [
      "Combine short-/u/ word reading with comprehension and routing decisions."
    ]
  },
  "revision": {
    "quickRevision": [
      "Find weakness → target → practice → fresh check."
    ],
    "flashRecall": [
      "target",
      "repair",
      "fresh",
      "target",
      "advance/reteach"
    ],
    "formulaOrFactBank": [
      "Mastery target = 0.8"
    ],
    "mistakeBasedRevision": [
      "If a component remains below target, reteach that component."
    ],
    "weakTopicRevision": [
      "Repeat only the weak component with new controlled examples."
    ]
  },
  "activities": [
    {
      "name": "Targeted repair",
      "steps": [
        "Review the diagnostic result.",
        "Select the weakest component.",
        "Practice controlled short-/u/ items.",
        "Record improvement."
      ]
    },
    {
      "name": "Fresh-item check",
      "steps": [
        "Present unseen items.",
        "Read or answer independently.",
        "Score by component.",
        "Compare with target."
      ]
    },
    {
      "name": "Advance or reteach",
      "steps": [
        "Review reassessment performance.",
        "Advance when target is met.",
        "Reteach the weak component when it is not met."
      ]
    }
  ],
  "assessment": {
    "assessmentId": "PF62-REASSESS-01",
    "type": "reassessment",
    "components": [
      "soundRecognition",
