      "method": "component-level accuracy with overall mastery gate"
    },
    "freshItemPolicy": true,
    "decisionRules": {
      "advance": "Advance when reassessment meets 0.8 and no critical component remains below target.",
      "reteach": "Reteach the specific component when performance remains below 0.8."
    }
  },
  "outcomes": [
    "Learner receives targeted short-/u/ remediation.",
