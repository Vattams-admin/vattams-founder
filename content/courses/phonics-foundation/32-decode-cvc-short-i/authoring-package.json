  "status": "draft",
  "studyMaterial": {
    "objectives": [
      "Blend short /i/ with taught consonants to decode CVC words.",
      "Read short /i/ words accurately without guessing.",
      "Use the middle-vowel contrast to correct /i/ and /a/ confusions."
    ],
    "concepts": [
      "CVC decoding requires ordered phoneme blending.",
      "Short /i/ can be combined with taught consonants to form controlled CVC words.",
      "Minimal contrasts reveal the exact phoneme causing a decoding error."
    ],
    "definitions": [
      {
        "term": "decoding",
        "definition": "Using grapheme-sound relationships to read a written word."
      },
      {
        "term": "blending",
        "definition": "Combining individual phonemes into a whole spoken word."
      },
      {
        "term": "minimal contrast",
        "definition": "A pair of words differing in one relevant sound."
      }
    ],
    "workedExamples": [
      "s-i-t → /s/ /i/ /t/ → sit.",
      "p-i-n → /p/ /i/ /n/ → pin.",
      "sit/sat → check the middle vowel when the word is misread."
    ],
    "commonMistakes": [
      "Replacing /i/ with /a/.",
      "Guessing from the first consonant.",
      "Skipping the middle vowel.",
      "Adding an extra vowel while blending."
    ],
    "keyTakeaways": [
      "Say every sound.",
      "Keep the middle vowel.",
      "Blend smoothly.",
      "Reread the whole word."
    ],
    "revisionPoints": [
      "See → sound → blend → check."
    ]
  },
  "practice": {
    "basic": [
      "Blend short /i/ CVC words."
    ],
    "conceptual": [
      "Compare /i/ and /a/ contrasts."
    ],
    "application": [
      "Decode sit, pin and tin."
    ],
    "higherOrderThinking": [
      "Identify the phoneme to revisit after an error."
    ],
    "mixedReview": [
      "Decode short /a/ and /i/ CVC words."
    ]
  },
  "revision": {
    "quickRevision": [
      "s-i-t → sit",
      "p-i-n → pin",
      "t-i-n → tin"
    ],
    "flashRecall": [
      "i = short /i/"
    ],
    "formulaOrFactBank": [
      "CVC decoding = ordered sound blending"
    ],
    "mistakeBasedRevision": [
      "sit/sat error → isolate middle vowel.",
      "pin/pan error → isolate middle vowel."
    ],
    "weakTopicRevision": [
      "Practise minimal pairs before returning to full CVC reading."
    ]
  },
  "activities": [
    {
      "name": "Sound-to-word blend",
      "steps": [
        "Point to each grapheme.",
        "Say its sound.",
        "Blend all sounds.",
        "Reread the word."
      ]
    },
    {
      "name": "i/a contrast",
      "steps": [
        "Read sit and sat.",
        "Compare the middle sound.",
        "Read again.",
        "Repeat with pin and pan."
      ]
    }
  ],
  "outcomes": [
    "Learner decodes short /i/ CVC words with at least 80% accuracy.",
    "Learner maintains the short /i/ middle sound during blending.",
    "Learner corrects common /i/-/a/ decoding confusions."
  ],
