  "studyMaterial": {
    "objectives": [
      "Recognise the th digraph and /r/ in taught thr-words.",
      "Blend /θ/ and /r/ smoothly without inserting a vowel.",
      "Distinguish thr from tr and th at the start of words.",
      "Blend the onset with the rest of the word."
    ],
    "concepts": [
      "In taught thr-words, th represents /θ/ and r represents /r/.",
      "The onset is /θ/ followed by /r/.",
      "The vowel and ending complete the word.",
      "Do not insert a vowel between the onset sounds."
    ],
    "definitions": [
      {
        "term": "digraph",
        "definition": "Two letters that represent one speech sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to three.",
        "solution": "Hear /θ/ then /r/, followed by /iː/."
      },
      {
        "prompt": "Compare three and tree.",
        "solution": "Three begins with /θr/; tree begins with /tr/."
      },
      {
        "prompt": "Listen to throw.",
        "solution": "Blend /θ/ and /r/ before the vowel and ending."
      }
    ],
    "commonMistakes": [
      "Pronouncing th as /t/.",
      "Leaving out /r/.",
      "Adding a vowel between /θ/ and /r/.",
      "Confusing thr with tr."
    ],
    "keyTakeaways": [
      "th represents /θ/ in these taught words.",
      "Follow /θ/ with /r/.",
      "Do not insert a vowel.",
      "Blend the whole word."
    ],
    "revisionPoints": [
      "three begins /θ/ /r/.",
      "th is a digraph.",
      "Three and tree begin with different sounds.",
      "Blend onset, vowel, and ending."
    ]
  },
