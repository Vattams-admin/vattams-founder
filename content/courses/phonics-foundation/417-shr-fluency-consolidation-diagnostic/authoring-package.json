    "workedExamples": [
      {
        "prompt": "Compare shrub and ship.",
        "solution": "Shrub includes /r/ after /ʃ/; ship does not."
      },
      {
        "prompt": "If a learner writes shrimp as shimp, what is missing?",
        "solution": "The /r/ sound."
      },
      {
        "prompt": "What follows a diagnostic showing weak blending?",
        "solution": "Targeted practice and fresh reassessment."
      }
    ],
