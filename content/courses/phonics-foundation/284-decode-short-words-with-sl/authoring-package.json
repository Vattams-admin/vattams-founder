  "studyMaterial": {
    "objectives": [
      "Decode taught sl-words by mapping graphemes from left to right.",
      "Blend the sl onset with the vowel and ending to read a complete word.",
      "Distinguish short-vowel words such as slap, slip, and slam.",
      "Reread and self-correct when a consonant or vowel is missed."
    ],
    "concepts": [
      "The letters s and l represent two consonants in the initial sl blend.",
      "The vowel and ending must also be decoded.",
      "Short vowels differ and must be heard precisely.",
      "Reading the whole word back checks the sound mapping."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode s-l-a-p.",
        "solution": "Map /s/ /l/ /æ/ /p/ and blend: slap."
      },
      {
        "prompt": "Decode s-l-i-p.",
        "solution": "Map /s/ /l/ /ɪ/ /p/ and blend: slip."
      },
      {
        "prompt": "Compare slap and slip.",
        "solution": "Both begin sl, but slap has short /a/ and slip has short /i/."
      }
    ],
    "commonMistakes": [
      "Reading only sl and guessing the rest.",
      "Confusing short /a/ in slap with short /i/ in slip.",
      "Dropping the final consonant.",
      "Omitting /l/ from the initial blend."
    ],
    "keyTakeaways": [
      "Map every sound from left to right.",
      "Keep both consonants in sl.",
      "Listen carefully to the vowel.",
      "Read the complete word again."
    ],
    "revisionPoints": [
      "slap maps to sl-a-p.",
      "slip maps to sl-i-p.",
      "slam maps to sl-a-m.",
      "Read the full word to check each sound."
    ]
  },
