    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "digraph",
        "definition": "Two letters that represent one sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode s-h-r-e-d.",
        "solution": "Map /ʃ/ /r/ then blend the vowel and ending to read shred."
      },
      {
        "prompt": "Compare shrub and scrub.",
        "solution": "Their onset sounds differ: /ʃr/ versus /skr/."
      },
      {
        "prompt": "If shrimp is read as shimp, what is missing?",
        "solution": "The /r/ sound."
      }
    ],
    "commonMistakes": [
