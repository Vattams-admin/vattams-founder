  "studyMaterial": {
    "objectives": [
      "Segment /d/ CVC words into phonemes.",
      "Map each phoneme to a grapheme.",
      "Spell taught CVC words containing /d/.",
      "Self-correct consonant and short-vowel spelling errors."
    ],
    "concepts": [
      "Encoding moves from spoken phonemes to written graphemes.",
      "Each CVC phoneme must be represented in sequence.",
      "Short-vowel accuracy changes the written word.",
      "Read-back helps confirm spelling."
    ],
    "definitions": [
      {
        "term": "encode",
        "definition": "Represent spoken sounds with written graphemes."
      },
      {
        "term": "segment",
        "definition": "Separate a spoken word into its individual phonemes."
      },
      {
        "term": "dictation",
        "definition": "Writing a word or sentence that is spoken aloud."
      }
    ],
    "workedExamples": [
      "Say dad → /d/ /a/ /d/ → d-a-d.",
      "Say did → /d/ /i/ /d/ → d-i-d.",
      "Say dug → /d/ /u/ /g/ → d-u-g."
    ],
    "commonMistakes": [
      "Writing t instead of d.",
      "Confusing short vowels.",
      "Leaving out the final consonant.",
      "Adding an extra letter."
    ],
    "keyTakeaways": [
      "Hear every phoneme.",
      "Write graphemes in order.",
      "Check the vowel.",
      "Read the spelling back."
    ],
    "revisionPoints": [
      "segment",
      "d → /d/",
      "short vowels",
      "CVC spelling",
      "read-back"
    ]
  },
  "practice": {
