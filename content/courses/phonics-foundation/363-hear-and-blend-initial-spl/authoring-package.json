  "studyMaterial": {
    "objectives": [
      "Hear /s/ followed by /p/ and /l/ in taught words.",
      "Blend all three consonants smoothly and in order.",
      "Distinguish spl from sp, sl, and spr onsets.",
      "Blend the onset with the rest of the word to identify the complete word."
    ],
    "concepts": [
      "The initial spl blend contains /s/ followed by /p/ and /l/.",
      "All three consonants remain audible in the onset.",
      "Do not insert a vowel between consonants.",
      "The full word confirms accurate blending."
    ],
    "definitions": [
      {
        "term": "initial blend",
        "definition": "Two or more consonant sounds heard together at the beginning of a word."
      },
      {
        "term": "phoneme",
        "definition": "A speech sound that can distinguish one word from another."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to splash.",
        "solution": "Hear /s/ then /p/ then /l/, followed by /æ/ and /ʃ/."
      },
      {
        "prompt": "Compare splash and slap.",
        "solution": "Splash begins spl; slap begins sl."
      },
      {
        "prompt": "Listen to split.",
        "solution": "Keep /s/, /p/, and /l/ in order before blending the rest."
      }
    ],
    "commonMistakes": [
      "Leaving out /p/ or /l/.",
      "Adding a vowel between consonants.",
      "Confusing spl with sl or sp.",
      "Guessing before blending the complete word."
    ],
    "keyTakeaways": [
      "spl begins with /s/ then /p/ then /l/.",
      "Do not insert an extra vowel.",
      "Keep all consonants in order.",
      "Blend and check the whole word."
    ],
    "revisionPoints": [
      "spl contains three consonant sounds.",
      "Splash, splat, and split begin with spl.",
      "Do not add a vowel within the onset.",
      "Listen to the complete word."
    ]
  },
