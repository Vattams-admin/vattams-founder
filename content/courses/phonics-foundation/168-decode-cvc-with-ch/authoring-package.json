  "studyMaterial": {
    "objectives": [
      "Decode controlled words containing initial or final ch.",
      "Map ch as one phoneme while blending left to right.",
      "Read chip, chat, chop, chin, much, rich and such accurately.",
      "Self-correct by checking the vowel and final grapheme."
    ],
    "concepts": [
      "The digraph ch is read as one phoneme in the taught words.",
      "Initial ch can combine with a short vowel and final consonant, as in chat.",
      "Final ch can complete a short word, as in much.",
      "Accurate decoding uses every grapheme and checks the vowel."
    ],
    "definitions": [
      {
        "term": "blend",
        "definition": "Combine phonemes in order to read a word."
      },
      {
        "term": "grapheme mapping",
        "definition": "Matching written letters or letter groups to sounds."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and fixing it using the printed word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "ch-i-p",
        "solution": "/ch/ /i/ /p/ blends to chip."
      },
      {
        "prompt": "ch-a-t",
        "solution": "/ch/ /a/ /t/ blends to chat."
      },
      {
        "prompt": "m-u-ch",
        "solution": "/m/ /u/ /ch/ blends to much."
      }
    ],
    "commonMistakes": [
      "Splitting ch into two phonemes.",
      "Reading chip as ship by overlooking the initial digraph.",
      "Changing the short vowel during blending.",
      "Guessing from the first letters and skipping the ending."
    ],
    "keyTakeaways": [
      "Keep ch together as one grapheme in taught words.",
      "Blend each phoneme from left to right.",
      "Check the short vowel and ending.",
      "Reread the whole word after blending."
    ],
    "revisionPoints": [
      "ch-i-p → chip.",
      "ch-a-t → chat.",
      "ch-o-p → chop.",
      "m-u-ch → much."
    ]
  },
