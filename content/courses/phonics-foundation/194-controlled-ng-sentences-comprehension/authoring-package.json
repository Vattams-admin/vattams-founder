  "studyMaterial": {
    "objectives": [
      "Read short controlled sentences containing taught ng-words.",
      "Answer literal questions using details stated in the sentence.",
      "Reread when a decoded word does not fit the meaning.",
      "Use text evidence rather than guessing."
    ],
    "concepts": [
      "A sentence expresses a complete idea.",
      "Accurate decoding supports understanding.",
      "Literal answers should match information directly stated in the text.",
      "Rereading helps readers check words and meaning."
    ],
    "definitions": [
      {
        "term": "literal comprehension",
        "definition": "Understanding information directly stated in a text."
      },
      {
        "term": "text evidence",
        "definition": "A word or detail in the text that supports an answer."
      },
      {
        "term": "rereading",
        "definition": "Reading the text again to check accuracy and meaning."
      }
    ],
    "workedExamples": [
      {
        "prompt": "I can sing a song.",
        "solution": "The sentence tells an action the speaker can do."
      },
      {
        "prompt": "The song is long.",
        "solution": "The sentence describes the song."
      },
      {
        "prompt": "We can bang a drum.",
        "solution": "The sentence gives another action."
      }
    ],
    "commonMistakes": [
      "Answering from memory without rereading.",
      "Confusing sing with sin because the final ng was missed.",
      "Skipping small words that change the sentence meaning.",
      "Reading accurately but not checking comprehension."
    ],
    "keyTakeaways": [
      "Decode each word before answering.",
      "Reread and point to the evidence.",
      "Check the final ng grapheme.",
      "Use the sentence, not a guess, to support an answer."
    ],
    "revisionPoints": [
      "I can sing a song.",
