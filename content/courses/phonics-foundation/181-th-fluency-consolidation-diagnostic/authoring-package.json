    "workedExamples": [
      {
        "prompt": "Recognise th in thin",
        "solution": "Identify the initial unvoiced /th/."
      },
      {
        "prompt": "Decode bath",
        "solution": "Map /b/ /a/ /th/ and blend."
      },
      {
        "prompt": "Spell path",
        "solution": "Segment /p/ /a/ /th/ and map the sounds."
      }
