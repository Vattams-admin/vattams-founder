    "definitions": [
      {
        "term": "phoneme",
        "definition": "A smallest contrastive sound unit in spoken language."
      },
      {
        "term": "initial sound",
        "definition": "The first phoneme heard in a word."
      },
      {
        "term": "grapheme",
        "definition": "A written symbol representing a phoneme."
      }
