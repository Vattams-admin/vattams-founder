  "studyMaterial": {
    "objectives": [
      "Hear the unvoiced /th/ sound in taught words such as thin, thick, bath and path.",
      "Recognise th as a two-letter grapheme representing one phoneme in the taught examples.",
      "Distinguish /th/ from /f/, /t/ and /s/ using listening contrasts.",
      "Say the sound gently without adding a vowel."
    ],
    "concepts": [
      "A digraph uses two letters to represent one phoneme.",
      "This lesson focuses on unvoiced /th/ as in thin and bath.",
      "The tongue is placed lightly between the teeth and air flows without voice.",
      "English th also has a voiced sound in other words; those examples will be taught separately."
    ],
    "definitions": [
      {
        "term": "digraph",
        "definition": "Two letters working together to represent one phoneme."
      },
      {
        "term": "unvoiced sound",
        "definition": "A sound made without vocal-fold vibration."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters used to represent a sound."
      }
    ],
    "workedExamples": [
      {
        "prompt": "thin",
        "solution": "The first sound is unvoiced /th/, represented by th."
      },
      {
        "prompt": "bath",
        "solution": "The final sound is unvoiced /th/."
      },
      {
        "prompt": "thin and fin",
        "solution": "The initial phoneme changes from /th/ to /f/."
      }
    ],
    "commonMistakes": [
      "Replacing /th/ with /f/ or /t/.",
      "Saying the letters as two separate sounds.",
      "Adding a vowel after /th/.",
      "Assuming this lesson covers every pronunciation of th."
    ],
    "keyTakeaways": [
      "th is two letters but one phoneme in taught words.",
      "Listen for unvoiced /th/ at the start and end.",
      "Compare thin with fin and bath with bat.",
      "Later lessons will distinguish the voiced th sound in words such as this."
    ],
    "revisionPoints": [
      "Initial unvoiced th: thin, thick.",
      "Final unvoiced th: bath, path, moth.",
      "th represents one phoneme in these taught words."
    ]
  },
