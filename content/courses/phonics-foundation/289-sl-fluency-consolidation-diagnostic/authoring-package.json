  "studyMaterial": {
    "objectives": [
      "Demonstrate recognition, decoding, spelling, word-family, sentence, and passage skills for the taught sl pattern.",
      "Complete a balanced 15-item diagnostic without access to answer keys.",
      "Use the score and item-level evidence to identify a specific reteaching need.",
      "Advance only at or above the 80% mastery threshold; otherwise complete targeted remediation."
    ],
    "concepts": [
      "A diagnostic checks taught skills rather than introducing new content.",
      "A 15-item score of 12 or more is at least 80%.",
      "Item-level errors identify which skill needs practice.",
      "A diagnostic answer key must remain private until the attempt is complete."
    ],
    "definitions": [
      {
        "term": "diagnostic",
        "definition": "A check used to identify current strengths and learning needs."
      },
      {
        "term": "mastery threshold",
        "definition": "The minimum score required to show readiness to advance."
      },
      {
        "term": "remediation",
        "definition": "Targeted instruction and practice for a diagnosed skill gap."
      }
    ],
    "workedExamples": [
      {
        "prompt": "A learner answers 12 of 15 items correctly. Has the learner met 80%?",
        "solution": "Yes. 12 ÷ 15 = 80%."
      },
      {
        "prompt": "A learner answers 10 of 15 correctly. What happens next?",
        "solution": "Use item-level evidence to choose targeted remediation and fresh reassessment."
      },
      {
        "prompt": "The learner misses only sl spelling items. What should be practised?",
        "solution": "Segment the sounds, spell both initial consonants, and read the word back."
      }
    ],
    "commonMistakes": [
      "Treating one total score as enough to diagnose the exact weakness.",
      "Advancing below the required 80% threshold.",
      "Repeating the same answers during reassessment.",
      "Revealing private answer keys before the attempt is complete."
    ],
    "keyTakeaways": [
      "Answer independently before reviewing feedback.",
      "12/15 is the 80% threshold.",
      "Use error patterns to select a focused skill target.",
      "Below 80%, complete remediation and a fresh reassessment."
    ],
    "revisionPoints": [
      "Diagnostic: 15 balanced items.",
      "Mastery: at least 12/15 (80%).",
      "Below threshold: targeted remediation plus fresh reassessment.",
      "Keep answer keys private during the attempt."
    ]
  },
