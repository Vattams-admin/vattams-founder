    "objectives": [
      "Decode taught ps-words accurately.",
      "Recognise that initial p is silent in the taught words.",
      "Distinguish ps-words from words where p is pronounced.",
      "Reread and self-correct when an extra sound is added."
    ],
    "concepts": [
      "In the taught initial ps-words, p is silent and s is pronounced first.",
      "The remaining sounds complete the word.",
      "Conventional spelling retains p.",
      "Rereading checks pronunciation and meaning."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "silent letter",
        "definition": "A written letter that is not pronounced."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode psalm.",
        "solution": "Begin with /s/; do not voice p."
      },
      {
        "prompt": "Decode psychic.",
        "solution": "Start with /s/ and blend the remaining sounds."
      },
      {
        "prompt": "If psychology is read with /p/ at the start, what should be corrected?",
        "solution": "Keep the initial p silent."
      }
    ],
    "commonMistakes": [
      "Pronouncing initial p.",
      "Deleting p from spelling.",
      "Changing the remaining sounds.",
      "Guessing from the first letters only."
    ],
    "keyTakeaways": [
      "Keep initial p silent in the taught ps-words.",
      "Begin with /s/.",
      "Retain p in spelling.",
      "Reread the complete word."
    ],
