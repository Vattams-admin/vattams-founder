  "studyMaterial": {
    "objectives": [
      "Segment taught sn-words into ordered phonemes before writing.",
      "Represent s and n in the initial onset in the correct order.",
      "Spell taught sn-words and read them back to check each grapheme.",
      "Repair omissions using sound-by-sound mapping."
    ],
    "concepts": [
      "Encoding maps spoken phonemes to written graphemes.",
      "The sn onset requires s then n.",
      "Read-back checks whether spelling matches the spoken word.",
      "An omitted consonant changes the word."
    ],
    "definitions": [
      {
        "term": "encode",
        "definition": "Write a word using sound-to-letter knowledge."
      },
      {
        "term": "segment",
        "definition": "Separate a spoken word into ordered sounds."
      },
      {
        "term": "read-back",
        "definition": "Read a written response to check it against the intended word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Spell snap.",
        "solution": "Segment /s/ /n/ /a/ /p/, write s-n-a-p, then read it back."
      },
      {
        "prompt": "A learner writes sip for snip. What is missing?",
        "solution": "The n after s."
      },
      {
        "prompt": "How can a learner check snack?",
        "solution": "Say each sound in order, write the graphemes, and read snack back."
      }
    ],
    "commonMistakes": [
      "Omitting n after s.",
      "Reversing the onset letters.",
      "Leaving out the final consonant.",
      "Not reading the written word back."
    ],
    "keyTakeaways": [
      "Hear all phonemes before writing.",
      "Write s then n at the start.",
      "Check the whole word.",
      "Repair the exact missing grapheme."
    ],
    "revisionPoints": [
      "Segment first, then write.",
      "Keep s and n in order.",
      "Spell snap, snip, snack, snail.",
      "Read the written word back."
    ]
  },
