    "mistakeBasedRevision": [
      "If the word is wrong, isolate the first phoneme and blend again."
    ],
    "weakTopicRevision": [
      "Practise the specific vowel or final consonant that caused the error."
    ]
  },
  "activities": [
    {
      "name": "Sound-slide blending",
      "steps": [
        "Point to w.",
        "Say /w/.",
        "Slide to the vowel and say it.",
        "Say the final consonant.",
        "Blend the three sounds.",
        "Reread the word."
      ]
    },
    {
      "name": "Initial-sound repair",
      "steps": [
        "Read the word.",
        "If it begins incorrectly, isolate /w/.",
        "Blend again from the start.",
        "Reread smoothly."
      ]
    }
  ],
