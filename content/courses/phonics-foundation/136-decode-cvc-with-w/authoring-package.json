  "studyMaterial": {
    "objectives": [
      "Blend /w/ with short vowels and taught final consonants.",
      "Decode simple CVC words beginning with w.",
      "Use left-to-right phoneme blending.",
      "Self-correct initial-sound errors and reread accurately."
    ],
    "concepts": [
      "CVC decoding combines three phonemes in sequence.",
      "Accurate decoding requires attending to every phoneme.",
      "Left-to-right blending supports stable word formation.",
      "Rereading confirms that the blended sounds form a word."
    ],
    "definitions": [
      {
        "term": "blending",
        "definition": "Combining individual phonemes smoothly to read a word."
      },
      {
        "term": "CVC",
        "definition": "A simple word pattern containing consonant, vowel, and consonant sounds."
      },
      {
        "term": "decode",
        "definition": "Use sound-letter knowledge to read an unfamiliar word."
      }
    ],
    "workedExamples": [
      "Blend /w/ /e/ /t/ to read wet.",
      "Blend /w/ /i/ /n/ to read win.",
      "Blend /w/ /a/ /g/ to read wag.",
      "Blend /w/ /i/ /g/ to read wig."
    ],
    "commonMistakes": [
      "Skipping the middle vowel.",
      "Replacing /w/ with /j/ or /r/.",
      "Guessing from a picture instead of blending.",
      "Stopping after separate sounds without joining them."
    ],
    "keyTakeaways": [
      "Start with /w/.",
      "Blend every sound left to right.",
      "Listen for the short vowel.",
      "Reread the whole word after blending."
    ],
    "revisionPoints": [
      "/w/ + short vowel + final consonant",
      "left-to-right blending",
      "initial-sound accuracy",
      "rereading"
    ]
  },
  "practice": {
    "basic": [
      "Blend simple w-initial CVC words."
    ],
    "conceptual": [
      "Identify the phoneme sequence in a w-initial CVC word."
    ],
    "application": [
      "Decode fresh CVC words using left-to-right blending."
    ],
    "higherOrderThinking": [
      "Explain how checking the first phoneme can repair a decoding error."
    ],
    "mixedReview": [
      "Mix w-initial CVC decoding with previously taught CVC patterns."
    ]
  },
  "revision": {
    "quickRevision": [
      "look → say each sound → blend → reread"
    ],
    "flashRecall": [
      "wag",
      "wet",
