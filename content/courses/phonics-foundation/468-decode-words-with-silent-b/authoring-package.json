  "studyMaterial": {
    "objectives": [
      "Decode debt and doubt using the taught silent-b pattern.",
      "Avoid adding /b/ to the spoken word.",
      "Distinguish the taught silent-b words from words with pronounced b.",
      "Reread and self-correct when an extra sound is added."
    ],
    "concepts": [
      "In the taught words debt and doubt, b is silent.",
      "The vowel and ending must still be decoded.",
      "Conventional spelling retains b.",
      "Rereading checks pronunciation and meaning."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "silent letter",
        "definition": "A written letter that is not pronounced."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode debt.",
        "solution": "Say /d/ /ɛ/ /t/ without adding /b/."
      },
      {
        "prompt": "Decode doubt.",
        "solution": "Say /d/ /aʊ/ /t/ without adding /b/."
      },
      {
        "prompt": "If debt is read as deb-t, what should be corrected?",
        "solution": "Do not pronounce b."
      }
    ],
    "commonMistakes": [
      "Adding /b/ while reading.",
      "Deleting b from spelling.",
      "Changing the vowel.",
      "Ignoring the final /t/."
    ],
    "keyTakeaways": [
      "Keep b silent in debt and doubt.",
      "Read the vowel and ending.",
      "Retain b in spelling.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "debt is read without /b/.",
      "doubt is read without /b/.",
      "Conventional spelling retains b.",
      "Reread to confirm pronunciation."
    ]
  },
