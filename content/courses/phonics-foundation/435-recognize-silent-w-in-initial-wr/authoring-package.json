  "studyMaterial": {
    "objectives": [
      "Recognise the silent initial w in taught wr-words such as wrap and wrist.",
      "Pronounce /r/ first in the spoken word.",
      "Distinguish wr-words from words beginning with /w/.",
      "Blend the vowel and ending to read the complete word."
    ],
    "concepts": [
      "In taught initial wr-words, w is silent and r is pronounced first.",
      "The vowel and ending complete the word.",
      "The spelling pattern differs from ordinary initial w words.",
      "Whole-word blending confirms the target word."
    ],
    "definitions": [
      {
        "term": "silent letter",
        "definition": "A letter present in spelling that is not pronounced."
      },
      {
        "term": "phoneme",
        "definition": "A speech sound that can distinguish one word from another."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to wrap.",
        "solution": "Say /r/ /æ/ /p/; do not voice w."
      },
      {
        "prompt": "Compare wrap and rap.",
        "solution": "Both begin /r/, but wrap uses the wr spelling."
      },
      {
        "prompt": "Listen to wrist.",
        "solution": "Begin with /r/ and blend the rest of the word."
      }
    ],
    "commonMistakes": [
      "Voicing w at the start.",
      "Leaving out /r/.",
      "Confusing wr with ordinary initial w.",
      "Ignoring the vowel or ending."
    ],
    "keyTakeaways": [
      "Initial w is silent in taught wr-words.",
      "r represents the first sound.",
      "Blend the vowel and ending.",
      "Read the complete word."
    ],
    "revisionPoints": [
      "wrap begins with /r/.",
      "wrist begins with /r/.",
      "The initial w is silent.",
      "Blend all pronounced sounds."
    ]
  },
