  "studyMaterial": {
    "objectives": [
      "Decode taught tr-words by mapping graphemes from left to right.",
      "Blend the tr onset with the vowel and ending to read a complete word.",
      "Distinguish short-vowel words such as trap, trip, and trot.",
      "Reread and self-correct when a consonant or vowel is missed."
    ],
    "concepts": [
      "The letters t and r represent two consonants in the initial tr blend.",
      "The vowel and ending must also be decoded.",
      "Short vowels differ and must be heard precisely.",
      "Reading the whole word back checks the sound mapping."
    ],
    "definitions": [
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel in a syllable."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode t-r-a-p.",
        "solution": "Map /t/ /r/ /æ/ /p/ and blend: trap."
      },
      {
        "prompt": "Decode t-r-i-p.",
        "solution": "Map /t/ /r/ /ɪ/ /p/ and blend: trip."
      },
      {
        "prompt": "Compare trap and trip.",
        "solution": "Both begin tr, but trap has short /a/ and trip has short /i/."
      }
    ],
    "commonMistakes": [
      "Reading only tr and guessing the rest.",
      "Confusing short /a/ in trap with short /i/ in trip.",
      "Dropping the final consonant.",
      "Omitting /r/ from the initial blend."
    ],
    "keyTakeaways": [
      "Map every sound from left to right.",
      "Keep both consonants in tr.",
      "Listen carefully to the vowel.",
      "Read the complete word again."
    ],
    "revisionPoints": [
      "trap maps to tr-a-p.",
      "trip maps to tr-i-p.",
      "trot maps to tr-o-t.",
      "Read the full word to check each sound."
    ]
  },
