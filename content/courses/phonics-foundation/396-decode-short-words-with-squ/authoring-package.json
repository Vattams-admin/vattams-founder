    "objectives": [
      "Decode taught squ-words from left to right.",
      "Recognise the squ spelling and its /s/ plus /kw/ sequence.",
      "Distinguish words such as squid, squat, and squish.",
      "Reread and self-correct when a sound is missed."
    ],
    "concepts": [
      "In the taught examples, squ represents /s/ plus /kw/.",
      "The q is followed by u in the spelling.",
      "The vowel and ending must also be decoded.",
      "Rereading the whole word checks sound mapping."
    ],
    "definitions": [
      {
        "term": "decode",
        "definition": "Use letter-sound knowledge to read a word."
      },
      {
        "term": "grapheme",
        "definition": "A letter or group of letters representing a sound."
      },
      {
        "term": "self-correction",
        "definition": "Noticing an error and repairing it by checking the word again."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Decode squid.",
        "solution": "Read squ as /s/ plus /kw/, then blend /ɪ/ and /d/."
      },
      {
        "prompt": "Compare squat and squid.",
        "solution": "Both begin squ; the vowel and ending differ."
      },
      {
        "prompt": "If squish is read as swish, what should be checked?",
        "solution": "The /k/ part of the /kw/ sequence."
      }
    ],
    "commonMistakes": [
      "Skipping the /k/ part of /kw/.",
      "Ignoring u after q.",
      "Changing the vowel.",
      "Guessing from the first letter only."
    ],
    "keyTakeaways": [
      "Read squ as /s/ plus /kw/ in this word set.",
      "Keep q followed by u.",
      "Check the vowel and ending.",
      "Reread the complete word."
    ],
    "revisionPoints": [
      "squid = squ + id.",
      "squat and squish also begin squ.",
      "The onset includes /s/ plus /kw/.",
      "Reread to confirm the whole word."
    ]
