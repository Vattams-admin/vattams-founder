  "studyMaterial": {
    "objectives": [
      "Recognise sh as /ʃ/ followed by r as /r/ in shr-words.",
      "Blend the two onset sounds smoothly without inserting a vowel.",
      "Distinguish shr from sh and str onsets.",
      "Blend the onset with the rest of the word to identify it."
    ],
    "concepts": [
      "In shr, sh represents /ʃ/ and r represents /r/.",
      "The onset has two sounds even though it uses three letters.",
      "Do not insert a vowel between the onset sounds.",
      "The whole word confirms accurate blending."
    ],
    "definitions": [
      {
        "term": "digraph",
        "definition": "Two letters that represent one sound."
      },
      {
        "term": "onset",
        "definition": "The consonant sound or blend before the vowel."
      },
      {
        "term": "blend",
        "definition": "Joining speech sounds in order to say a word."
      }
    ],
    "workedExamples": [
      {
        "prompt": "Listen to shrub.",
        "solution": "Hear /ʃ/ then /r/, followed by the vowel and ending."
      },
      {
        "prompt": "Compare shrub and stub.",
        "solution": "Shrub begins with /ʃr/; stub begins with /st/."
      },
      {
        "prompt": "Listen to shrimp.",
        "solution": "Keep /ʃ/ and /r/ in order before blending the rest."
      }
    ],
    "commonMistakes": [
      "Saying sh but omitting /r/.",
      "Adding a vowel between /ʃ/ and /r/.",
      "Confusing shr with str.",
      "Guessing before blending the complete word."
    ],
    "keyTakeaways": [
      "sh represents /ʃ/ and r represents /r/.",
      "shr has two onset sounds.",
      "Do not add a vowel between them.",
      "Blend and check the whole word."
    ],
    "revisionPoints": [
      "shr begins /ʃ/ followed by /r/.",
      "Shrub, shred, and shrimp begin with shr.",
      "The onset has two sounds.",
      "Read the complete word."
    ]
  },
