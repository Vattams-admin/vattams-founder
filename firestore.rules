    // ------------------------------------------------------------------

    match /competition_mock_configs/{courseId} {
      allow read: if isAdmin()
        || (isSignedIn() && hasActiveEnrolment(courseId));

      allow create, update, delete: if isAdmin();
    }

    match /competition_mock_attempts/{attemptId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && hasActiveEnrolment(request.resource.data.course_id);

      // Mock submission/scoring is performed by trusted backend.
      allow update, delete: if isAdmin();

      match /answers/{questionId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid);

        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid
          && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.status == 'in_progress'
          && request.resource.data.question_id == questionId;

        allow delete: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.status == 'in_progress');
      }
    }

    match /competition_mock_results/{resultId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    match /competition_results/{resultId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Competition launch-discount counters
    // Students may read the counter for checkout display only.
    // Only admins may create/update/delete counters and eligibility records.
    // The actual 50-slot decision is enforced inside the admin approval
    // transaction by claimCatalogLaunchSlotTx().
    // ------------------------------------------------------------------

    match /catalog_launch_counters/{courseKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_launch_eligibility/{eligibilityId} {
      allow read, write: if isAdmin();
    }

    // BOGO entitlements are created/consumed by the controlled backend.
    // Students cannot manufacture or modify their own free-course entitlement.
    match /bogo_entitlements/{entitlementId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.student_id == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
