            || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id))
          );

        allow delete: if isAdmin()
          || (isSignedIn() && userId == request.auth.uid);
