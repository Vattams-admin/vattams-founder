rules_version = '2';

// IMPORTANT — READ BEFORE DEPLOYING
// ----------------------------------------------------------------------
// This environment has no network access and no Firebase credentials, so
// the rules actually deployed on the live VATTAMS ACADEMIA Firebase
// project could not be fetched or diffed against this file. This file
// covers every collection the client app currently reads/writes:
// `tutors`, `students`, `admins`, `counters`, `courses`,
// `courses/{courseId}/materials`, `enrolments`, `course_modules`,
// `course_lessons`, `course_progress`, `live_sessions`, and
// `session_attendance`.
//
// NOT covered by this task's scope (`payments`, `certificates`,
// `notifications`) even though the app does read/write them
// (Payment.tsx, AdminPayments.tsx, StudentDashboard.tsx,
// AdminCertificates.tsx, VerifyCertificate.tsx) — this pass only
// touched the course-content/enrolment collections listed above.
// Deploying this file as-is will deny those three collections via the
// fallback rule below unless you merge in their existing live rules
// first.
//
// Before deploying: open Firebase Console → Firestore Database → Rules
// and diff what's currently deployed against this file.
// ----------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors src/lib/adminData.ts: admin authorization is the existence
    // of an active admins/{uid} doc with a recognized role. Firestore
    // rules can't call into app code, so the same check is duplicated
    // here against the same collection/field names.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.is_active == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'instructor'];
    }

    // Fields an onboarded identity must never be able to change on its
    // own document — only the onboarding transaction (run by an admin
    // client, see src/lib/onboarding.ts) or another admin action may
    // touch these.
    function tutorIdentityFieldsUnchanged() {
      return request.resource.data.employee_code == resource.data.employee_code &&
        request.resource.data.tutor_id == resource.data.tutor_id &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.onboarding_status == resource.data.onboarding_status;
    }

    // Tutor approval requires the deterministic ₹500 registration
    // payment to be approved first.
    function tutorRegistrationPaymentVerified(tutorId) {
      return exists(/databases/$(database)/documents/payments/$('tutor_registration_' + tutorId)) &&
        get(/databases/$(database)/documents/payments/$('tutor_registration_' + tutorId)).data.status == 'approved';
    }

    function tutorApprovalGateOk(tutorId) {
      return request.resource.data.status != 'approved' ||
        tutorRegistrationPaymentVerified(tutorId);
    }

    function onboardingDocIdentityFieldsUnchanged() {
      return request.resource.data.tutor_id == resource.data.tutor_id &&
        request.resource.data.document_type == resource.data.document_type;
    }

    function studentIdentityFieldsUnchanged() {
      return request.resource.data.student_code == resource.data.student_code &&
        request.resource.data.student_id == resource.data.student_id &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.onboarding_status == resource.data.onboarding_status;
    }

    match /tutors/{tutorId} {
      // A tutor can read their own onboarding info, ID card, and
      // onboarding letter data; an admin can read any tutor.
      allow read: if isOwner(tutorId) || isAdmin();

      // Registration (TutorRegister.tsx) creates the doc with the
      // signed-in user's own uid as the doc ID.
      allow create: if isOwner(tutorId)
        && request.resource.data.status == 'pending_approval'
        && !('employee_code' in request.resource.data)
        && !('tutor_id' in request.resource.data)
        && !('onboarding_status' in request.resource.data);

      // A tutor may update their own profile fields, but never their
      // Employee Code, Tutor ID, approval status, or onboarding status.
      allow update: if (isOwner(tutorId) && tutorIdentityFieldsUnchanged())
        || (isAdmin() && tutorApprovalGateOk(tutorId));

      allow delete: if false;
    }

    // Tutor onboarding documents: metadata only. Actual files are stored
    // privately in Supabase Storage.
    match /tutors/{tutorId}/onboarding_documents/{documentId} {
      allow read: if isOwner(tutorId) || isAdmin();

      allow create: if isOwner(tutorId)
        && documentId == request.resource.data.document_type
        && request.resource.data.tutor_id == tutorId
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewed_at == null
        && request.resource.data.reviewed_by == null
        && request.resource.data.rejection_reason == null;

      allow update: if (
        isOwner(tutorId)
        && onboardingDocIdentityFieldsUnchanged()
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewed_at == null
        && request.resource.data.reviewed_by == null
        && request.resource.data.rejection_reason == null
      ) || (
        isAdmin()
        && onboardingDocIdentityFieldsUnchanged()
        && request.resource.data.status in ['verified', 'rejected']
      );

      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if isOwner(studentId) || isAdmin();
      allow create: if isOwner(studentId);
      allow update: if (isOwner(studentId) && studentIdentityFieldsUnchanged()) || isAdmin();
      allow delete: if false;
    }

    match /admins/{adminId} {
      // Admin documents are created by hand in the Firebase Console (see
      // src/lib/adminData.ts) — never through the app. A signed-in admin
      // may read their own record (used by useAdminAuth); nothing may
      // write to this collection from a client.
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    match /counters/{counterId} {
      // Only used by the onboarding transaction (src/lib/onboarding.ts),
      // which always runs from an authenticated admin session.
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Phase 19 — Live Sessions
    // ------------------------------------------------------------------
    // NOT independently verified against a live Firebase project (same
    // no-network-access caveat as the top of this file) — run these
    // through the Firebase Console Rules Playground before deploying.

    function isApprovedTutor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/tutors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.status == 'approved';
    }

    // enrolments/{studentId}_{courseId} is the deterministic id already
    // used by src/pages/admin/AdminPayments.tsx. Firestore rules cannot
    // run `where` queries, so real server-side enrolment checks are only
    // possible because that id is deterministic — reading it directly by
    // path is what makes this a genuine authorization check rather than
    // just a client-side courtesy message (spec: "Never rely only on
    // hiding the Join button").
    function hasActiveEnrolment(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + courseId)) &&
        get(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + courseId)).data.status == 'active';
    }

    // ------------------------------------------------------------------
    // Approved commercial model (see src/lib/coursePricing.ts) —
    // mirrored here in rules language so a client can never write a
    // payment `amount` other than one this model actually allows,
    // regardless of what Payment.tsx computed on the way in. Every
    // helper below uses `.get(field, default)` (Firestore rules' safe
    // map accessor) so the 55+ existing course documents that predate
    // these fields never throw — they fall back to auto-classification,
    // exactly like resolveEffectivePricingMode() does in application code.
    function pricingSettings() {
      return get(/databases/$(database)/documents/settings/pricing).data;
    }

    function resolvedPricingMode(course) {
      let explicit = course.get('pricing_mode', null);
      return explicit == 'legacy' ? 'legacy'
        : explicit == 'monthly_group' ? 'monthly_group'
        : explicit == 'one_to_one' ? 'one_to_one'
        : explicit == 'special_offer' ? 'special_offer'
        : explicit == 'school_tuition' ? 'school_tuition'
        : (course.get('is_competition', false) == true ? 'competition_entry'
           : (course.get('is_free', false) == true ? 'free' : 'monthly_group'));
    }

    function legacyAmount(course) {
      return course.base_fee - course.discount_amount > 0 ? course.base_fee - course.discount_amount : 0;
    }

    function effectiveMonthlyGroupFee(course) {
      let override = course.get('monthly_fee_override', null);
      return override != null ? override : pricingSettings().get('monthlyGroupFeePerStudent', 10000);
    }

    function effectiveOneToOneFee(course) {
      let override = course.get('monthly_fee_override', null);
      return override != null ? override : pricingSettings().get('oneToOneMonthlyFee', 14000);
    }

      function effectiveCatalogCourseAmounts(course) {
        let catalogCourses = pricingSettings().get('catalogCourses', {});
        let plans = catalogCourses.get('plans', {});
        let categoryId = course.get('category_id', null);
        let courseName = course.get('name', '');
        let key = categoryId != null ? categoryId + ':' + courseName : '';
        let plan = plans.get(key, {});
        let regularPrice = plan.get('regularPrice', 0);
        let discountPercent = plan.get('launchDiscountPercent', 0);
        let launchPrice = math.round(regularPrice * (1 - discountPercent / 100.0));
        return [regularPrice, launchPrice];
      }

    // Returns [offerPrice, regularPrice] — a create is accepted at
    // EITHER value; which one is actually correct for this student
    // (first-30 cap, 3-month window) is enforced authoritatively at
    // admin-approval time (src/lib/specialOfferEligibility.ts), not
    // here — rules only have the course + global-settings documents to
    // work with, not a per-student eligibility lookup budget large
    // enough to fully replicate that. This is a documented, deliberate
    // scope boundary (see the pass's final report), not an oversight.
    function effectiveSpecialOfferAmounts(course) {
      let offers = pricingSettings().get('specialOffers', {});
      let key = course.get('special_offer_key', 'phonics');
      let offer = key == 'english_abacus' ? offers.get('englishAbacus', {}) : offers.get('phonics', {});
      return [offer.get('offerPrice', 0), offer.get('regularPrice', 0)];
    }

    function effectiveSchoolTuitionAmounts(course) {
      let schoolTuition = pricingSettings().get('schoolTuition', {});
      let plans = schoolTuition.get('plans', {});
      let board = course.get('tuition_board', null);
      let session = course.get('tuition_session', null);
      let classBand = course.get('tuition_class_band', null);
      let planKey = board + '_' + session + '_' + classBand;
      let plan = plans.get(planKey, {});
      let regularPrice = plan.get('regularPrice', 0);
      let discountPercent = plan.get('launchDiscountPercent', 50);
      let launchPrice = math.round(regularPrice * (1 - discountPercent / 100.0));
      return [regularPrice, launchPrice];
    }

  // A signed-in student's own Phonics free-competition-entry waiver,
  // if any — lets a competition-entry payment legitimately be ₹0
  // exactly once per student. Never trusts the client for whether
  // the waiver applies; re-reads the student's own eligibility doc.
  function hasUnusedFreeCompetitionEntry() {
    let path = /databases/$(database)/documents/special_offer_eligibility/$('phonics_' + request.auth.uid);
      return exists(path)
        && get(path).data.get('free_competition_entry', false) == true
        && get(path).data.get('free_competition_entry_used', false) == false;
    }

    function paymentMatchesCourse(courseId, amount, courseName) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      let mode = resolvedPricingMode(course);
      return course.is_published == true &&
        courseName == course.name &&
        (
          (mode == 'competition_entry' && (amount == legacyAmount(course) || amount in effectiveCatalogCourseAmounts(course) || (amount == 0 && hasUnusedFreeCompetitionEntry()))) ||
          (mode == 'legacy' && amount == legacyAmount(course)) ||
          (mode == 'free' && amount == 0) ||
          (mode == 'monthly_group' && (
        amount == effectiveMonthlyGroupFee(course) ||
        amount in effectiveCatalogCourseAmounts(course)
      )) ||
          (mode == 'one_to_one' && amount == effectiveOneToOneFee(course)) ||
          (mode == 'special_offer' && amount in effectiveSpecialOfferAmounts(course)) ||
          (mode == 'school_tuition' && amount in effectiveSchoolTuitionAmounts(course))
        );
    }



    // Courses (courses/{courseId}) — the catalog document itself had no
    // explicit rule anywhere in this file, so it fell through to the
    // deny-all catch-all. Admin gets full CRUD; everyone else (including
    // signed-out visitors) can only read published rows — matches
    // AdminCourses.tsx (admin lists all, no `where` filter) vs.
    // Courses.tsx / CourseDetail.tsx / Home.tsx (public,
    // `is_published == true`).
    // ------------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.is_published == true;
      allow create, update, delete: if isAdmin();
    }

    // Admin-configurable pricing/revenue-share settings singleton —
    // see src/lib/pricingConfig.ts. Public read (same trust level as a
    // published course's price: anyone can already see what a course
    // costs) so a future pricing/checkout page can compute the same
    // numbers the admin panel shows; only an admin may change it.
    match /settings/pricing {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Group-batch capacity (src/lib/groupBatches.ts) and special-offer
    // eligibility (src/lib/specialOfferEligibility.ts) records. All
    // writes happen exclusively from AdminPayments.tsx's approval
    // transaction (an admin-authenticated context) — students never
    // write these directly, matching the existing `enrolments`
    // admin-only-write pattern above. Students may read their OWN
    // membership/eligibility doc for transparency (e.g. a future "your
    // plan" panel on the student dashboard).
    // ------------------------------------------------------------------
    match /course_batches/{batchId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /course_batch_pointers/{courseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /course_batch_members/{memberId} {
      allow read: if isAdmin() || isOwner(resource.data.student_id);
      allow write: if isAdmin();
    }

    match /special_offer_counters/{offerKey} {
      // Bug fix (this pass): peekOfferAvailability() in
      // src/lib/specialOfferEligibility.ts is called from Payment.tsx —
      // a STUDENT-facing checkout page — to show whether offer slots
      // remain BEFORE that student has an eligibility record yet.
      // Admin-only read made that call fail with permission-denied for
      // every first-time visitor to a special-offer course, breaking
      // checkout entirely. The doc only exposes a claimed-count integer
      // (no PII), same trust level as settings/pricing above, so public
      // read is safe. Writes still only ever happen from
      // AdminPayments.tsx's approval transaction (admin-authenticated).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /special_offer_eligibility/{eligibilityId} {
      // Bug fix (this pass): `resource` is null for a document that
      // doesn't exist yet — the overwhelmingly common case here, since
      // most students never join a special offer. Evaluating
      // `resource.data.student_id` in that case is a rules-engine error,
      // which Firestore treats as DENIED — so before this fix, a
      // getDoc() by a signed-in student on their own (nonexistent)
      // eligibility doc failed with permission-denied instead of just
      // returning "not found". That call happens unconditionally for
      // EVERY competition-entry payment (Payment.tsx checks the
      // student's Phonics record for the free-entry waiver) and for
      // every special-offer course checkout — so this bug broke
      // checkout broadly, not just for Phonics students. The
      // `resource != null &&` guard short-circuits before the unsafe
      // property access.
      allow read: if isAdmin()
        || (isSignedIn() && (
          eligibilityId == ('phonics_' + request.auth.uid)
          || eligibilityId == ('english_abacus_' + request.auth.uid)
        ));
      allow write: if isAdmin()
        // Narrow self-service exception: a student may flip their OWN
        // one-time free-competition-entry waiver from unused to used —
        // and only that single field, only false -> true. This is what
        // lets Payment.tsx zero out a competition-entry payment exactly
        // once without needing an admin round-trip, while the write
        // itself still can't touch months_used/active/claimed counts.
        || (
          isOwner(resource.data.student_id)
          && resource.data.get('free_competition_entry_used', false) == false
          && request.resource.data.free_competition_entry_used == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['free_competition_entry_used'])
        );
    }

    // Tutor payout ledger (src/lib/tutorEarnings.ts) — written only as
    // part of an admin's payment-approval transaction. A tutor may read
    // their own accrued-earnings records; nothing here lets a tutor (or
    // student) edit or fabricate one.
    match /tutor_earnings/{earningId} {
      allow read: if isAdmin() || isOwner(resource.data.tutor_id);
      allow write: if isAdmin();
    }

    // Learning Materials (courses/{courseId}/materials/{materialId}) —
    // see src/lib/materials.ts. Supabase Storage now holds the actual file
    // bytes; this Firestore rule gates the material metadata itself, so
    // students only discover a material's storage_path (used to request
    // a signed download URL) after an active-enrolment + published check,
    // while admins can manage all material records regardless of publish
    // state.
    match /courses/{courseId}/materials/{materialId} {
      allow read: if isAdmin()
        || (hasActiveEnrolment(courseId) && resource.data.is_published == true);

      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // course_modules / course_lessons / course_progress / enrolments —
    // previously entirely unmatched (fell through to the deny-all
    // catch-all), which is what CourseLearn.tsx's "No access yet" /
    // "Unable to connect" states were actually hitting even for a
    // correctly-enrolled student once the collection name mismatch
    // (course_enrolments → enrolments) was fixed on the client. Added
    // now so the client fix is actually reachable.
    // ------------------------------------------------------------------
    match /enrolments/{enrolmentId} {
      // Doc id convention: `${student_id}_${course_id}` (see
      // AdminPayments.tsx / hasActiveEnrolment() above). A student may
      // read only their own; nothing about enrolment status/course
      // assignment is student-writable — that's exclusively the
      // admin-verified payment approval flow.
      allow read: if isAdmin() || isOwner(resource.data.student_id);
      allow create, update, delete: if isAdmin();
    }

    match /course_modules/{moduleId} {
      allow read: if isAdmin() || hasActiveEnrolment(resource.data.course_id);
      allow create, update, delete: if isAdmin();
    }

    match /course_lessons/{lessonId} {
      allow read: if isAdmin() || hasActiveEnrolment(resource.data.course_id);
      allow create, update, delete: if isAdmin();
    }

    match /course_progress/{progressId} {
      // Doc id convention: `${enrolmentId}_${lessonId}` (CourseLearn.tsx
      // markComplete()). A student may only read/write their own
      // progress, and only for a course they are actively enrolled in —
      // both checks are required so a student can't fabricate progress
      // against an enrolment id that isn't theirs, isn't active, or
      // isn't for the course the lesson actually belongs to isn't
      // separately re-derived here (lesson_id is opaque to this rule);
      // the enrolment_id ownership + active-status check is what the
      // spec's fabricated-enrolment test case requires.
      allow read: if isAdmin() || isOwner(resource.data.student_id);

      allow create, update: if isAdmin()
        || (
          isOwner(request.resource.data.student_id)
          && progressId == request.resource.data.enrolment_id + '_' + request.resource.data.lesson_id
          && get(/databases/$(database)/documents/enrolments/$(request.resource.data.enrolment_id)).data.student_id == request.auth.uid
          && get(/databases/$(database)/documents/enrolments/$(request.resource.data.enrolment_id)).data.status == 'active'
        );

      allow delete: if isAdmin();
    }

    match /live_sessions/{sessionId} {
      // A student can only read a PUBLISHED session for a course they
      // are actively enrolled in — a draft is invisible to students
      // regardless of the sessionId they try, and a session for a
      // course they never paid for/enrolled in is invisible even with
      // the exact right sessionId (blocks the "change sessionId /
      // courseId in the URL" IDOR case called out in the spec).
      allow read: if isAdmin()
        || (isApprovedTutor() && resource.data.tutor_id == request.auth.uid)
        || (resource.data.status == 'published' && hasActiveEnrolment(resource.data.course_id));

      allow create: if isAdmin()
        || (isApprovedTutor() && request.resource.data.tutor_id == request.auth.uid);

      // A tutor may update only a session they own, and may not
      // reassign it to a different tutor or course out from under
      // themselves.
      allow update: if isAdmin()
        || (isApprovedTutor()
            && resource.data.tutor_id == request.auth.uid
            && request.resource.data.tutor_id == resource.data.tutor_id
            && request.resource.data.course_id == resource.data.course_id
            && request.resource.data.created_by == resource.data.created_by
            && request.resource.data.created_at == resource.data.created_at
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'topic', 'description', 'batch_label', 'start_time', 'end_time',
              'meeting_provider', 'meeting_url', 'recording_url', 'session_notes',
              'materials', 'status', 'cancelled_reason', 'cancelled_at',
              'reschedule_history', 'updated_at'
            ])
            && (!('meeting_url' in request.resource.data) || request.resource.data.meeting_url == null || request.resource.data.meeting_url.matches('^https?://[^\\s]+$'))
            && (!('recording_url' in request.resource.data) || request.resource.data.recording_url == null || request.resource.data.recording_url.matches('^https?://[^\\s]+$')))
      allow delete: if isAdmin();
    }

    match /session_attendance/{attendanceId} {
      // Doc id convention: `${session_id}_${student_id}` (mirrors
      // enrolments' `${student_id}_${course_id}` pattern).
      allow read: if isAdmin()
        || isOwner(resource.data.student_id)
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(resource.data.session_id)).data.tutor_id == request.auth.uid);

      // A student may create ONLY their own self-reported join record,
      // for a session they're actually enrolled in and that is
      // currently published — never a status other than 'present' and
      // never a source other than 'self_reported' (a tutor/admin
      // override always goes through the branches below instead).
      allow create: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(request.resource.data.session_id)).data.tutor_id == request.auth.uid)
        || (
          isOwner(request.resource.data.student_id)
          && attendanceId == request.resource.data.session_id + '_' + request.auth.uid
          && request.resource.data.source == 'self_reported'
          && request.resource.data.status == 'present'
          && hasActiveEnrolment(request.resource.data.course_id)
          && get(/databases/$(database)/documents/live_sessions/$(request.resource.data.session_id)).data.status == 'published'
        );

      // Updates: a student may only ever touch their own `joined_at` on
      // their own self-reported row (repeated join clicks); everything
      // else (status corrections, marking other students) is a
      // tutor/admin action.
      allow update: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(resource.data.session_id)).data.tutor_id == request.auth.uid)
        || (
          isOwner(resource.data.student_id)
          && resource.data.source == 'self_reported'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined_at'])
        );

      allow delete: if isAdmin();
    }

    // Everything else (payments, certificates, notifications, ...) is
    // intentionally NOT covered here — see the warning at the top of
    // this file. Merge in your existing rules for those collections
    // before deploying.
    match /payments/{paymentId} {
      // A student reads only their own payments (StudentDashboard.tsx);
      // an admin reads all (AdminPayments.tsx).
      allow read: if isAdmin()
        || (isSignedIn() && (
          resource.data.student_id == request.auth.uid
          || resource.data.tutor_id == request.auth.uid
        ));

      // Tutor registration payments are deterministic: one payment document
      // per tutor, always exactly ₹500.
      allow create: if isSignedIn()
        && paymentId == ('tutor_registration_' + request.auth.uid)
        && request.resource.data.payment_type == 'tutor_registration'
        && request.resource.data.tutor_id == request.auth.uid
        && request.resource.data.tutor_name is string
        && request.resource.data.student_id == null
        && request.resource.data.course_id == null
        && request.resource.data.course_name == null
        && request.resource.data.amount == 500
        && request.resource.data.status == 'pending'
        && request.resource.data.verified_at == null
        && request.resource.data.verified_by == null
        && request.resource.data.keys().hasAll([
          'payment_type',
          'tutor_id',
          'tutor_name',
          'student_id',
          'course_id',
          'course_name',
          'amount',
          'status',
          'verified_at',
          'verified_by',
          'utr_reference',
          'submitted_at',
          'created_at'
        ]);

      // A tutor may only submit their own pending registration payment.
      // Admins retain the existing verification authority below.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.payment_type == 'tutor_registration'
        && resource.data.tutor_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      ) || (
        isSignedIn()
        && resource.data.payment_type != 'tutor_registration'
        && resource.data.student_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      );

      // Payment.tsx creates its own pending payment doc from
      // course.base_fee/discount_amount it just read from Firestore —
      // but a client calling the SDK directly isn't bound by what the
      // UI actually read, so `amount` and `course_name` are re-derived
      // here from the *server's* course document, not trusted from the
      // request. A forged amount (or a course_id pointing at an
      // unpublished/nonexistent course) is rejected outright.
      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verified_at == null
        && request.resource.data.verified_by == null
        && request.resource.data.course_id is string
        && paymentMatchesCourse(request.resource.data.course_id, request.resource.data.amount, request.resource.data.course_name);

      // Update: either (a) the owning student submitting their UTR —
      // only utr_reference/status/submitted_at may change, and status
      // may only move to 'submitted' — or (b) an admin verifying
      // (approve/reject), which AdminPayments.tsx does alongside the
      // enrolment write below.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.student_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      );

      allow delete: if false;
    }


    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if isAdmin() || request.query.limit <= 1;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /push_tokens/{tokenId} {
      // FCM registration tokens are private to the signed-in user.
      // The token document ID must match the token field and the owner UID.
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId;

      allow read, delete: if false;
    }

    match /notifications/{notificationId} {
      function isOwnNotification() {
        return isSignedIn() && resource.data.recipient_uid == request.auth.uid;
      }
      function isAdminBroadcast() {
        return resource.data.recipient_uid == null && resource.data.recipient_role == 'admin';
      }
      function isTutorBroadcast() {
        return resource.data.recipient_uid == null && resource.data.recipient_role == 'tutor';
      }

      allow read: if isOwnNotification()
        || (isAdminBroadcast() && isAdmin())
        || (isTutorBroadcast() && isApprovedTutor());

      allow create: if isSignedIn() && request.resource.data.is_read == false
        && request.resource.data.keys().hasAll(['recipient_uid','recipient_role','type','title','message','is_read','created_at'])
        && (
          isAdmin()
          || (request.resource.data.recipient_uid == request.auth.uid
              && request.resource.data.type == 'registration_success')
          || (request.resource.data.recipient_uid == null
              && request.resource.data.recipient_role == 'admin'
              && request.resource.data.type in ['new_student_registration', 'new_enrollment', 'tutor_activity', 'payment_received'])
          || (request.resource.data.recipient_uid == request.auth.uid
              && request.resource.data.recipient_role == 'tutor'
              && request.resource.data.type == 'tutor_payment_status')
        );

      allow update: if (isOwnNotification() || (isAdminBroadcast() && isAdmin()) || (isTutorBroadcast() && isApprovedTutor()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);

      allow delete: if false;
    }

    match /live_rooms/{sessionId} {
      // Room state belongs to an existing published live session.
      // Students may only read rooms for courses they are actively enrolled in.
      allow read: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
        || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
            && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

      // Only Admin or the tutor assigned to this session may create/update room state.
      allow create: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);

      allow update: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);

      allow delete: if isAdmin();

      match /connections/{studentId} {
          // Only the assigned tutor and owning student may read signaling state.
          allow read: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (isSignedIn()
                && studentId == request.auth.uid
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

          // Student creates the initial offer connection.
          allow create: if isAdmin()
            || (isSignedIn()
                && studentId == request.auth.uid
                && request.resource.data.student_id == request.auth.uid
                && request.resource.data.tutor_id == get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id
                && request.resource.data.offer is string
                && request.resource.data.answer == null
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

          // Only the assigned tutor may write the answer.
          // Connection identity and the original offer cannot be changed.
          allow update: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid
                && request.resource.data.student_id == resource.data.student_id
                && request.resource.data.tutor_id == resource.data.tutor_id
                && request.resource.data.offer == resource.data.offer
                && request.resource.data.answer is string);

          allow delete: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (isSignedIn() && studentId == request.auth.uid);

          match /student_ice/{candidateId} {
            allow read: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
              || (isSignedIn() && studentId == request.auth.uid);

            // Student may only append their own ICE candidates.
            allow create: if isAdmin()
              || (isSignedIn()
                  && studentId == request.auth.uid
                  && request.resource.data.from_user_id == request.auth.uid
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                  && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

            allow update: if false;

            allow delete: if isAdmin()
              || (isSignedIn() && studentId == request.auth.uid);
          }

          match /tutor_ice/{candidateId} {
            allow read: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
              || (isSignedIn() && studentId == request.auth.uid);

            // Only the assigned tutor may append tutor ICE candidates.
            allow create: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid
                  && request.resource.data.from_user_id == request.auth.uid);

            allow update: if false;

            allow delete: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);
          }
        }

        match /participants/{userId} {
        // Room participants are visible only to authorized room members.
        allow read: if isAdmin()
          || (isApprovedTutor()
              && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
          || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
              && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

        // A participant may create/update only their own presence document.
        allow create, update: if isSignedIn()
          && userId == request.auth.uid
          && (
            isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id))
          );

        allow delete: if isAdmin()
          || (isSignedIn() && userId == request.auth.uid);
      }
    }

    // ------------------------------------------------------------------
    // Competition system
    // Students must have an active enrolment in the competition course.
    // Answer keys remain server-side only.
    // ------------------------------------------------------------------

    match /competition_questions/{questionId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.is_published == true
            && hasActiveEnrolment(resource.data.course_id));

      allow create, update, delete: if isAdmin();
    }

    match /competition_question_indexes/{courseId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && hasActiveEnrolment(courseId));

      allow create, update, delete: if isAdmin();
    }

    match /competition_answer_keys/{questionId} {
      allow read, write: if isAdmin();
    }

    match /competition_attempts/{attemptId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.course_id != 'DNWt3cPE4ZSJG90CTC1e'
        && hasActiveEnrolment(request.resource.data.course_id);

      // Student attempts are locked after creation.
      // Submission/scoring is performed by the trusted backend.
      allow update, delete: if isAdmin();

      match /answers/{questionId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.student_id == request.auth.uid);

        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.student_id == request.auth.uid
          && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.status == 'in_progress'
          && request.resource.data.question_id == questionId;

        allow delete: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.student_id == request.auth.uid
              && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.status == 'in_progress');
      }
    }

    // ------------------------------------------------------------------
    // Competition Mock Test system
    // Separate from official competition attempts/results.
    // Mock tests are practice only and never count as official attempts.
    // ------------------------------------------------------------------

    match /competition_mock_configs/{courseId} {
      allow read: if isAdmin()
        || (isSignedIn() && hasActiveEnrolment(courseId));

      allow create, update, delete: if isAdmin();
    }

    match /competition_mock_attempts/{attemptId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && hasActiveEnrolment(request.resource.data.course_id);

      // Mock submission/scoring is performed by trusted backend.
      allow update, delete: if isAdmin();

      match /answers/{questionId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid);

        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid
          && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.status == 'in_progress'
          && request.resource.data.question_id == questionId;

        allow delete: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.status == 'in_progress');
      }
    }

    match /competition_mock_results/{resultId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    match /competition_results/{resultId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Competition launch-discount counters
    // Students may read the counter for checkout display only.
    // Only admins may create/update/delete counters and eligibility records.
    // The actual 50-slot decision is enforced inside the admin approval
    // transaction by claimCatalogLaunchSlotTx().
    // ------------------------------------------------------------------

    match /catalog_launch_counters/{courseKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_launch_eligibility/{eligibilityId} {
      allow read, write: if isAdmin();
    }

    // BOGO entitlements are created/consumed by the controlled backend.
    // Students cannot manufacture or modify their own free-course entitlement.
    match /bogo_entitlements/{entitlementId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.student_id == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
))
            && (!('recording_url' in request.resource.data) || request.resource.data.recording_url == null || request.resource.data.recording_url.matches('^https?://[^\\s]+

      allow delete: if isAdmin();
    }

    match /session_attendance/{attendanceId} {
      // Doc id convention: `${session_id}_${student_id}` (mirrors
      // enrolments' `${student_id}_${course_id}` pattern).
      allow read: if isAdmin()
        || isOwner(resource.data.student_id)
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(resource.data.session_id)).data.tutor_id == request.auth.uid);

      // A student may create ONLY their own self-reported join record,
      // for a session they're actually enrolled in and that is
      // currently published — never a status other than 'present' and
      // never a source other than 'self_reported' (a tutor/admin
      // override always goes through the branches below instead).
      allow create: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(request.resource.data.session_id)).data.tutor_id == request.auth.uid)
        || (
          isOwner(request.resource.data.student_id)
          && attendanceId == request.resource.data.session_id + '_' + request.auth.uid
          && request.resource.data.source == 'self_reported'
          && request.resource.data.status == 'present'
          && hasActiveEnrolment(request.resource.data.course_id)
          && get(/databases/$(database)/documents/live_sessions/$(request.resource.data.session_id)).data.status == 'published'
        );

      // Updates: a student may only ever touch their own `joined_at` on
      // their own self-reported row (repeated join clicks); everything
      // else (status corrections, marking other students) is a
      // tutor/admin action.
      allow update: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(resource.data.session_id)).data.tutor_id == request.auth.uid)
        || (
          isOwner(resource.data.student_id)
          && resource.data.source == 'self_reported'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined_at'])
        );

      allow delete: if isAdmin();
    }

    // Everything else (payments, certificates, notifications, ...) is
    // intentionally NOT covered here — see the warning at the top of
    // this file. Merge in your existing rules for those collections
    // before deploying.
    match /payments/{paymentId} {
      // A student reads only their own payments (StudentDashboard.tsx);
      // an admin reads all (AdminPayments.tsx).
      allow read: if isAdmin()
        || (isSignedIn() && (
          resource.data.student_id == request.auth.uid
          || resource.data.tutor_id == request.auth.uid
        ));

      // Tutor registration payments are deterministic: one payment document
      // per tutor, always exactly ₹500.
      allow create: if isSignedIn()
        && paymentId == ('tutor_registration_' + request.auth.uid)
        && request.resource.data.payment_type == 'tutor_registration'
        && request.resource.data.tutor_id == request.auth.uid
        && request.resource.data.tutor_name is string
        && request.resource.data.student_id == null
        && request.resource.data.course_id == null
        && request.resource.data.course_name == null
        && request.resource.data.amount == 500
        && request.resource.data.status == 'pending'
        && request.resource.data.verified_at == null
        && request.resource.data.verified_by == null
        && request.resource.data.keys().hasAll([
          'payment_type',
          'tutor_id',
          'tutor_name',
          'student_id',
          'course_id',
          'course_name',
          'amount',
          'status',
          'verified_at',
          'verified_by',
          'utr_reference',
          'submitted_at',
          'created_at'
        ]);

      // A tutor may only submit their own pending registration payment.
      // Admins retain the existing verification authority below.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.payment_type == 'tutor_registration'
        && resource.data.tutor_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      ) || (
        isSignedIn()
        && resource.data.payment_type != 'tutor_registration'
        && resource.data.student_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      );

      // Payment.tsx creates its own pending payment doc from
      // course.base_fee/discount_amount it just read from Firestore —
      // but a client calling the SDK directly isn't bound by what the
      // UI actually read, so `amount` and `course_name` are re-derived
      // here from the *server's* course document, not trusted from the
      // request. A forged amount (or a course_id pointing at an
      // unpublished/nonexistent course) is rejected outright.
      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verified_at == null
        && request.resource.data.verified_by == null
        && request.resource.data.course_id is string
        && paymentMatchesCourse(request.resource.data.course_id, request.resource.data.amount, request.resource.data.course_name);

      // Update: either (a) the owning student submitting their UTR —
      // only utr_reference/status/submitted_at may change, and status
      // may only move to 'submitted' — or (b) an admin verifying
      // (approve/reject), which AdminPayments.tsx does alongside the
      // enrolment write below.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.student_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      );

      allow delete: if false;
    }


    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if isAdmin() || request.query.limit <= 1;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /push_tokens/{tokenId} {
      // FCM registration tokens are private to the signed-in user.
      // The token document ID must match the token field and the owner UID.
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId;

      allow read, delete: if false;
    }

    match /notifications/{notificationId} {
      function isOwnNotification() {
        return isSignedIn() && resource.data.recipient_uid == request.auth.uid;
      }
      function isAdminBroadcast() {
        return resource.data.recipient_uid == null && resource.data.recipient_role == 'admin';
      }
      function isTutorBroadcast() {
        return resource.data.recipient_uid == null && resource.data.recipient_role == 'tutor';
      }

      allow read: if isOwnNotification()
        || (isAdminBroadcast() && isAdmin())
        || (isTutorBroadcast() && isApprovedTutor());

      allow create: if isSignedIn() && request.resource.data.is_read == false
        && request.resource.data.keys().hasAll(['recipient_uid','recipient_role','type','title','message','is_read','created_at'])
        && (
          isAdmin()
          || (request.resource.data.recipient_uid == request.auth.uid
              && request.resource.data.type == 'registration_success')
          || (request.resource.data.recipient_uid == null
              && request.resource.data.recipient_role == 'admin'
              && request.resource.data.type in ['new_student_registration', 'new_enrollment', 'tutor_activity', 'payment_received'])
          || (request.resource.data.recipient_uid == request.auth.uid
              && request.resource.data.recipient_role == 'tutor'
              && request.resource.data.type == 'tutor_payment_status')
        );

      allow update: if (isOwnNotification() || (isAdminBroadcast() && isAdmin()) || (isTutorBroadcast() && isApprovedTutor()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);

      allow delete: if false;
    }

    match /live_rooms/{sessionId} {
      // Room state belongs to an existing published live session.
      // Students may only read rooms for courses they are actively enrolled in.
      allow read: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
        || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
            && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

      // Only Admin or the tutor assigned to this session may create/update room state.
      allow create: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);

      allow update: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);

      allow delete: if isAdmin();

      match /connections/{studentId} {
          // Only the assigned tutor and owning student may read signaling state.
          allow read: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (isSignedIn()
                && studentId == request.auth.uid
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

          // Student creates the initial offer connection.
          allow create: if isAdmin()
            || (isSignedIn()
                && studentId == request.auth.uid
                && request.resource.data.student_id == request.auth.uid
                && request.resource.data.tutor_id == get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id
                && request.resource.data.offer is string
                && request.resource.data.answer == null
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

          // Only the assigned tutor may write the answer.
          // Connection identity and the original offer cannot be changed.
          allow update: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid
                && request.resource.data.student_id == resource.data.student_id
                && request.resource.data.tutor_id == resource.data.tutor_id
                && request.resource.data.offer == resource.data.offer
                && request.resource.data.answer is string);

          allow delete: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (isSignedIn() && studentId == request.auth.uid);

          match /student_ice/{candidateId} {
            allow read: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
              || (isSignedIn() && studentId == request.auth.uid);

            // Student may only append their own ICE candidates.
            allow create: if isAdmin()
              || (isSignedIn()
                  && studentId == request.auth.uid
                  && request.resource.data.from_user_id == request.auth.uid
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                  && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

            allow update: if false;

            allow delete: if isAdmin()
              || (isSignedIn() && studentId == request.auth.uid);
          }

          match /tutor_ice/{candidateId} {
            allow read: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
              || (isSignedIn() && studentId == request.auth.uid);

            // Only the assigned tutor may append tutor ICE candidates.
            allow create: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid
                  && request.resource.data.from_user_id == request.auth.uid);

            allow update: if false;

            allow delete: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);
          }
        }

        match /participants/{userId} {
        // Room participants are visible only to authorized room members.
        allow read: if isAdmin()
          || (isApprovedTutor()
              && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
          || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
              && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

        // A participant may create/update only their own presence document.
        allow create, update: if isSignedIn()
          && userId == request.auth.uid
          && (
            isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id))
          );

        allow delete: if isAdmin()
          || (isSignedIn() && userId == request.auth.uid);
      }
    }

    // ------------------------------------------------------------------
    // Competition system
    // Students must have an active enrolment in the competition course.
    // Answer keys remain server-side only.
    // ------------------------------------------------------------------

    match /competition_questions/{questionId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.is_published == true
            && hasActiveEnrolment(resource.data.course_id));

      allow create, update, delete: if isAdmin();
    }

    match /competition_question_indexes/{courseId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && hasActiveEnrolment(courseId));

      allow create, update, delete: if isAdmin();
    }

    match /competition_answer_keys/{questionId} {
      allow read, write: if isAdmin();
    }

    match /competition_attempts/{attemptId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.course_id != 'DNWt3cPE4ZSJG90CTC1e'
        && hasActiveEnrolment(request.resource.data.course_id);

      // Student attempts are locked after creation.
      // Submission/scoring is performed by the trusted backend.
      allow update, delete: if isAdmin();

      match /answers/{questionId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.student_id == request.auth.uid);

        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.student_id == request.auth.uid
          && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.status == 'in_progress'
          && request.resource.data.question_id == questionId;

        allow delete: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.student_id == request.auth.uid
              && get(/databases/$(database)/documents/competition_attempts/$(attemptId)).data.status == 'in_progress');
      }
    }

    // ------------------------------------------------------------------
    // Competition Mock Test system
    // Separate from official competition attempts/results.
    // Mock tests are practice only and never count as official attempts.
    // ------------------------------------------------------------------

    match /competition_mock_configs/{courseId} {
      allow read: if isAdmin()
        || (isSignedIn() && hasActiveEnrolment(courseId));

      allow create, update, delete: if isAdmin();
    }

    match /competition_mock_attempts/{attemptId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && hasActiveEnrolment(request.resource.data.course_id);

      // Mock submission/scoring is performed by trusted backend.
      allow update, delete: if isAdmin();

      match /answers/{questionId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid);

        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid
          && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.status == 'in_progress'
          && request.resource.data.question_id == questionId;

        allow delete: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.student_id == request.auth.uid
              && get(/databases/$(database)/documents/competition_mock_attempts/$(attemptId)).data.status == 'in_progress');
      }
    }

    match /competition_mock_results/{resultId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    match /competition_results/{resultId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.student_id == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Competition launch-discount counters
    // Students may read the counter for checkout display only.
    // Only admins may create/update/delete counters and eligibility records.
    // The actual 50-slot decision is enforced inside the admin approval
    // transaction by claimCatalogLaunchSlotTx().
    // ------------------------------------------------------------------

    match /catalog_launch_counters/{courseKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_launch_eligibility/{eligibilityId} {
      allow read, write: if isAdmin();
    }

    // BOGO entitlements are created/consumed by the controlled backend.
    // Students cannot manufacture or modify their own free-course entitlement.
    match /bogo_entitlements/{entitlementId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.student_id == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)));

      allow delete: if isAdmin();
    }

    match /session_attendance/{attendanceId} {
      // Doc id convention: `${session_id}_${student_id}` (mirrors
      // enrolments' `${student_id}_${course_id}` pattern).
      allow read: if isAdmin()
        || isOwner(resource.data.student_id)
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(resource.data.session_id)).data.tutor_id == request.auth.uid);

      // A student may create ONLY their own self-reported join record,
      // for a session they're actually enrolled in and that is
      // currently published — never a status other than 'present' and
      // never a source other than 'self_reported' (a tutor/admin
      // override always goes through the branches below instead).
      allow create: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(request.resource.data.session_id)).data.tutor_id == request.auth.uid)
        || (
          isOwner(request.resource.data.student_id)
          && attendanceId == request.resource.data.session_id + '_' + request.auth.uid
          && request.resource.data.source == 'self_reported'
          && request.resource.data.status == 'present'
          && hasActiveEnrolment(request.resource.data.course_id)
          && get(/databases/$(database)/documents/live_sessions/$(request.resource.data.session_id)).data.status == 'published'
        );

      // Updates: a student may only ever touch their own `joined_at` on
      // their own self-reported row (repeated join clicks); everything
      // else (status corrections, marking other students) is a
      // tutor/admin action.
      allow update: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(resource.data.session_id)).data.tutor_id == request.auth.uid)
        || (
          isOwner(resource.data.student_id)
          && resource.data.source == 'self_reported'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined_at'])
        );

      allow delete: if isAdmin();
    }

    // Everything else (payments, certificates, notifications, ...) is
    // intentionally NOT covered here — see the warning at the top of
    // this file. Merge in your existing rules for those collections
    // before deploying.
    match /payments/{paymentId} {
      // A student reads only their own payments (StudentDashboard.tsx);
      // an admin reads all (AdminPayments.tsx).
      allow read: if isAdmin()
        || (isSignedIn() && (
          resource.data.student_id == request.auth.uid
          || resource.data.tutor_id == request.auth.uid
        ));

      // Tutor registration payments are deterministic: one payment document
      // per tutor, always exactly ₹500.
      allow create: if isSignedIn()
        && paymentId == ('tutor_registration_' + request.auth.uid)
        && request.resource.data.payment_type == 'tutor_registration'
        && request.resource.data.tutor_id == request.auth.uid
        && request.resource.data.tutor_name is string
        && request.resource.data.student_id == null
        && request.resource.data.course_id == null
        && request.resource.data.course_name == null
        && request.resource.data.amount == 500
        && request.resource.data.status == 'pending'
        && request.resource.data.verified_at == null
        && request.resource.data.verified_by == null
        && request.resource.data.keys().hasAll([
          'payment_type',
          'tutor_id',
          'tutor_name',
          'student_id',
          'course_id',
          'course_name',
          'amount',
          'status',
          'verified_at',
          'verified_by',
          'utr_reference',
          'submitted_at',
          'created_at'
        ]);

      // A tutor may only submit their own pending registration payment.
      // Admins retain the existing verification authority below.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.payment_type == 'tutor_registration'
        && resource.data.tutor_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      ) || (
        isSignedIn()
        && resource.data.payment_type != 'tutor_registration'
        && resource.data.student_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      );

      // Payment.tsx creates its own pending payment doc from
      // course.base_fee/discount_amount it just read from Firestore —
      // but a client calling the SDK directly isn't bound by what the
      // UI actually read, so `amount` and `course_name` are re-derived
      // here from the *server's* course document, not trusted from the
      // request. A forged amount (or a course_id pointing at an
      // unpublished/nonexistent course) is rejected outright.
      allow create: if isSignedIn()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verified_at == null
        && request.resource.data.verified_by == null
        && request.resource.data.course_id is string
        && paymentMatchesCourse(request.resource.data.course_id, request.resource.data.amount, request.resource.data.course_name);

      // Update: either (a) the owning student submitting their UTR —
      // only utr_reference/status/submitted_at may change, and status
      // may only move to 'submitted' — or (b) an admin verifying
      // (approve/reject), which AdminPayments.tsx does alongside the
      // enrolment write below.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.student_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['utr_reference', 'status', 'submitted_at'])
      );

      allow delete: if false;
    }


    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if isAdmin() || request.query.limit <= 1;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /push_tokens/{tokenId} {
      // FCM registration tokens are private to the signed-in user.
      // The token document ID must match the token field and the owner UID.
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId;

      allow read, delete: if false;
    }

    match /notifications/{notificationId} {
      function isOwnNotification() {
        return isSignedIn() && resource.data.recipient_uid == request.auth.uid;
      }
      function isAdminBroadcast() {
        return resource.data.recipient_uid == null && resource.data.recipient_role == 'admin';
      }
      function isTutorBroadcast() {
        return resource.data.recipient_uid == null && resource.data.recipient_role == 'tutor';
      }

      allow read: if isOwnNotification()
        || (isAdminBroadcast() && isAdmin())
        || (isTutorBroadcast() && isApprovedTutor());

      allow create: if isSignedIn() && request.resource.data.is_read == false
        && request.resource.data.keys().hasAll(['recipient_uid','recipient_role','type','title','message','is_read','created_at'])
        && (
          isAdmin()
          || (request.resource.data.recipient_uid == request.auth.uid
              && request.resource.data.type == 'registration_success')
          || (request.resource.data.recipient_uid == null
              && request.resource.data.recipient_role == 'admin'
              && request.resource.data.type in ['new_student_registration', 'new_enrollment', 'tutor_activity', 'payment_received'])
          || (request.resource.data.recipient_uid == request.auth.uid
              && request.resource.data.recipient_role == 'tutor'
              && request.resource.data.type == 'tutor_payment_status')
        );

      allow update: if (isOwnNotification() || (isAdminBroadcast() && isAdmin()) || (isTutorBroadcast() && isApprovedTutor()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);

      allow delete: if false;
    }

    match /live_rooms/{sessionId} {
      // Room state belongs to an existing published live session.
      // Students may only read rooms for courses they are actively enrolled in.
      allow read: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
        || (get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
            && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

      // Only Admin or the tutor assigned to this session may create/update room state.
      allow create: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);

      allow update: if isAdmin()
        || (isApprovedTutor()
            && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);

      allow delete: if isAdmin();

      match /connections/{studentId} {
          // Only the assigned tutor and owning student may read signaling state.
          allow read: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (isSignedIn()
                && studentId == request.auth.uid
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

          // Student creates the initial offer connection.
          allow create: if isAdmin()
            || (isSignedIn()
                && studentId == request.auth.uid
                && request.resource.data.student_id == request.auth.uid
                && request.resource.data.tutor_id == get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id
                && request.resource.data.offer is string
                && request.resource.data.answer == null
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

          // Only the assigned tutor may write the answer.
          // Connection identity and the original offer cannot be changed.
          allow update: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid
                && request.resource.data.student_id == resource.data.student_id
                && request.resource.data.tutor_id == resource.data.tutor_id
                && request.resource.data.offer == resource.data.offer
                && request.resource.data.answer is string);

          allow delete: if isAdmin()
            || (isApprovedTutor()
                && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
            || (isSignedIn() && studentId == request.auth.uid);

          match /student_ice/{candidateId} {
            allow read: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
              || (isSignedIn() && studentId == request.auth.uid);

            // Student may only append their own ICE candidates.
            allow create: if isAdmin()
              || (isSignedIn()
                  && studentId == request.auth.uid
                  && request.resource.data.from_user_id == request.auth.uid
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.status == 'published'
                  && hasActiveEnrolment(get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.course_id));

            allow update: if false;

            allow delete: if isAdmin()
              || (isSignedIn() && studentId == request.auth.uid);
          }

          match /tutor_ice/{candidateId} {
            allow read: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid)
              || (isSignedIn() && studentId == request.auth.uid);

            // Only the assigned tutor may append tutor ICE candidates.
            allow create: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid
                  && request.resource.data.from_user_id == request.auth.uid);

            allow update: if false;

            allow delete: if isAdmin()
              || (isApprovedTutor()
                  && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.tutor_id == request.auth.uid);
          }
        }

        match /participants/{userId} {
        // Room participants are visible only to authorized room members.
        allow read: if isAdmin()
          || (isApprovedTutor()
