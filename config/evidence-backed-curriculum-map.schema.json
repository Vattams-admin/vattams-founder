{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"VATTAMS Evidence-Backed Curriculum Mapping",
  "type":"object",
  "required":["trackId","evidenceIds","nodes"],
  "properties":{
    "trackId":{"type":"string","minLength":1},
    "evidenceIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "nodes":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["nodeId","nodeType","title","evidenceIds"],
        "properties":{
          "nodeId":{"type":"string","minLength":1},
          "parentId":{"type":["string","null"]},
          "nodeType":{"enum":["subject","chapter","topic","subtopic"]},
          "title":{"type":"string","minLength":1},
          "evidenceIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
        }
      }
    }
  }
}