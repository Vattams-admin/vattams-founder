{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"VATTAMS Curriculum Map Package",
  "type":"object",
  "required":["packageId","version","trackId","evidenceIds","status","subjects"],
  "properties":{
    "packageId":{"type":"string","minLength":1},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "trackId":{"type":"string","const":"school-cbse-class-1"},
    "evidenceIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "status":{"enum":["draft","in_review","approved","published","retired"]},
    "subjects":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["subjectId","title","chapters"],
        "properties":{
          "subjectId":{"type":"string"},
          "title":{"type":"string"},
          "chapters":{"type":"array","items":{"type":"object","required":["chapterId","title"],"properties":{"chapterId":{"type":"string"},"title":{"type":"string"}}}}
        }
      }
    }
  }
}