{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"VATTAMS Hierarchical Curriculum Map Expansion",
  "type":"object",
  "required":["packageId","version","trackId","evidenceIds","status","subjects","governance"],
  "properties":{
    "packageId":{"type":"string","minLength":1},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "trackId":{"type":"string","minLength":1},
    "evidenceIds":{"type":"array","items":{"type":"string","minLength":1}},
    "status":{"enum":["draft","in_review","approved","published","retired"]},
    "subjects":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["subjectId","title","chapters"],
        "properties":{
          "subjectId":{"type":"string","minLength":1},
          "title":{"type":"string","minLength":1},
          "chapters":{
            "type":"array",
            "items":{
              "type":"object",
              "required":["chapterId","title","topics"],
              "properties":{
                "chapterId":{"type":"string","minLength":1},
                "title":{"type":"string","minLength":1},
                "topics":{
                  "type":"array",
                  "items":{
                    "type":"object",
                    "required":["topicId","title","subtopics"],
                    "properties":{
                      "topicId":{"type":"string","minLength":1},
                      "title":{"type":"string","minLength":1},
                      "subtopics":{
                        "type":"array",
                        "items":{
                          "type":"object",
                          "required":["subtopicId","title"],
                          "properties":{
                            "subtopicId":{"type":"string","minLength":1},
                            "title":{"type":"string","minLength":1}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "governance":{
      "type":"object",
      "required":["contentAuthoringAllowed","publicationAllowed"],
      "properties":{
        "contentAuthoringAllowed":{"type":"boolean"},
        "publicationAllowed":{"type":"boolean"},
        "blockedReason":{"type":"string"}
      }
    }
  }
}