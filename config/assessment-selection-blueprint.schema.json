{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VATTAMS Academia Assessment Selection Blueprint",
  "type": "object",
  "required": ["questionCount", "difficultyDistribution", "topicDistribution"],
  "properties": {
    "questionCount": {"type":"integer","minimum":1},
    "difficultyDistribution": {
      "type":"object",
      "required":["easy","medium","hard"],
      "additionalProperties":false,
      "properties":{
        "easy":{"type":"number","minimum":0,"maximum":1},
        "medium":{"type":"number","minimum":0,"maximum":1},
        "hard":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "topicDistribution": {
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["subject","topic","proportion"],
        "additionalProperties":false,
        "properties":{
          "subject":{"type":"string","minLength":1},
          "topic":{"type":"string","minLength":1},
          "proportion":{"type":"number","exclusiveMinimum":0,"maximum":1}
        }
      }
    }
  },
  "additionalProperties":false
}
