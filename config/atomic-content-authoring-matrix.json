      "worked_examples_or_case_studies",
      "topic_practice",
      "sectional_test",
      "pyq_when_authorized",
      "mock_test",
      "revision",
      "weak_topic_revision",
      "official_attempt",
      "results"
    ]
  },
  "competition_package": {
    "reference": "thirukkural-mastery-championship",
    "sequence": [
      "eligibility",
      "study_material",
      "topic_learning",
      "practice",
      "mock_test",
      "revision",
      "age_group_pool",
      "official_attempt",
      "results",
      "certificate"
    ],
    "rule": "Every competition package must meet the same security, randomization, answer-key privacy, age-adaptation and review gates as the Thirukkural reference."
  },
  "governance": {
    "workflow": [
      "draft",
      "automated_validation",
      "quality_review",
      "ceo_approval",
      "published",
      "retired"
    ],
    "published_requires": [
      "review_status=approved",
      "content_hash",
      "approval_identity",
      "approval_timestamp",
      "version",
      "provenance"
    ],
    "official_assessment_requires": [
      "published_package",
      "private_answer_key",
      "four_unique_options",
      "verified_answer",
      "reasoning",
      "blueprint_alignment",
      "language_review"
    ],
    "automatic_ceo_approval": "configured auditable CEO approval may authorize publication only after all mandatory automated and human-quality gates pass; it does not bypass them."
