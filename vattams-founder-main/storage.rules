rules_version = '2';

// STORAGE RULES — Learning Materials module.
//
// Same situation as firestore.rules at the repo root: no storage.rules
// file exists anywhere in this repo today, so this is scoped ONLY to
// the `courses/{courseId}/materials/{materialId}/{filename}` path this
// module adds. Merge the `match` block below into whatever rules
// currently protect this project's Storage bucket in the Firebase
// Console (Storage → Rules) — do not paste this whole file over
// existing rules for other paths, if any exist.
//
// This mirrors firestore.rules' authorization logic (same admins/{uid}
// and enrolments/{uid}_{courseId} documents), because Storage rules
// cannot join against Firestore any other way than reading documents
// directly — there is no shared "authorization library" between the
// two products.
//
// File-type and size enforcement lives here too, not just in the
// client (src/lib/materialValidation.ts) — client-side validation is
// UX, not security; a modified client or a direct API call could skip
// it entirely, so the real ceiling is enforced here.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.is_active == true;
    }

    function isActivelyEnrolled(courseId) {
      let enrolmentId = request.auth.uid + '_' + courseId;
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/enrolments/$(enrolmentId)) &&
        firestore.get(/databases/(default)/documents/enrolments/$(enrolmentId)).data.status == 'active';
    }

    // Firestore doc is the source of truth for "is this material
    // published" — Storage can't cheaply check that itself, so a
    // student's read access is: admin, OR actively enrolled AND the
    // sibling Firestore doc says published. This does mean an enrolled
    // student who somehow guesses/keeps a draft material's exact
    // Storage URL before it's published could still fetch the file
    // directly from Storage (Firestore rules already hide the *doc*,
    // including its URL, from them — this is the belt to that braces).
    // Tightened further by checking the doc's is_published flag here
    // too, not just gating on enrolment.
    match /courses/{courseId}/materials/{materialId}/{filename} {
      function materialDoc() {
        return firestore.get(/databases/(default)/documents/courses/$(courseId)/materials/$(materialId));
      }

      allow read: if isAdmin() ||
        (isActivelyEnrolled(courseId) && materialDoc().data.is_published == true);

      // Uploads: admin only, and constrained to the free-tier limits
      // mirrored from src/lib/materialValidation.ts. Executables and
      // anything outside the three allowed mime families are rejected
      // by the contentType allowlist below rather than a denylist of
      // "bad" extensions (which is trivially bypassed by renaming).
      allow create: if isAdmin() &&
        request.resource.size < 200 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/png|image/jpeg|image/webp|image/gif|video/mp4|video/webm|video/ogg');

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Everything outside courses/{courseId}/materials/** is untouched
    // by this module — deny by default so this file can't accidentally
    // widen access to any other path when merged into a larger rules
    // file. Remove this catch-all if your existing rules already
    // define a project-wide default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
